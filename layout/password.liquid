<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600&family=Cormorant+Garamond:ital,wght@0,300;0,400;1,400&display=swap">
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="template-password">
    <main id="MainContent" class="on-dark" style="min-height:100vh;display:grid;place-items:center;padding:2rem">
      <div class="text-center wrap wrap--tight">
        <p class="eyebrow">{{ shop.name }}</p>
        <h1 class="h-sec mt-4">{{ 'general.password_page.opening_soon' | t }}</h1>
        {{ content_for_layout }}
      </div>
    </main>
  </body>
</html>
