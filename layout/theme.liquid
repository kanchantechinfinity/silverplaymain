<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#241a10">
  {%- include 'seo-overrides' -%}
  <title>{{ page_title }}{% unless page_title contains shop.name %} | {{ shop.name }}{% endunless %}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if product.template_suffix == 'free-gift' %}<meta name="robots" content="noindex, nofollow">{% endif %}
  {% if settings.favicon != blank %}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {% else %}
    <link rel="icon" type="image/png" sizes="256x256" href="{{ 'favicon.png' | asset_url }}">
    <link rel="apple-touch-icon" href="{{ 'apple-touch-icon.png' | asset_url }}">
  {% endif %}
  {{ content_for_header }}

  <script type="text/javascript">
    (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "z44706ghsx");
  </script>

  {% render 'meta-tags' %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Cinzel+Decorative:wght@400;700&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500&family=Tiro+Devanagari+Hindi&display=swap" rel="stylesheet">

  {{ 'theme.css' | asset_url | stylesheet_tag }}

  <script>
    document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    window.SilverPlay = {
      moneyFormat: {{ shop.money_format | json }},
      routes: {
        cart: {{ routes.cart_url | json }},
        cartAdd: {{ routes.cart_add_url | json }},
        cartChange: {{ routes.cart_change_url | json }},
        search: {{ routes.search_url | json }}
      }
    };

    // Failsafe: content is hidden by CSS (opacity:0) until the reveal engine
    // adds .is-in. If theme.js never boots -- 404, parse error, a blocking app
    // script -- the page keeps its scroll height but renders blank. This runs
    // from the layout, independent of theme.js, and only fires when the engine
    // did not come up, so normal scroll-reveal behaviour is untouched.
    window.addEventListener('load', function () {
      setTimeout(function () {
        if (window.__spRevealReady) return;
        var sel = '[data-reveal],[data-stagger],[data-split]';
        Array.prototype.forEach.call(document.querySelectorAll(sel), function (el) {
          el.classList.add('is-in');
        });
      }, 1200);
    });
  </script>
</head>

<body class="template-{{ template.name | handle }} {% if template.suffix %}template-suffix-{{ template.suffix | handle }}{% endif %}">
  <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_text' | t }}</a>

  {% section 'header' %}

  <main id="MainContent" role="main">
    {{ content_for_layout }}
  </main>

  {% if template.name == 'index' %}{% section 'popular-searches' %}{% endif %}
  {% section 'footer' %}
  {% section 'offer-popup' %}

  {% render 'cart-drawer' %}
  {% render 'search-drawer' %}
  {% render 'modals' %}

  <ul hidden>
    <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
  </ul>

  <script src="{{ 'theme.js' | asset_url }}" defer></script>
  <a class="wa-fab" href="https://wa.me/917204242651?text=Hi%20Silver%20Play%2C%20I%20need%20help%20with%20" target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp">
    <svg viewBox="0 0 32 32" width="32" height="32" aria-hidden="true"><path fill="currentColor" d="M16 3C9 3 3.3 8.6 3.3 15.5c0 2.3.7 4.5 1.8 6.3L3 29l7.4-1.9c1.8 1 3.7 1.5 5.6 1.5 7 0 12.7-5.6 12.7-12.6S23 3 16 3zm0 23.1c-1.8 0-3.5-.5-5-1.4l-.4-.2-4.4 1.1 1.2-4.2-.3-.4a10 10 0 0 1-1.6-5.4C5.5 9.9 10.2 5.3 16 5.3s10.5 4.600 10.500 10.200S21.800 26.100 16 26.100zm5.800-7.600c-.3-.2-1.900-.9-2.200-1s-.5-.2-.7.2-.8 1-1 1.200-.4.200-.7.100a8.400 8.400 0 0 1-4.200-3.700c-.3-.6.300-.5.900-1.700.1-.2 0-.4 0-.5l-1-2.300c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.5.100-.8.400s-1 1-1 2.400 1 2.800 1.200 3 2 3.100 4.900 4.300c1.800.8 2.500.8 3.400.7.500-.1 1.700-.7 1.900-1.400.2-.7.200-1.200.2-1.400s-.3-.2-.6-.4z"/></svg>
  </a>
</body>
</html>
