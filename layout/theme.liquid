<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#241a10">
  <title>{{ page_title }}{% unless page_title contains shop.name %} | {{ shop.name }}{% endunless %}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  <link rel="canonical" href="{{ canonical_url }}">
  {% if settings.favicon != blank %}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {% endif %}
  {{ content_for_header }}

  {% render 'meta-tags' %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Cinzel+Decorative:wght@400;700&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Tiro+Devanagari+Hindi&display=swap" rel="stylesheet">

  {{ 'theme.css' | asset_url | stylesheet_tag }}

  <script>
    document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    window.SilverPlay = {
      moneyFormat: {{ shop.money_format | json }},
      routes: {
        cart: {{ routes.cart_url | json }},
        cartAdd: {{ routes.cart_add_url | json }},
        cartChange: {{ routes.cart_change_url | json }},
        search: {{ routes.search_url | json }}
      }
    };

    // Failsafe: content is hidden by CSS (opacity:0) until the reveal engine
    // adds .is-in. If theme.js never boots -- 404, parse error, a blocking app
    // script -- the page keeps its scroll height but renders blank. This runs
    // from the layout, independent of theme.js, and only fires when the engine
    // did not come up, so normal scroll-reveal behaviour is untouched.
    window.addEventListener('load', function () {
      setTimeout(function () {
        if (window.__spRevealReady) return;
        var sel = '[data-reveal],[data-stagger],[data-split]';
        Array.prototype.forEach.call(document.querySelectorAll(sel), function (el) {
          el.classList.add('is-in');
        });
      }, 1200);
    });
  </script>
</head>

<body class="template-{{ template.name | handle }} {% if template.suffix %}template-suffix-{{ template.suffix | handle }}{% endif %}">
  <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_text' | t }}</a>

  {% section 'header' %}

  <main id="MainContent" role="main">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}

  {% render 'cart-drawer' %}
  {% render 'search-drawer' %}
  {% render 'modals' %}

  <ul hidden>
    <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
  </ul>

  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
