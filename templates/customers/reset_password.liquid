<div class="wrap wrap--tight" style="padding-top:9rem;padding-bottom:5rem">
  <h1 class="h-sec">{{ 'customer.reset_password.title' | t }}</h1>
  <p class="lede mt-2">{{ 'customer.reset_password.subtext' | t }}</p>
  {% form 'reset_customer_password' %}
    {{ form.errors | default_errors }}
    <div class="mt-6" style="max-width:24rem;display:grid;gap:1rem">
      <div><label class="field-label" for="ResetPass">{{ 'customer.register.password' | t }}</label><input class="field" id="ResetPass" type="password" name="customer[password]"></div>
      <div><label class="field-label" for="ResetPassConf">Confirm password</label><input class="field" id="ResetPassConf" type="password" name="customer[password_confirmation]"></div>
    </div>
    <button type="submit" class="btn btn--ink mt-5">{{ 'customer.reset_password.submit' | t }}</button>
  {% endform %}
</div>
