<div class="wrap" style="padding-top:9rem;padding-bottom:5rem">
  <p class="eyebrow">{{ 'cart.general.title' | t }}</p>
  <h1 class="h-sec mt-3">{{ 'cart.general.title' | t }} ({{ cart.item_count }})</h1>

  {%- if cart.item_count == 0 -%}
    <div class="cart-empty">
      <p class="h-sec--sm">{{ 'cart.general.empty' | t }}</p>
      <p class="lede mt-2">{{ 'cart.general.empty_body' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--ink mt-8">{{ 'cart.general.continue_shopping' | t }}</a>
    </div>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post" novalidate class="mt-8">
      <table class="cart-table">
        <thead>
          <tr>
            <th scope="col">{{ 'cart.general.product' | t }}</th>
            <th scope="col">{{ 'cart.general.quantity' | t }}</th>
            <th scope="col" style="text-align:right">{{ 'cart.general.total' | t }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for item in cart.items -%}
            <tr>
              <td>
                <div style="display:flex;gap:1rem">
                  <a href="{{ item.url }}" class="cart-line__img">
                    {%- if item.image -%}
                      <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.image.alt | escape }}" width="200" height="250" loading="lazy">
                    {%- endif -%}
                  </a>
                  <div>
                    <a href="{{ item.url }}" class="cart-line__title">{{ item.product.title }}</a>
                    {%- unless item.product.has_only_default_variant -%}
                      <p class="cart-line__variant">{{ item.variant.title }}</p>
                    {%- endunless -%}
                    {%- for prop in item.properties -%}
                      {%- unless prop.last == blank or prop.first[0] == '_' -%}
                        <p class="cart-line__variant">{{ prop.first }}: {{ prop.last }}</p>
                      {%- endunless -%}
                    {%- endfor -%}
                    <p class="cart-line__variant mt-2">{{ item.final_price | money }}</p>
                  </div>
                </div>
              </td>
              <td>
                <span class="qty">
                  <button type="button" data-cart-change="{{ item.quantity | minus: 1 }}" data-line="{{ forloop.index }}" aria-label="Decrease">&minus;</button>
                  <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="{{ 'cart.general.quantity' | t }}">
                  <button type="button" data-cart-change="{{ item.quantity | plus: 1 }}" data-line="{{ forloop.index }}" aria-label="Increase">+</button>
                </span>
                <button type="button" class="link-cta mt-2" data-cart-change="0" data-line="{{ forloop.index }}">{{ 'cart.general.remove' | t }}</button>
              </td>
              <td style="text-align:right;font-family:var(--font-display)">{{ item.final_line_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>

      {%- if section.settings.show_note -%}
        <div class="mt-8" style="max-width:32rem">
          <label class="field-label" for="CartNote">{{ 'cart.general.note' | t }}</label>
          <textarea id="CartNote" name="note" rows="3" class="field">{{ cart.note }}</textarea>
        </div>
      {%- endif -%}

      <div class="mt-8" style="margin-left:auto;max-width:24rem">
        <div class="cart-totals">
          <span>{{ 'cart.general.subtotal' | t }}</span>
          <span>{{ cart.total_price | money }}</span>
        </div>
        <p class="lede mt-2" style="font-size:.85rem">{{ settings.cart_note }}</p>
        <button type="submit" name="update" class="btn btn--outline-gold btn--block mt-4">Update</button>
        <button type="submit" name="checkout" class="btn btn--ink btn--block btn--lg mt-3">{{ 'cart.general.checkout' | t }}</button>
      </div>
    </form>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cart",
  "tag": "section",
  "settings": [{ "type": "checkbox", "id": "show_note", "label": "Show order note", "default": true }]
}
{% endschema %}
