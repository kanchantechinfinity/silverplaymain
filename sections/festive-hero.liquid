{%- comment -%}
  Festive offer hero — a reusable centrepiece for seasonal offer pages
  (Ganpati, Diwali, Rakhi, Christmas, etc.). Everything visible — badge
  pill, offer banner, heading, script line, body copy, both buttons, the
  validity note and the background — is a section setting, so the whole
  page can be re-skinned for the next festival from the theme editor
  without touching code.
{%- endcomment -%}
{%- liquid
  assign collection = collections[section.settings.collection]
  assign side_asset = section.settings.side_image_asset
  if section.settings.side_image != blank
    assign side_asset = blank
  endif
-%}

<section class="fhero on-dark" data-page-hero style="background: {{ section.settings.bg_color }}">
  <div class="wrap wrap--tight fhero__grid">
    <div class="fhero__body fhero__body--{{ section.settings.align }}">
      {%- if section.settings.show_breadcrumb -%}
        <nav aria-label="Breadcrumb" class="breadcrumb" data-reveal>
          <a href="{{ routes.root_url }}">{{ 'general.breadcrumb.home' | t | default: 'Home' }}</a>
          <span>/</span>
          <a href="{{ section.settings.breadcrumb_url | default: routes.all_products_collection_url }}">{{ section.settings.breadcrumb_mid | default: 'Offer' }}</a>
          {%- if section.settings.breadcrumb_current != blank -%}
            <span>/</span><span style="color:var(--sp-bone)">{{ section.settings.breadcrumb_current }}</span>
          {%- endif -%}
        </nav>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="fhero__title" data-split data-reveal="none">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.badge_label != blank or section.settings.show_offer -%}
        <div class="fhero__badges" data-reveal data-delay="0.06">
          {%- if section.settings.badge_label != blank -%}
            <p class="fhero__pill">
              {%- if section.settings.badge_glyph != blank -%}<span aria-hidden="true">{{ section.settings.badge_glyph }}</span>{%- endif -%}
              {{ section.settings.badge_label }}
            </p>
          {%- endif -%}
          {%- if section.settings.show_offer and section.settings.offer_text != blank -%}
            <p class="fhero__offer">
              {%- if section.settings.offer_glyph != blank -%}<span aria-hidden="true">{{ section.settings.offer_glyph }}</span>{%- endif -%}
              {{ section.settings.offer_text }}
            </p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="fhero__sub" data-reveal data-delay="0.1">
          {%- if section.settings.subheading_dash -%}&mdash; {%- endif -%}{{ section.settings.subheading }}
        </p>
      {%- endif -%}

      {%- if section.settings.show_divider -%}
        <svg class="fhero__divider" width="120" height="20" viewBox="0 0 120 20" fill="none" aria-hidden="true" data-reveal data-delay="0.14">
          <path d="M0 10c20 10 40-10 60 0s40 10 60 0" stroke="currentColor" stroke-width="1" stroke-linecap="round"/>
          <circle cx="60" cy="10" r="3" fill="currentColor"/>
        </svg>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <p class="fhero__text" data-reveal data-delay="0.18">{{ section.settings.text }}</p>
      {%- endif -%}

      {%- if section.settings.cta_label != blank or section.settings.cta2_label != blank -%}
        <div class="fhero__ctas" data-reveal data-delay="0.22">
          {%- if section.settings.cta_label != blank -%}
            <a href="{{ section.settings.cta_url | default: collection.url | default: routes.all_products_collection_url }}" class="btn btn--bone btn--lg">
              {{ section.settings.cta_label }} <span class="btn__arrow">&rarr;</span>
            </a>
          {%- endif -%}
          {%- if section.settings.cta2_label != blank -%}
            <a href="{{ section.settings.cta2_url | default: routes.root_url }}" class="btn btn--outline-bone btn--lg">
              {{ section.settings.cta2_label }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.validity_text != blank -%}
        <p class="fhero__validity" data-reveal data-delay="0.28">
          {%- if section.settings.validity_glyph != blank -%}<span aria-hidden="true">{{ section.settings.validity_glyph }}</span>{%- endif -%}
          {{ section.settings.validity_text }}
        </p>
      {%- endif -%}
    </div>

    <div class="fhero__side" data-reveal data-delay="0.1">
      {%- if section.settings.side_image != blank -%}
        <img src="{{ section.settings.side_image | image_url: width: 900 }}" alt="" width="900" height="1125" loading="lazy" decoding="async">
      {%- elsif side_asset != blank -%}
        <img src="{{ side_asset | asset_url }}" alt="" width="900" height="1125" loading="lazy" decoding="async">
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Festive hero",
  "tag": "section",
  "settings": [
    { "type": "select", "id": "align", "label": "Text alignment", "default": "left",
      "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Centre" }, { "value": "right", "label": "Right" } ] },
    { "type": "header", "content": "Breadcrumb" },
    { "type": "checkbox", "id": "show_breadcrumb", "label": "Show breadcrumb", "default": true },
    { "type": "text", "id": "breadcrumb_mid", "label": "Breadcrumb — middle segment", "default": "Offer" },
    { "type": "url", "id": "breadcrumb_url", "label": "Breadcrumb — middle segment link" },
    { "type": "text", "id": "breadcrumb_current", "label": "Breadcrumb — current page", "default": "The Ganpati Collection" },

    { "type": "header", "content": "Badge & offer banner" },
    { "type": "text", "id": "badge_glyph", "label": "Badge glyph", "default": "✦" },
    { "type": "text", "id": "badge_label", "label": "Badge label", "default": "Divine Auspicious Collection" },
    { "type": "checkbox", "id": "show_offer", "label": "Show offer banner", "default": true },
    { "type": "text", "id": "offer_glyph", "label": "Offer glyph/emoji", "default": "🐘" },
    { "type": "text", "id": "offer_text", "label": "Offer text", "default": "Buy ₹15,000+ & Get a Free Silver Ganpati Coin Worth Rs 1850" },

    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ganpati Bappa Morya" },
    { "type": "text", "id": "subheading", "label": "Script line", "default": "Welcome Him Home in Silver" },
    { "type": "checkbox", "id": "subheading_dash", "label": "Prefix script line with a dash", "default": true },
    { "type": "checkbox", "id": "show_divider", "label": "Show ornamental divider", "default": true },
    { "type": "textarea", "id": "text", "label": "Body text", "default": "Handcrafted in pure 925 Hallmarked Sterling Silver. Forged in ancient karigari traditions for Vinayaka Sthapana & auspicious home sanctification." },

    { "type": "header", "content": "Buttons" },
    { "type": "collection", "id": "collection", "label": "Collection (used as the default button link)" },
    { "type": "text", "id": "cta_label", "label": "Primary button label", "default": "Explore The Collection" },
    { "type": "url", "id": "cta_url", "label": "Primary button link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary button label", "default": "Bespoke Hamper" },
    { "type": "url", "id": "cta2_url", "label": "Secondary button link" },

    { "type": "header", "content": "Offer validity" },
    { "type": "text", "id": "validity_glyph", "label": "Validity glyph", "default": "⏳" },
    { "type": "text", "id": "validity_text", "label": "Validity text", "default": "Offer valid till 25th Sept (Ganpati Visarjan)" },

    { "type": "header", "content": "Background & side image" },
    { "type": "color", "id": "bg_color", "label": "Background colour", "default": "#241a10" },
    { "type": "image_picker", "id": "side_image", "label": "Side image (overrides asset below)" },
    { "type": "text", "id": "side_image_asset", "label": "Theme asset filename (used when no photo is picked above)", "default": "meganav-rakhi.jpg" }
  ],
  "presets": [{ "name": "Festive hero" }]
}
{% endschema %}
