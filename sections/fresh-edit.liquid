{%- comment -%}
  "The Fresh Edit" — heading, tab strip, and a 4-up grid of heritage-paper
  product cards per tab. Each tab block points at a real Shopify collection,
  so the merchant controls the product set from the admin, not from code.
{%- endcomment -%}
<section class="heritage-sec sec" style="background: {{ section.settings.bg_color }}" data-tabs>
  {% render 'heritage-bg',
    image: section.settings.bg_image,
    fallback: 'heritage-mandala-corner.jpg',
    wash: section.settings.wash %}

  <div class="wrap">
    <div class="section-head">
      {% render 'heading',
        eyebrow: section.settings.eyebrow,
        heading: section.settings.heading,
        lede: section.settings.lede %}
    </div>

    {%- if section.settings.hamper_label != blank -%}
      <div class="hamper-cta" data-reveal data-delay="0.1">
        <button type="button" class="btn btn--ink" data-hamper-open>
          {{ section.settings.hamper_label }} <span class="btn__arrow" aria-hidden="true">&rarr;</span>
        </button>
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 1 -%}
      <div class="tabs" data-reveal data-delay="0.16">
        <div class="tabs__inner" role="tablist">
          {%- liquid
            assign first_block = section.blocks.first
            assign cta_prefix = section.settings.cta_label
            if cta_prefix contains first_block.settings.label
              assign cta_prefix = cta_prefix | remove: first_block.settings.label | rstrip
            endif
          -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.collection == blank and request.design_mode == false -%}{%- continue -%}{%- endif -%}
            {%- assign tab_col = collections[block.settings.collection] -%}
            {%- assign tab_cta_label = cta_prefix | append: ' ' | append: block.settings.label -%}
            <button type="button" class="tabs__btn" role="tab"
                    data-tab-btn="{{ block.id }}"
                    data-tab-url="{{ tab_col.url }}"
                    data-tab-cta-label="{{ tab_cta_label | escape }}"
                    aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                    {{ block.shopify_attributes }}>
              {{ block.settings.label }}
            </button>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- if block.settings.collection == blank and request.design_mode == false -%}{%- continue -%}{%- endif -%}
      {%- assign col = collections[block.settings.collection] -%}
      <div class="grid-products mt-14" role="tabpanel" data-tab-panel="{{ block.id }}"
           {% unless forloop.first %}hidden{% endunless %}>
        {%- assign shown = 0 -%}
        {%- for product in col.products -%}
          {%- unless product.available -%}{%- continue -%}{%- endunless -%}
          {%- if block.settings.hide_pendants and product.type == 'Pendants' -%}{%- continue -%}{%- endif -%}
          {%- if shown >= section.settings.count -%}{%- break -%}{%- endif -%}
          {%- assign shown = shown | plus: 1 -%}
          {% render 'product-card', product: product, lazy: forloop.first %}
        {%- endfor -%}
        {%- if shown == 0 -%}
          {%- for i in (1..4) -%}
            <div class="card"><div class="card__frame">
              <div class="card__media"><img src="{{ 'fresh-edit-courtyard.jpg' | asset_url }}" alt="" class="card__img" loading="lazy" decoding="async" width="1600" height="1067"></div>
              <div class="card__body"><h3 class="card__title">{{ 'onboarding.product_title' | t }}</h3></div>
            </div></div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    {%- endfor -%}

    {%- if section.settings.cta_label != blank -%}
      {%- liquid
        assign first_block = section.blocks.first
        assign first_col = collections[first_block.settings.collection]
      -%}
      <div class="center-cta" data-reveal data-delay="0.1">
        {%- if section.settings.cta_url != blank -%}
          {%- comment -%} An explicit link overrides the per-tab default -- it stays the same for every tab. {%- endcomment -%}
          <a href="{{ section.settings.cta_url }}" class="btn btn--ink">
            {{ section.settings.cta_label }} <span class="btn__arrow">&rarr;</span>
          </a>
        {%- else -%}
          {%- comment -%} No explicit link: follow whichever tab is active, so "Shop Now" always goes to that tab's own collection instead of one fixed page. {%- endcomment -%}
          <a href="{{ first_col.url | default: routes.all_products_collection_url }}" class="btn btn--ink" data-tab-cta>
            <span data-tab-cta-text>{{ section.settings.cta_label }}</span> <span class="btn__arrow">&rarr;</span>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{%- if section.settings.hamper_label != blank -%}
  {%- assign hamper_product = section.settings.hamper_product -%}
  {%- if hamper_product == blank -%}{%- assign hamper_product = all_products['diwali-hamper'] -%}{%- endif -%}
  <div class="hamper" data-hamper aria-hidden="true" hidden>
    <div class="hamper__scrim" data-hamper-close></div>
    <div class="hamper__panel" role="dialog" aria-modal="true" aria-label="{{ section.settings.hamper_label | escape }}">
      <button type="button" class="hamper__x" data-hamper-close aria-label="Close">&times;</button>
      <p class="eyebrow">Diwali Hamper</p>
      <h3 class="hamper__title">Customise your hamper</h3>
      <p class="hamper__lede">Pick a hamper, then choose one option from each category it includes.</p>
      <form data-hamper-form>
        <div data-hamper-list class="hamper__list"></div>
        <div data-hamper-opts></div>
        <p class="hamper__msg" data-hamper-msg role="status"></p>
        <button type="submit" class="btn btn--ink btn--block btn--lg" data-hamper-submit disabled>Choose a hamper</button>
      </form>
    </div>
  </div>
  <script type="application/json" data-hamper-variants>
    {%- if hamper_product != blank -%}
      [{%- for v in hamper_product.variants -%}{"id":{{ v.id }},"title":{{ v.title | json }},"price":{{ v.price }},"available":{{ v.available }}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]
    {%- else -%}[]{%- endif -%}
  </script>
  <style>
    .hamper-cta { text-align: center; margin-top: 1.5rem; }
    .hamper { position: fixed; inset: 0; z-index: 400; display: grid; place-items: center; padding: 1rem; }
    .hamper[hidden] { display: none; }
    .hamper__scrim { position: absolute; inset: 0; background: rgba(20,14,8,.6); }
    .hamper__panel { position: relative; width: min(38rem, 100%); max-height: 92vh; overflow: auto; padding: 2rem 1.75rem; border-radius: var(--radius-xl, 1.5rem); background: var(--sp-bone, #f2e8d0); border: 1px solid rgba(168,128,48,.5); box-shadow: 0 30px 80px -20px rgba(0,0,0,.6); }
    .hamper__x { position: absolute; top: .6rem; right: .9rem; font-size: 1.8rem; line-height: 1; color: var(--sp-ink); }
    .hamper__title { margin-top: .4rem; font-size: 1.7rem; color: var(--sp-ink); }
    .hamper__lede { margin: .4rem 0 1.25rem; font-family: var(--font-body); color: rgba(36,26,16,.7); }
    .hamper__boxname { margin: 1rem 0 .5rem; font-family: var(--font-display); font-size: .78rem; letter-spacing: .18em; text-transform: uppercase; color: var(--sp-gold-deep); }
    .hamper__h { display: block; width: 100%; text-align: left; margin-bottom: .5rem; padding: .75rem 1rem; border: 1px solid rgba(36,26,16,.2); border-radius: var(--radius-md, 1rem); background: rgba(255,255,255,.4); cursor: pointer; transition: all .2s; }
    .hamper__h b { display: flex; justify-content: space-between; gap: 1rem; font-family: var(--font-display); font-size: .95rem; color: var(--sp-ink); }
    .hamper__h i { display: block; margin-top: .25rem; font-style: normal; font-family: var(--font-body); font-size: .92rem; color: rgba(36,26,16,.65); }
    .hamper__h[aria-pressed="true"] { border-color: var(--sp-ink); background: rgba(217,182,108,.25); box-shadow: 0 0 0 1px var(--sp-ink); }
    .hamper__group { border: 0; margin: 1.1rem 0 0; padding: 0; }
    .hamper__group legend { margin-bottom: .5rem; font-family: var(--font-display); font-size: .82rem; letter-spacing: .14em; text-transform: uppercase; color: var(--sp-gold-deep); }
    .hamper__opts { display: flex; flex-wrap: wrap; gap: .5rem; }
    .hamper__opt input { position: absolute; opacity: 0; pointer-events: none; }
    .hamper__opt span { display: inline-block; padding: .5rem 1rem; border: 1px solid rgba(36,26,16,.25); border-radius: 999px; font-family: var(--font-display); font-size: .78rem; letter-spacing: .06em; color: var(--sp-ink); cursor: pointer; transition: all .2s; }
    .hamper__opt input:checked + span { background: var(--sp-ink); color: var(--sp-bone); border-color: var(--sp-ink); }
    .hamper__opt input:focus-visible + span { outline: 2px solid var(--sp-gold-deep); outline-offset: 2px; }
    .hamper__msg { min-height: 1.2rem; margin: .75rem 0; font-size: .95rem; color: #8a2f2f; }
  </style>
  <script>
    {% raw %}
(function () {
      var root = document.querySelector('[data-hamper]');
      if (!root || root.dataset.ready) return;
      root.dataset.ready = '1';
      var HAMPERS = [{"box": "Medium Box", "name": "Samriddhi Shree Charan Blessings - I", "content": "Charan Paduka on White Lotus Marble (Small charan - 1.30 × 1.10 inches) + Stone Ganesha", "price": 3100, "opts": ["ganesha"]}, {"box": "Medium Box", "name": "Shubh Shagun", "content": "SS Coin (5g) + Raw stone diya", "price": 3499, "opts": ["diya", "coin5"]}, {"box": "Medium Box", "name": "Samriddhi Shree Charan Blessings - II", "content": "Charan Paduka on White Lotus Marble (Big charan - 1.5 × 1.25 inches) + Stone Ganesha", "price": 3700, "opts": ["ganesha"]}, {"box": "Medium Box", "name": "Dhan Laxmi Shagun - I", "content": "Fish (5g) + Diya", "price": 4100, "opts": ["diya"]}, {"box": "Medium Box", "name": "Dhan Laxmi Shagun - II", "content": "Tortoise (5g) + Diya", "price": 4100, "opts": ["diya"]}, {"box": "Medium Box", "name": "Shri Samriddhi", "content": "SS Coin (5g) + Stone Ganpati", "price": 4100, "opts": ["ganesha", "coin5"]}, {"box": "Medium Box", "name": "Dhan Vriddhi", "content": "SS Coin (5g) + Diya + Laxmi Yantra", "price": 4700, "opts": ["diya", "coin5"]}, {"box": "Premium Hamper League (Large Box)", "name": "Laxmi Kripa Hamper", "content": "SS Coin (10g) + Fish (5g) + Laxmi Yantra", "price": 6999, "opts": ["coin10"]}, {"box": "Premium Hamper League (Large Box)", "name": "Raajsi Diwali Hamper", "content": "SS Coin (10g) + Tortoise (5g) + Laxmi Yantra", "price": 6999, "opts": ["coin10"]}, {"box": "Premium Hamper League (Large Box)", "name": "Shubh Samriddhi Hamper", "content": "SS Coin (10g) + Charan Paduka + Tortoise (5g)", "price": 9999, "opts": ["coin10"]}, {"box": "Premium Hamper League (Large Box)", "name": "Dhan Samriddhi Hamper", "content": "SS Coin (10g) + Fish (5g) + Tortoise (5g) + Laxmi Yantra + Diya", "price": 9999, "opts": ["coin10", "diya"]}, {"box": "Premium Hamper League (Large Box)", "name": "The Royal Shagun Hamper", "content": "Laxmi Charan Paduka + Vishnu Charan Paduka + Fish (5g) + Tortoise (5g) + Diya", "price": 19000, "opts": ["diya"]}, {"box": "Premium Hamper League (Large Box)", "name": "Shree Samriddhi Diwali Hamper", "content": "SS Coin (10g) + Laxmi Charan Paduka + Vishnu Charan Paduka + Fish (10g) + Tortoise (10g) + Diya + Laxmi Yantra (2 wooden boxes)", "price": 24999, "opts": ["coin10", "diya"]}];
      var CATS = {"diya": {"label": "Diya", "values": ["Amethyst", "Tiger Eye", "Rose Quartz"]}, "ganesha": {"label": "Stone Ganesha", "values": ["Amethyst", "Rose Quartz", "Tiger's Eye", "Labradorite"]}, "coin5": {"label": "5 gm Silver Coin", "values": ["Ganesh Ji", "Laxmi Ji", "Laxmi-Ganesha", "Kuber Ji"]}, "coin10": {"label": "10 gm Silver Coin", "values": ["Laxmi Ji", "Laxmi-Ganesha", "Kuber Ji"]}};
      var variants = [];
      try { variants = JSON.parse(root.parentNode.querySelector('[data-hamper-variants]').textContent || '[]'); } catch (e) {}
      var form = root.querySelector('[data-hamper-form]');
      var list = root.querySelector('[data-hamper-list]');
      var optsBox = root.querySelector('[data-hamper-opts]');
      var msg = root.querySelector('[data-hamper-msg]');
      var submit = root.querySelector('[data-hamper-submit]');
      var chosen = null;
      function money(n) { return '\u20B9' + Number(n).toLocaleString('en-IN'); }
      function esc(t) { return String(t).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
      var lastBox = '';
      HAMPERS.forEach(function (h, i) {
        if (h.box !== lastBox) { lastBox = h.box; var t = document.createElement('p'); t.className = 'hamper__boxname'; t.textContent = h.box; list.appendChild(t); }
        var b = document.createElement('button'); b.type = 'button'; b.className = 'hamper__h'; b.setAttribute('aria-pressed', 'false'); b.dataset.i = i;
        b.innerHTML = '<b><span>' + esc(h.name) + '</span><span>' + money(h.price) + '</span></b><i>' + esc(h.content) + '</i>';
        list.appendChild(b);
      });
      function renderOpts() {
        optsBox.innerHTML = '';
        if (!chosen) return;
        chosen.opts.forEach(function (key) {
          var c = CATS[key]; var fs = document.createElement('fieldset'); fs.className = 'hamper__group';
          var html = '<legend>' + esc(c.label) + '</legend><div class="hamper__opts">';
          c.values.forEach(function (v) { html += '<label class="hamper__opt"><input type="radio" name="' + esc(c.label) + '" value="' + esc(v) + '" required><span>' + esc(v) + '</span></label>'; });
          fs.innerHTML = html + '</div>'; optsBox.appendChild(fs);
        });
      }
      list.addEventListener('click', function (e) {
        var b = e.target.closest('.hamper__h'); if (!b) return;
        list.querySelectorAll('.hamper__h').forEach(function (x) { x.setAttribute('aria-pressed', 'false'); });
        b.setAttribute('aria-pressed', 'true'); chosen = HAMPERS[Number(b.dataset.i)];
        msg.textContent = ''; renderOpts();
        submit.disabled = false; submit.textContent = variants.length ? 'Add hamper to bag \u00B7 ' + money(chosen.price) : 'Enquire about this hamper';
      });
      function open() { root.hidden = false; root.setAttribute('aria-hidden', 'false'); document.body.style.overflow = 'hidden'; }
      function close() { root.hidden = true; root.setAttribute('aria-hidden', 'true'); document.body.style.overflow = ''; }
      document.addEventListener('click', function (e) {
        if (e.target.closest('[data-hamper-open]')) { e.preventDefault(); open(); }
        else if (e.target.closest('[data-hamper-close]')) { close(); }
      });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !root.hidden) close(); });
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (!chosen) return;
        var props = { '_Includes': chosen.content };
        form.querySelectorAll('input[type=radio]:checked').forEach(function (r) { props[r.name] = r.value; });
        if (!variants.length) { window.location.href = '/pages/contact'; return; }
        var v = variants.filter(function (x) { return x.title.trim().toLowerCase() === chosen.name.trim().toLowerCase(); })[0];
        if (!v) { msg.textContent = 'This hamper is not available to order online yet. Please contact us.'; return; }
        if (!v.available) { msg.textContent = 'This hamper is sold out.'; return; }
        msg.textContent = ''; submit.disabled = true;
        fetch('/cart/add.js', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: [{ id: v.id, quantity: 1, properties: props }] })
        }).then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
          .then(function (res) {
            submit.disabled = false;
            if (!res.ok) { msg.textContent = res.j.description || res.j.message || 'Could not add the hamper.'; return; }
            close();
            var opener = document.querySelector('[data-cart-open]');
            if (opener) opener.click(); else window.location.href = '/cart';
          }).catch(function () { submit.disabled = false; msg.textContent = 'Something went wrong. Please try again.'; });
      });
    })();
  
{% endraw %}</script>
{%- endif -%}

{% schema %}
{
  "name": "The Fresh Edit",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Just Landed" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Fresh Edit" },
    { "type": "textarea", "id": "lede", "label": "Intro", "default": "The newest additions to the Silver Play line — fresh cuts, fresh stones, straight from the workshop." },
    { "type": "range", "id": "count", "min": 4, "max": 12, "step": 4, "label": "Products per tab", "default": 8 },
    { "type": "color", "id": "bg_color", "label": "Background colour", "default": "#dbc596" },
    { "type": "image_picker", "id": "bg_image", "label": "Background photo", "info": "Defaults to the packaged fresh-edit-courtyard.jpg." },
    { "type": "color_background", "id": "wash", "label": "Background wash", "default": "rgba(219,197,150,0.72)" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop New Arrivals" },
    { "type": "url", "id": "cta_url", "label": "Button link" },
    { "type": "header", "content": "Diwali hamper customiser" },
    { "type": "text", "id": "hamper_label", "label": "Button label (leave empty to hide)", "default": "Customise Your Diwali Hamper" },
    { "type": "product", "id": "hamper_product", "label": "Hamper product added to the bag",
      "info": "A product with one variant per hamper, each named exactly like the hamper (see the import file). Chosen options are saved on the cart line. Without it the button becomes an enquiry link." }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Tab label", "default": "New Arrivals" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "checkbox", "id": "hide_pendants", "label": "Hide pendants in this tab", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "The Fresh Edit",
      "blocks": [
        { "type": "tab", "settings": { "label": "New Arrivals" } },
        { "type": "tab", "settings": { "label": "Earrings" } },
        { "type": "tab", "settings": { "label": "Pendants" } }
      ]
    }
  ]
}
{% endschema %}
