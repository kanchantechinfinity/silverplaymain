{%- comment -%}
  Stone Guide — master/detail explorer. Purely informational content (not
  ecommerce data), so each stone is a section block the merchant edits in the
  theme editor. Hover/tap a thumbnail to swap the detail panel (theme.js ->
  initStones). Optionally links each stone to its own collection.
{%- endcomment -%}
{% render 'page-hero',
  eyebrow: section.settings.eyebrow,
  heading: section.settings.heading,
  image: section.settings.banner_image,
  description: section.settings.description %}

<section style="background:var(--sp-bone);padding-block:4rem">
  <div class="wrap">
    <div class="stones" data-stones>
      <div class="stones__grid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign col = collections[block.settings.collection]
            assign img = block.settings.image
            if img == blank
              assign img = col.image
            endif
            if img == blank
              assign img = col.products.first.featured_media.preview_image
            endif
          -%}
          <button type="button" class="stones__thumb{% if forloop.first %} is-active{% endif %}"
                  data-stone-thumb="{{ block.id }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
                  {{ block.shopify_attributes }}>
            {%- if img -%}
              <img src="{{ img | image_url: width: 400 }}" alt="{{ block.settings.name | escape }}" loading="lazy" width="400" height="400">
            {%- else -%}
              <img src="{{ 'stock-product-1.jpg' | asset_url }}" alt="" loading="lazy" width="1600" height="1067">
            {%- endif -%}
            <p>{{ block.settings.name }}</p>
          </button>
        {%- endfor -%}
      </div>

      <div class="stones__detail">
        <div class="gilt gilt--lg">
          <div class="gilt__inner">
            {%- for block in section.blocks -%}
              {%- liquid
                assign col = collections[block.settings.collection]
                assign img = block.settings.image
                if img == blank
                  assign img = col.image
                endif
                if img == blank
                  assign img = col.products.first.featured_media.preview_image
                endif
              -%}
              <div class="stones__panel{% if forloop.first %} is-active{% endif %}" data-stone-panel="{{ block.id }}">
                <div class="stones__panel-img">
                  {%- if img -%}
                    <img src="{{ img | image_url: width: 920 }}" alt="{{ block.settings.name | escape }}" loading="lazy" width="920" height="632">
                  {%- endif -%}
                </div>
                <div class="stones__panel-body">
                  <h3>{{ block.settings.name }}</h3>
                  {%- if block.settings.tagline != blank -%}<p class="stones__tagline">{{ block.settings.tagline }}</p>{%- endif -%}
                  {%- if block.settings.meaning != blank -%}<p class="stones__meaning">{{ block.settings.meaning }}</p>{%- endif -%}

                  {%- if block.settings.properties != blank -%}
                    <ul class="stones__props">
                      {%- assign props = block.settings.properties | newline_to_br | split: '<br />' -%}
                      {%- for p in props -%}
                        {%- assign clean = p | strip -%}
                        {%- if clean != blank -%}<li>{{ clean }}</li>{%- endif -%}
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}

                  <dl class="stones__dl">
                    {%- if block.settings.how_to_wear != blank -%}
                      <div><dt>Wear</dt><dd>{{ block.settings.how_to_wear }}</dd></div>
                    {%- endif -%}
                    {%- if block.settings.care != blank -%}
                      <div><dt>Care</dt><dd>{{ block.settings.care }}</dd></div>
                    {%- endif -%}
                    {%- if block.settings.when_to_wear != blank -%}
                      <div><dt>Best For</dt><dd>{{ block.settings.when_to_wear }}</dd></div>
                    {%- endif -%}
                  </dl>

                  {%- if col != blank -%}
                    <a href="{{ col.url }}" class="btn btn--ink mt-6">Shop {{ block.settings.name }} <span class="btn__arrow">&rarr;</span></a>
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Stone explorer",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Certified & Natural" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Stone Guide" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Every Silver Play pendant is set with a genuine natural stone. Hover or tap any stone on the left to read its full guide here — meaning, care and character, all on this one page." },
    { "type": "image_picker", "id": "banner_image", "label": "Banner image" }
  ],
  "blocks": [
    {
      "type": "stone",
      "name": "Stone",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Rose Quartz" },
        { "type": "text", "id": "tagline", "label": "Tagline" },
        { "type": "textarea", "id": "meaning", "label": "Meaning" },
        { "type": "textarea", "id": "properties", "label": "Properties", "info": "One per line — each becomes a chip." },
        { "type": "textarea", "id": "how_to_wear", "label": "How to wear" },
        { "type": "textarea", "id": "care", "label": "Care" },
        { "type": "text", "id": "when_to_wear", "label": "Best for" },
        { "type": "collection", "id": "collection", "label": "Linked collection", "info": "Supplies the thumbnail when no image is set, and the shop link." },
        { "type": "image_picker", "id": "image", "label": "Image override" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Stone explorer",
      "blocks": [
        { "type": "stone", "settings": { "name": "Rose Quartz", "tagline": "The stone of gentle love and the open heart.", "meaning": "Rose Quartz embodies tenderness, self-acceptance, and emotional healing. Associated with the heart chakra, it promotes friendship and calm energy.", "properties": "Encourages emotional healing and self-love\nPromotes tenderness in relationships\nSupports calm meditation practices", "how_to_wear": "Position closer to the heart using longer chains, or layer with delicate silver pieces.", "care": "Wipe with a soft dry cloth. Protect from perfume, hairspray and extended water exposure.", "when_to_wear": "Weddings, anniversaries, first dates, self-care rituals" } },
        { "type": "stone", "settings": { "name": "Tiger Eye", "tagline": "Golden bands of courage and focus." } },
        { "type": "stone", "settings": { "name": "Amazonite", "tagline": "The soothing turquoise-green of still water." } }
      ]
    }
  ]
}
{% endschema %}
