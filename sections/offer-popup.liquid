{%- comment -%}
  Festive offer pop-up. Shows once per day (configurable) a few seconds after the
  page loads, only while a festive campaign from snippets/campaign-data.liquid is
  live or about to start (or always, if "Show outside campaign dates" is ticked).
  Add a Diwali offers image in the section settings; without an image it shows the
  campaign offers as text on a maroon and gold card.
{%- endcomment -%}
{%- include 'campaign-data' -%}
{%- assign pop_on = section.settings.enabled -%}
{%- if camp == '' and section.settings.always == false -%}{%- assign pop_on = false -%}{%- endif -%}
{%- if request.page_type == 'cart' or request.page_type == 'password' -%}{%- assign pop_on = false -%}{%- endif -%}

{%- if pop_on -%}
  {%- assign img_d = section.settings.image_desktop -%}
  {%- assign img_m = section.settings.image_mobile | default: img_d -%}
  {%- assign img_d = img_d | default: img_m -%}
  {%- assign pop_url = section.settings.button_url | default: '/pages/festive-season-offer' -%}
  <div class="opop" data-opop data-delay="{{ section.settings.delay }}" data-freq="{{ section.settings.frequency }}" data-design="{{ request.design_mode }}" hidden aria-hidden="true">
    <div class="opop__scrim" data-opop-close></div>
    <div class="opop__card{% if img_d != blank %} opop__card--img{% endif %}" role="dialog" aria-modal="true" aria-label="{{ section.settings.heading | escape }}">
      <button type="button" class="opop__x" data-opop-close aria-label="Close offer"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" fill="none"/></svg></button>

      {%- if img_d != blank -%}
        <a href="{{ pop_url }}" class="opop__media">
          <picture>
            <source media="(max-width: 767px)" srcset="{{ img_m | image_url: width: 800 }} 800w, {{ img_m | image_url: width: 1200 }} 1200w" sizes="92vw">
            <img src="{{ img_d | image_url: width: 1000 }}" srcset="{{ img_d | image_url: width: 700 }} 700w, {{ img_d | image_url: width: 1200 }} 1200w" sizes="(min-width: 768px) 430px, 92vw" alt="{{ section.settings.heading | escape }}" loading="lazy" width="{{ img_d.width }}" height="{{ img_d.height }}">
          </picture>
        </a>
      {%- endif -%}
      <div class="opop__body">
        <svg class="opop__diya" viewBox="0 0 48 48" width="46" height="46" aria-hidden="true"><path class="opop__flame" d="M24 2c5 7 7 11 7 16a7 7 0 0 1-14 0c0-5 2-9 7-16z" fill="#f5b942"/><path d="M24 9c2.5 4 3.5 6 3.5 8.5a3.5 3.5 0 0 1-7 0c0-2.5 1-4.5 3.5-8.5z" fill="#fff1bd"/><path d="M3 25h42c0 10-9 17-21 17S3 35 3 25z" fill="#d9b25f"/><path d="M3 25h42" stroke="#7a521a" stroke-width="1.4"/><path d="M14 42h20l-2 4H16z" fill="#8a5c1a"/></svg>
        <p class="opop__eyebrow">{% if camp_name != blank %}{{ camp_name }}{% else %}{{ section.settings.heading }}{% endif %}</p>
        <h2 class="opop__title">{% if camp_title != blank %}{{ camp_title }}{% else %}{{ section.settings.heading }}{% endif %}</h2>
        {%- if camp != '' -%}
          <ul class="opop__tiers">
            {%- if camp_tier1_amt != blank -%}<li class="opop__hero"><b>{{ camp_tier1_gift }}</b><span>{{ camp_tier1_amt }}</span></li>{%- endif -%}
            {%- if camp_tier2_amt != blank -%}<li><b>{{ camp_tier2_gift }}</b><span>{{ camp_tier2_amt }}</span></li>{%- endif -%}
            {%- if camp_tier3_amt != blank -%}<li><b>{{ camp_tier3_gift }}</b><span>{{ camp_tier3_amt }}</span></li>{%- endif -%}
          </ul>
          <p class="opop__dates">{{ camp_dates }} &middot; Applied automatically at checkout</p>
        {%- else -%}
          <p class="opop__text">{{ section.settings.text }}</p>
        {%- endif -%}
        <a href="{{ pop_url }}" class="opop__cta">{{ section.settings.button_label }} <span aria-hidden="true">&rarr;</span></a>
        <button type="button" class="opop__later" data-opop-close>Maybe later</button>
      </div>
    </div>
  </div>

  <style>
    .opop { position: fixed; inset: 0; z-index: 600; display: grid; place-items: center; padding: 1rem; }
    .opop[hidden] { display: none; }
    .opop__scrim { position: absolute; inset: 0; background: rgba(20,12,8,.68); animation: opop-fade .4s ease both; }
    .opop__card { position: relative; width: min(34rem, 100%); display: grid; max-height: 92vh; overflow: auto; border-radius: 1.6rem; background: var(--sp-bone, #f2e8d0); border: 1.5px solid #c9a35c; box-shadow: 0 0 0 5px rgba(58,20,16,.9), 0 0 0 6px rgba(201,163,92,.8), 0 40px 90px -20px rgba(0,0,0,.7); animation: opop-in .55s var(--ease-silk, cubic-bezier(.22,1,.36,1)) both; }
    .opop__x { position: absolute; top: .8rem; right: .8rem; z-index: 3; width: 2.9rem; height: 2.9rem; border-radius: 50%; background: #f6ecd2; color: #2a0f0b; display: grid; place-items: center; border: 1.5px solid #c9a35c; box-shadow: 0 6px 18px rgba(0,0,0,.35); cursor: pointer; transition: transform .2s, background .2s; }
    .opop__x:hover { transform: scale(1.08); background: #fff8e4; }
    .opop__x:focus-visible { outline: 3px solid #d9b25f; outline-offset: 3px; }
    .opop__media { display: block; line-height: 0; order: -1; }
    .opop__media img { display: block; width: 100%; height: 100%; max-height: 42vh; object-fit: cover; }
    @media (min-width: 768px) {
      .opop__card--img { width: min(58rem, 100%); grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); }
      .opop__card--img .opop__body { order: 1; display: flex; flex-direction: column; justify-content: center; }
      .opop__card--img .opop__media { order: 2; }
      .opop__media img { max-height: none; min-height: 100%; }
    }
    .opop__later { font-family: var(--font-display); font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; color: var(--sp-gold-deep, #8a6a2e); }
    .opop__body { text-align: left; padding: 2.4rem 2.2rem 1.9rem; background: linear-gradient(180deg, #3a1410 0%, #2a0f0b 100%); color: #f1dba0; }
    .opop__diya { display: block; margin: 0 0 .9rem; filter: drop-shadow(0 0 8px rgba(245,185,66,.7)); }
    .opop__flame { transform-box: fill-box; transform-origin: 50% 100%; animation: opop-flick 1.8s ease-in-out infinite; }
    .opop__eyebrow { font-family: var(--font-display); font-size: .7rem; letter-spacing: .3em; text-transform: uppercase; color: #d9b25f; }
    .opop__title { margin: .4rem 0 1.4rem; font-size: clamp(2rem, 5vw, 2.8rem); line-height: 1.05; color: #f6e8bd; }
    .opop__tiers { list-style: none; margin: 0 0 1.1rem; padding: 0; }
    .opop__tiers li { padding: .85rem 0; border-top: 1px solid rgba(217,178,95,.28); }
    .opop__tiers li b { display: block; font-family: var(--font-display); font-size: 1.05rem; line-height: 1.25; color: #f6e8bd; font-weight: 600; letter-spacing: .02em; }
    .opop__tiers li span { display: block; margin-top: .2rem; font-family: var(--font-body); font-size: 1rem; color: #cdbb8c; }
    .opop__tiers li.opop__hero { padding: 0 0 1rem; border-top: 0; }
    .opop__tiers li.opop__hero b { font-size: clamp(1.7rem, 4.2vw, 2.3rem); line-height: 1.05; color: #e9c46b; text-transform: uppercase; }
    .opop__tiers li.opop__hero span { margin-top: .35rem; font-size: 1.1rem; color: #f1dba0; }
    .opop__dates { margin: 0 0 1.4rem; padding-top: .9rem; border-top: 1px solid rgba(217,178,95,.28); font-family: var(--font-body); font-size: .92rem; color: #b9a777; }
    .opop__text { margin: 0 0 1.2rem; font-family: var(--font-body); color: #d9c79a; }
    .opop__cta { display: flex; align-items: center; justify-content: center; gap: .6rem; width: 100%; padding: 1rem 1.4rem; border-radius: 999px; background: #d9b25f; color: #2a0f0b; font-family: var(--font-display); font-size: .82rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; text-decoration: none; transition: background .2s, transform .2s; }
    .opop__cta:hover { background: #e8c46f; transform: translateY(-1px); }
    .opop__body .opop__later { display: block; margin: .9rem auto 0; padding: .4rem .8rem; color: #b9a777; }
    @media (max-width: 767px) {
      .opop { padding: .9rem; }
      .opop__card { max-height: calc(100vh - 1.8rem); max-height: calc(100dvh - 1.8rem); overflow: visible; display: block; border-radius: 1.3rem; background: transparent; }
      .opop__media { position: absolute; top: 2.7rem; right: 1.1rem; z-index: 2; width: 5.4rem; height: 5.4rem; border-radius: 1rem; overflow: hidden; border: 1.5px solid #c9a35c; box-shadow: 0 6px 16px rgba(0,0,0,.4); }
      .opop__media img { width: 100%; height: 100%; max-height: none; min-height: 0; object-fit: cover; }
      .opop__body { border-radius: 1.3rem; padding: 1.2rem 1.2rem 1rem; display: block; }
      .opop__diya { display: none; }
      .opop__eyebrow, .opop__title { padding-right: 6.4rem; }
      .opop__eyebrow { font-size: .62rem; letter-spacing: .22em; margin-top: .1rem; }
      .opop__title { margin: .3rem 0 1.1rem; font-size: 1.75rem; }
      .opop__tiers { margin-bottom: .9rem; }
      .opop__tiers li { padding: .6rem 0; }
      .opop__tiers li b { font-size: .95rem; }
      .opop__tiers li span { font-size: .88rem; margin-top: .05rem; }
      .opop__tiers li.opop__hero { padding-bottom: .75rem; }
      .opop__tiers li.opop__hero b { font-size: 1.7rem; }
      .opop__tiers li.opop__hero span { font-size: .98rem; margin-top: .2rem; }
      .opop__dates { display: none; }
      .opop__cta { padding: .9rem 1rem; font-size: .76rem; }
      .opop__body .opop__later { margin-top: .4rem; padding: .35rem .6rem; font-size: .68rem; }
      .opop__x { top: .5rem; right: .5rem; width: 1.9rem; height: 1.9rem; box-shadow: none; }
      .opop__x svg { width: 14px; height: 14px; }
    }
    @media (max-width: 767px) and (max-height: 640px) {
      .opop__tiers li:nth-child(3) { display: none; }
      .opop__title { font-size: 1.5rem; margin-bottom: .7rem; }
    }
    @media (min-width: 768px) and (max-height: 780px) {
      .opop__card { max-height: calc(100vh - 1.2rem); max-height: calc(100dvh - 1.2rem); }
      .opop__body { padding: 1.4rem 2rem 1.2rem; }
      .opop__diya { display: none; }
      .opop__title { margin-bottom: .9rem; font-size: 2.2rem; }
      .opop__tiers li { padding: .6rem 0; }
      .opop__tiers li.opop__hero { padding-bottom: .7rem; }
      .opop__dates { margin-bottom: 1rem; }
    }
    @keyframes opop-fade { from { opacity: 0; } to { opacity: 1; } }
    @keyframes opop-in { from { opacity: 0; transform: translateY(26px) scale(.96); } to { opacity: 1; transform: none; } }
    @keyframes opop-flick { 0%, 100% { transform: scale(1); opacity: 1; } 30% { transform: scale(.93, 1.08) rotate(-2deg); } 60% { transform: scale(1.05, .95) rotate(2deg); opacity: .92; } }
    @media (prefers-reduced-motion: reduce) { .opop__scrim, .opop__card, .opop__flame { animation: none; } }
  </style>

  <script>
    {% raw %}
    (function () {
      var root = document.querySelector('[data-opop]');
      if (!root || root.dataset.ready) return;
      root.dataset.ready = '1';
      var KEY = 'sp_offer_popup_v1', freq = root.getAttribute('data-freq') || 'day';
      var design = root.getAttribute('data-design') === 'true';
      var delay = Math.max(0, Number(root.getAttribute('data-delay')) || 0) * 1000;
      function seen() {
        if (design || freq === 'always') return false;
        try {
          var v = freq === 'session' ? sessionStorage.getItem(KEY) : localStorage.getItem(KEY);
          if (!v) return false;
          return freq === 'session' ? true : (Date.now() - Number(v) < 86400000);
        } catch (e) { return false; }
      }
      function mark() {
        try {
          if (freq === 'session') sessionStorage.setItem(KEY, '1'); else localStorage.setItem(KEY, String(Date.now()));
        } catch (e) {}
      }
      function open() {
        root.hidden = false; root.setAttribute('aria-hidden', 'false'); document.body.style.overflow = 'hidden';
        var x = root.querySelector('.opop__x'); if (x) x.focus({ preventScroll: true });
        mark();
      }
      function close() { root.hidden = true; root.setAttribute('aria-hidden', 'true'); document.body.style.overflow = ''; }
      root.addEventListener('click', function (e) { if (e.target.closest('[data-opop-close]')) close(); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !root.hidden) close(); });
      if (seen()) return;
      setTimeout(function () { if (!document.querySelector('[data-hamper]:not([hidden])')) open(); }, delay);
    })();
    {% endraw %}
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Offer pop-up",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show the pop-up", "default": true },
    { "type": "checkbox", "id": "always", "label": "Show outside festive campaign dates too", "default": false,
      "info": "By default it only appears while a festive campaign is live (or starts within 5 days)." },
    { "type": "image_picker", "id": "image_desktop", "label": "Offers image — desktop", "info": "Your Diwali offers artwork. Without an image the pop-up shows the campaign offers as text." },
    { "type": "image_picker", "id": "image_mobile", "label": "Offers image — mobile", "info": "Falls back to the desktop image." },
    { "type": "text", "id": "heading", "label": "Heading (used for accessibility / no-image text)", "default": "Diwali Offers" },
    { "type": "textarea", "id": "text", "label": "Text (shown outside campaign dates, no-image version)", "default": "Festive silver, gifting hampers and offers, made for Diwali." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the offer" },
    { "type": "url", "id": "button_url", "label": "Button link", "info": "Defaults to the Festive Season Offer page." },
    { "type": "range", "id": "delay", "min": 0, "max": 15, "step": 1, "unit": "s", "label": "Delay before showing", "default": 3 },
    { "type": "select", "id": "frequency", "label": "How often", "default": "day",
      "options": [
        { "value": "day", "label": "Once a day" },
        { "value": "session", "label": "Once per visit (session)" },
        { "value": "always", "label": "Every page load" }
      ] }
  ]
}
{% endschema %}
