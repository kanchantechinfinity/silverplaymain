{%- comment -%}
  "Complete The Look" — reads the product's custom.paired_with product
  reference metafield; falls back to a section-level product picker.
{%- endcomment -%}
{%- liquid
  assign pair = product.metafields.custom.paired_with.value
  if pair == blank
    assign pair = all_products[section.settings.fallback_product]
  endif
-%}
{%- if pair != blank and pair.handle != product.handle -%}
<section class="heritage-sec" style="border-top:1px solid var(--sp-line);background:var(--sp-bone);padding-block:4rem">
  {% render 'heritage-bg', image: section.settings.bg_image, fallback: 'elegance-lotus.jpg', wash: 'rgba(242,232,208,0.75)' %}

  <div class="wrap wrap--narrow">
    <div class="text-center">
      <p class="eyebrow" style="color:var(--sp-gold-deep)" data-reveal>{{ section.settings.eyebrow }}</p>
      <h2 class="mt-3" style="font-size:clamp(1.5rem,3vw,2.1rem)">{{ section.settings.heading }} {{ product.title }}</h2>
    </div>

    <div data-reveal data-delay="0.1">
      <a href="{{ pair.url }}" class="paired">
        {% render 'icon', name: 'paisley', class: 'paired__paisley' %}
        <span class="paired__img">
          <div>
            {%- if pair.featured_media -%}
              <img src="{{ pair.featured_media | image_url: width: 500 }}" alt="{{ pair.title | escape }}" loading="lazy" width="500" height="500">
            {%- endif -%}
          </div>
        </span>
        <span class="paired__body">
          <span class="eyebrow" style="color:var(--sp-gold-deep)">{{ pair.metafields.custom.chip.value | default: pair.type }}</span>
          <h3 class="mt-2" style="font-size:1.2rem">{{ pair.title }}</h3>
          <span class="buybox__price" style="margin-top:.5rem;font-size:1.05rem;justify-content:center">
            <span>{{ pair.price | money }}</span>
            {%- if pair.compare_at_price > pair.price -%}<span class="buybox__was">{{ pair.compare_at_price | money }}</span>{%- endif -%}
          </span>
          <span class="btn btn--outline-gold mt-5">View The Pair <span class="btn__arrow">&rarr;</span></span>
        </span>
      </a>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Paired with",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "Reads the product metafield custom.paired_with (product reference). The fallback below is used when a product has none." },
    { "type": "product", "id": "fallback_product", "label": "Fallback product" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Complete The Look" },
    { "type": "text", "id": "heading", "label": "Heading prefix", "default": "Paired Well With" },
    { "type": "image_picker", "id": "bg_image", "label": "Background photo" }
  ]
}
{% endschema %}
