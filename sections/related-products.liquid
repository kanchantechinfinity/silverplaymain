{%- comment -%}
  Related products. Uses Shopify's product recommendations when the section is
  requested through the recommendations route; otherwise falls back to other
  products of the same type.
{%- endcomment -%}
{%- assign limit = section.settings.count -%}
<section style="border-top:1px solid var(--sp-line);background:var(--sp-bone-2);padding-block:5rem">
  <div class="wrap">
    <p class="eyebrow" data-reveal>{{ section.settings.heading }}</p>
    <div class="grid-products grid-products--5 mt-8" data-stagger="0.08">
      {%- if recommendations.performed and recommendations.products_count > 0 -%}
        {%- for p in recommendations.products -%}
          {% render 'product-card', product: p %}
        {%- endfor -%}
      {%- else -%}
        {%- assign type_handle = product.type | handleize -%}
        {%- assign pool = collections[type_handle].products -%}
        {%- if pool == blank or pool.size == 0 -%}
          {%- assign pool = collections.all.products -%}
        {%- endif -%}
        {%- assign shown = 0 -%}
        {%- for p in pool -%}
          {%- if p.handle != product.handle and shown < limit -%}
            {% render 'product-card', product: p %}
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Related products",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Similar Products" },
    { "type": "range", "id": "count", "min": 2, "max": 10, "step": 1, "label": "Products shown", "default": 5 }
  ]
}
{% endschema %}
