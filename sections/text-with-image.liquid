{%- comment -%}
  Alternating text/image row — the rhythm the About page uses for Craft,
  Values and Closing. Paragraphs are blocks so the merchant can add as many
  as the section needs.
{%- endcomment -%}
<section class="sec--sm {% if section.settings.color_scheme == 'dark' %}on-dark{% endif %}"
         style="background: {{ section.settings.bg_color }}">
  <div class="wrap">
    <div class="split-row {% if section.settings.image_position == 'left' %}split-row--reverse{% endif %}">
      <div class="split-row__text">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow" data-reveal>{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="mt-4" style="font-size:clamp(1.9rem,4vw,3rem)" data-split data-reveal="none">{{ section.settings.heading }}</h2>
        {%- if section.settings.flourish -%}
          <p class="mt-6" aria-hidden="true" style="font-family:var(--font-flourish);font-size:1.2rem;color:var(--sp-gold-deep)">&#10087;</p>
        {%- endif -%}
        {%- for block in section.blocks -%}
          {%- assign d = forloop.index0 | times: 0.1 | plus: 0.15 -%}
          <div data-reveal data-delay="{{ d }}" {{ block.shopify_attributes }}>
            <p class="lede mt-5" style="max-width:36rem">{{ block.settings.text }}</p>
          </div>
        {%- endfor -%}
        {%- if section.settings.cta_label != blank -%}
          <div data-reveal data-delay="0.3">
            <a href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}"
               class="btn {% if section.settings.color_scheme == 'dark' %}btn--bone{% else %}btn--ink{% endif %} mt-8" style="width:fit-content">
              {{ section.settings.cta_label }} <span class="btn__arrow">&rarr;</span>
            </a>
          </div>
        {%- endif -%}
      </div>

      <div data-reveal="{% if section.settings.image_position == 'left' %}left{% else %}right{% endif %}" style="height:100%">
        <div class="split-row__media">
          {%- if section.settings.image != blank -%}
            <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.heading | escape }}" loading="lazy" width="1200" height="1500">
          {%- else -%}
            <img src="{{ 'stock-lifestyle-1.jpg' | asset_url }}" alt="" loading="lazy" width="1600" height="2000">
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Text with image",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "image_position", "label": "Image position", "default": "right",
      "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Karigars of India" },
    { "type": "checkbox", "id": "flourish", "label": "Show flourish mark", "default": false },
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "light",
      "options": [{ "value": "light", "label": "Light" }, { "value": "dark", "label": "Dark" }] },
    { "type": "color", "id": "bg_color", "label": "Background colour", "default": "#f2e8d0" },
    { "type": "text", "id": "cta_label", "label": "Button label" },
    { "type": "url", "id": "cta_url", "label": "Button link" }
  ],
  "blocks": [
    { "type": "paragraph", "name": "Paragraph", "settings": [{ "type": "textarea", "id": "text", "label": "Text" }] }
  ],
  "presets": [{ "name": "Text with image", "blocks": [{ "type": "paragraph" }] }]
}
{% endschema %}
