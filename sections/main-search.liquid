<div class="wrap" style="padding-top:9rem;padding-bottom:5rem">
  <div class="search-page__head">
    <p class="eyebrow">{{ 'general.search.search' | t }}</p>
    <h1 class="h-sec mt-3" data-split data-reveal="none">{{ section.settings.heading }}</h1>
  </div>

  <form action="{{ routes.search_url }}" method="get" role="search" class="mt-8 search-page__form" style="display:flex;gap:.75rem;max-width:38rem">
    <input type="search" name="q" value="{{ search.terms | escape }}" class="field field--pill"
           placeholder="{{ 'general.search.placeholder' | t }}" aria-label="{{ 'general.search.search' | t }}">
    <input type="hidden" name="options[prefix]" value="last">
    <button type="submit" class="btn btn--ink">{{ 'general.search.search' | t }}</button>
  </form>

  <a href="{{ routes.all_products_collection_url }}" class="link-cta mt-4">
    {{ 'general.search.view_all_products' | t }} <span>&rarr;</span>
  </a>

  {%- if search.performed -%}
    <p class="shop__count mt-8">{{ 'general.search.results_with_count' | t: count: search.results_count }}</p>

    {%- if search.results_count == 0 -%}
      <div class="shop__empty" data-search-empty="{{ search.terms | escape }}">
        <p style="font-family:var(--font-display);font-size:1.1rem">{{ 'general.search.no_results' | t: terms: search.terms }}</p>
      </div>
    {%- else -%}
      {%- paginate search.results by 32 -%}
        {%- comment -%}
          Products only — Shopify's search can also match articles/pages,
          which don't belong in this grid of product cards.
        {%- endcomment -%}
        <div class="grid-products grid-products--3 mt-4">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item %}
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="pagination" aria-label="{{ 'general.pagination.label' | t }}">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">&larr;</a>{%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
              {%- else -%}<span {% if part.title == paginate.current_page %}aria-current="page"{% endif %}>{{ part.title }}</span>{%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}">&rarr;</a>{%- endif -%}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Search",
  "tag": "section",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Search Silver Play" }]
}
{% endschema %}
