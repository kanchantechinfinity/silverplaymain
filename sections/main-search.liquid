<div class="wrap" style="padding-top:9rem;padding-bottom:5rem">
  <div class="search-page__head">
    <p class="eyebrow">{{ 'general.search.search' | t }}</p>
    <h1 class="h-sec mt-3" data-split data-reveal="none">{{ section.settings.heading }}</h1>
  </div>

  <form action="{{ routes.search_url }}" method="get" role="search" class="mt-8 search-page__form" style="display:flex;gap:.75rem;max-width:38rem">
    <input type="search" name="q" value="{{ search.terms | escape }}" class="field field--pill"
           placeholder="{{ 'general.search.placeholder' | t }}" aria-label="{{ 'general.search.search' | t }}">
    <input type="hidden" name="options[prefix]" value="last">
    <button type="submit" class="btn btn--ink">{{ 'general.search.search' | t }}</button>
  </form>

  {%- if search.performed -%}
    <p class="shop__count mt-8">{{ 'general.search.results_with_count' | t: count: search.results_count }}</p>

    {%- comment -%}
      Shopify's core search object never includes collections, no matter
      the query -- searching "sterling silver" or "925 silver" (which
      describe the whole catalog, not any one product) found nothing,
      even though those are real collections. This checks every
      collection's own title against the query terms and surfaces the
      matches above the product grid.
    {%- endcomment -%}
    {%- assign coll_terms = search.terms | strip | downcase | split: ' ' -%}
    {%- assign coll_count = 0 -%}
    {%- capture coll_html -%}
      {%- for col in collections -%}
        {%- assign coll_title_dc = col.title | downcase -%}
        {%- assign coll_match = false -%}
        {%- for t in coll_terms -%}
          {%- if t.size >= 3 and coll_title_dc contains t -%}{%- assign coll_match = true -%}{%- endif -%}
        {%- endfor -%}
        {%- if coll_match and col.products_count > 0 -%}
          {%- assign coll_count = coll_count | plus: 1 -%}
          <a href="{{ col.url }}" class="jcard">
            <div class="jcard__media">
              {%- if col.image -%}<img src="{{ col.image | image_url: width: 700 }}" alt="" loading="lazy" decoding="async" width="700" height="525">{%- endif -%}
            </div>
            <h3 class="jcard__title">{{ col.title }}</h3>
          </a>
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- if coll_count > 0 -%}
      <p class="eyebrow mt-8">Collections</p>
      <div class="grid-products grid-products--3 mt-4">{{ coll_html }}</div>
    {%- endif -%}

    {%- if search.results_count == 0 and coll_count == 0 -%}
      <div class="shop__empty" data-search-empty="{{ search.terms | escape }}">
        <p style="font-family:var(--font-display);font-size:1.1rem">{{ 'general.search.no_results' | t: terms: search.terms }}</p>
      </div>
    {%- elsif search.results_count > 0 -%}
      {%- paginate search.results by 24 -%}
        {%- comment -%}
          Shopify's own backend search sometimes pads out weak queries with
          products that don't actually contain any of the searched words
          (e.g. random earrings/pendants showing up for "coin", which the
          store doesn't sell as a browsable product at all) -- this
          re-checks each product's own title against the query terms and
          drops the ones that don't share a single word with it. If that
          leaves nothing, a genuine "no results" is the honest answer, not
          padding the page with unrelated products.
        {%- endcomment -%}
        {%- assign terms = search.terms | strip | split: ' ' -%}
        {%- assign shown_count = 0 -%}
        {%- capture filtered_html -%}
          {%- for item in search.results -%}
            {%- assign relevant = true -%}
            {%- if item.object_type == 'product' -%}
              {%- assign relevant = false -%}
              {%- assign title_dc = item.title | downcase -%}
              {%- for t in terms -%}
                {%- assign tdc = t | downcase -%}
                {%- if tdc.size >= 3 and title_dc contains tdc -%}
                  {%- assign relevant = true -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
            {%- if relevant -%}
              {%- assign shown_count = shown_count | plus: 1 -%}
              {%- if item.object_type == 'product' -%}
                {% render 'product-card', product: item %}
              {%- elsif item.object_type == 'article' -%}
                <a href="{{ item.url }}" class="jcard">
                  <div class="jcard__media">
                    {%- if item.image -%}<img src="{{ item.image | image_url: width: 700 }}" alt="" loading="lazy" decoding="async" width="700" height="525">{%- endif -%}
                  </div>
                  <h3 class="jcard__title">{{ item.title }}</h3>
                </a>
              {%- else -%}
                <a href="{{ item.url }}" class="jcard"><h3 class="jcard__title">{{ item.title }}</h3></a>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if shown_count > 0 -%}
          <div class="grid-products grid-products--3 mt-4">
            {{ filtered_html }}
          </div>

          {%- if paginate.pages > 1 -%}
            <nav class="pagination" aria-label="{{ 'general.pagination.label' | t }}">
              {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">&larr;</a>{%- endif -%}
              {%- for part in paginate.parts -%}
                {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
                {%- else -%}<span {% if part.title == paginate.current_page %}aria-current="page"{% endif %}>{{ part.title }}</span>{%- endif -%}
              {%- endfor -%}
              {%- if paginate.next -%}<a href="{{ paginate.next.url }}">&rarr;</a>{%- endif -%}
            </nav>
          {%- endif -%}
        {%- else -%}
          <div class="shop__empty" data-search-empty="{{ search.terms | escape }}">
            <p style="font-family:var(--font-display);font-size:1.1rem">{{ 'general.search.no_results' | t: terms: search.terms }}</p>
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Search",
  "tag": "section",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Search Silver Play" }]
}
{% endschema %}
