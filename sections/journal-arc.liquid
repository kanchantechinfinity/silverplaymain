{%- comment -%}
  "Stories, Worn as Silver" — a plain static grid of real blog articles,
  cards sized to match .deck__card (Her Royal Simplicity). No scroll-jacking:
  the page scrolls normally past this section like any other.
{%- endcomment -%}
{%- liquid
  assign blog = blogs[section.settings.blog]
  if blog == blank or blog.articles.size == 0
    for b in blogs
      if b.articles.size > 0
        assign blog = b
        break
      endif
    endfor
  endif
  assign article_limit = section.settings.article_count
  assign real_count = blog.articles.size | at_most: article_limit
  if real_count < 1
    assign real_count = 1
  endif
  assign featured = section.settings.featured_article
-%}

<section class="arc">
  <div class="arc__stage">
    {% render 'heritage-bg',
      image: section.settings.bg_image,
      fallback: 'heritage-mandala-corner.jpg',
      wash: 'rgba(242,232,208,0.8)' %}

    <div class="arc__head">
      <p class="eyebrow" data-reveal>{{ section.settings.eyebrow }}</p>
      <h2 class="mt-2" style="font-size:clamp(1.5rem,3.2vw,2.3rem)" data-split data-reveal="none">{{ section.settings.heading }}</h2>
    </div>

    <div class="arc__grid">
      {%- if blog != blank and blog.articles.size > 0 -%}
        {%- assign shown = 0 -%}
        {%- if featured != blank -%}
          <div class="arc__card">
            <a href="{{ featured.url }}">
              <div class="arc__inner">
                {%- if featured.image -%}
                  <img src="{{ featured.image | image_url: width: 900 }}" alt="{{ featured.title | escape }}" loading="lazy" decoding="async" width="900" height="1100">
                {%- else -%}
                  <img src="{{ 'story-veena.jpg' | asset_url }}" alt="" loading="lazy" decoding="async" width="736" height="916">
                {%- endif -%}
                <span class="arc__scrim" aria-hidden="true"></span>
                <div class="arc__foot">
                  <h3>{{ featured.title }}</h3>
                  <span class="arc__go" aria-hidden="true">&rarr;</span>
                </div>
              </div>
            </a>
          </div>
          {%- assign shown = 1 -%}
        {%- endif -%}
        {%- for post in blog.articles -%}
          {%- if shown >= real_count -%}{%- break -%}{%- endif -%}
          {%- if featured != blank and post.id == featured.id -%}{%- continue -%}{%- endif -%}
          <div class="arc__card">
            <a href="{{ post.url }}">
              <div class="arc__inner">
                {%- if post.image -%}
                  <img src="{{ post.image | image_url: width: 900 }}" alt="{{ post.title | escape }}" loading="lazy" decoding="async" width="900" height="1100">
                {%- else -%}
                  <img src="{{ 'story-veena.jpg' | asset_url }}" alt="" loading="lazy" decoding="async" width="736" height="916">
                {%- endif -%}
                <span class="arc__scrim" aria-hidden="true"></span>
                <div class="arc__foot">
                  <h3>{{ post.title }}</h3>
                  <span class="arc__go" aria-hidden="true">&rarr;</span>
                </div>
              </div>
            </a>
          </div>
          {%- assign shown = shown | plus: 1 -%}
        {%- endfor -%}
      {%- else -%}
        <div class="arc__card">
          <a href="{{ routes.root_url }}">
            <div class="arc__inner">
              <img src="{{ 'story-veena.jpg' | asset_url }}" alt="" loading="lazy" decoding="async" width="736" height="916">
              <span class="arc__scrim" aria-hidden="true"></span>
              <div class="arc__foot">
                <h3>{{ 'onboarding.blog_title' | t }}</h3>
              </div>
            </div>
          </a>
        </div>
      {%- endif -%}
    </div>

    <div class="arc__controls">
      <a href="{{ blog.url | default: routes.root_url }}" class="link-cta">
        {{ section.settings.cta_label }} <span>&rarr;</span>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Journal arc",
  "tag": "section",
  "settings": [
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "article", "id": "featured_article", "label": "Article shown in front",
      "info": "Leave blank to use whichever article the blog sorts first (usually the most recently published)." },
    { "type": "range", "id": "article_count", "min": 1, "max": 6, "step": 1, "label": "Articles shown", "default": 6 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "From The Journal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stories, Worn as Silver" },
    { "type": "text", "id": "cta_label", "label": "Link label", "default": "Read The Journal" },
    { "type": "image_picker", "id": "bg_image", "label": "Background photo" }
  ],
  "presets": [{ "name": "Journal arc" }]
}
{% endschema %}
