{%- comment -%}
  "Stories, Worn as Silver" — the exact same one-line, natively-swipeable
  card rail as "Her Royal Simplicity" (.deck__viewport/.deck__rail/.deck__card,
  driven by theme.js -> initDeck, which matches on these classes generically).
  Real blog articles instead of products; no page-scroll hijacking.
{%- endcomment -%}
{%- liquid
  assign blog = blogs[section.settings.blog]
  if blog == blank or blog.articles.size == 0
    for b in blogs
      if b.articles.size > 0
        assign blog = b
        break
      endif
    endfor
  endif
  assign article_limit = section.settings.article_count
  assign real_count = blog.articles.size | at_most: article_limit
  if real_count < 1
    assign real_count = 1
  endif
  assign featured = section.settings.featured_article
-%}

<section class="deck deck--journal" data-deck aria-roledescription="carousel" aria-label="{{ section.settings.heading | escape }}">
  <div class="deck__stage" style="background: var(--sp-bone)">
    {% render 'heritage-bg',
      image: section.settings.bg_image,
      fallback: 'heritage-mandala-corner.jpg',
      wash: 'rgba(242,232,208,0.8)' %}

    <div class="deck__head">
      <p class="eyebrow" data-reveal>{{ section.settings.eyebrow }}</p>
      <h2 class="mt-2" style="font-size:clamp(1.5rem,3.2vw,2.3rem)" data-split data-reveal="none">{{ section.settings.heading }}</h2>
    </div>

    <div class="deck__viewport">
      <div class="deck__rail" data-set-size="{{ real_count }}">
        {%- for rep in (1..3) -%}
          {%- assign is_buffer = true -%}
          {%- if rep == 2 -%}{%- assign is_buffer = false -%}{%- endif -%}
          {%- assign shown = 0 -%}
          {%- assign slot = 0 -%}
          {%- if blog != blank and blog.articles.size > 0 -%}
            {%- if featured != blank -%}
              <div class="deck__card{% if rep == 2 and slot == 0 %} is-active{% endif %}" data-deck-card{% if is_buffer %} aria-hidden="true"{% endif %}>
                {%- if featured.image -%}
                  <img src="{{ featured.image | image_url: width: 900 }}" alt="{{ featured.title | escape }}" loading="{% if rep == 2 %}eager{% else %}lazy{% endif %}" decoding="async" width="900" height="1100">
                {%- else -%}
                  <img src="{{ 'story-veena.jpg' | asset_url }}" alt="" loading="lazy" decoding="async" width="900" height="1100">
                {%- endif -%}
                <span class="deck__wash" aria-hidden="true"></span>
                <div class="deck__label"><p>{{ featured.title }}</p></div>
                <a href="{{ featured.url }}" class="visually-hidden"{% if is_buffer %} tabindex="-1"{% endif %}>{{ featured.title }}</a>
              </div>
              {%- assign shown = 1 -%}
              {%- assign slot = slot | plus: 1 -%}
            {%- endif -%}
            {%- for post in blog.articles -%}
              {%- if shown >= real_count -%}{%- break -%}{%- endif -%}
              {%- if featured != blank and post.id == featured.id -%}{%- continue -%}{%- endif -%}
              <div class="deck__card{% if rep == 2 and slot == 0 %} is-active{% endif %}" data-deck-card{% if is_buffer %} aria-hidden="true"{% endif %}>
                {%- if post.image -%}
                  <img src="{{ post.image | image_url: width: 900 }}" alt="{{ post.title | escape }}" loading="{% if rep == 2 and slot <= 1 %}eager{% else %}lazy{% endif %}" decoding="async" width="900" height="1100">
                {%- else -%}
                  <img src="{{ 'story-veena.jpg' | asset_url }}" alt="" loading="lazy" decoding="async" width="900" height="1100">
                {%- endif -%}
                <span class="deck__wash" aria-hidden="true"></span>
                <div class="deck__label"><p>{{ post.title }}</p></div>
                <a href="{{ post.url }}" class="visually-hidden"{% if is_buffer %} tabindex="-1"{% endif %}>{{ post.title }}</a>
              </div>
              {%- assign shown = shown | plus: 1 -%}
              {%- assign slot = slot | plus: 1 -%}
            {%- endfor -%}
          {%- else -%}
            <div class="deck__card{% if rep == 2 %} is-active{% endif %}" data-deck-card{% if is_buffer %} aria-hidden="true"{% endif %}>
              <img src="{{ 'story-veena.jpg' | asset_url }}" alt="" loading="lazy" decoding="async" width="900" height="1100">
              <span class="deck__wash" aria-hidden="true"></span>
              <div class="deck__label"><p>{{ 'onboarding.blog_title' | t }}</p></div>
              <a href="{{ routes.root_url }}" class="visually-hidden"{% if is_buffer %} tabindex="-1"{% endif %}>{{ 'onboarding.blog_title' | t }}</a>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <span class="deck__fade" aria-hidden="true"></span>

    <div class="deck__controls">
      <button type="button" class="round-btn" data-deck-prev aria-label="{{ 'accessibility.previous' | t }}">&larr;</button>
      <button type="button" class="round-btn round-btn--solid" data-deck-next aria-label="{{ 'accessibility.next' | t }}">&rarr;</button>
      <a href="{{ blog.url | default: routes.root_url }}" class="link-cta" style="margin-left:1rem">
        {{ section.settings.cta_label }} <span>&rarr;</span>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Journal arc",
  "tag": "section",
  "settings": [
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "article", "id": "featured_article", "label": "Article shown in front",
      "info": "Leave blank to use whichever article the blog sorts first (usually the most recently published)." },
    { "type": "range", "id": "article_count", "min": 1, "max": 6, "step": 1, "label": "Articles shown", "default": 6 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "From The Journal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stories, Worn as Silver" },
    { "type": "text", "id": "cta_label", "label": "Link label", "default": "Read The Journal" },
    { "type": "image_picker", "id": "bg_image", "label": "Background photo" }
  ],
  "presets": [{ "name": "Journal arc" }]
}
{% endschema %}
