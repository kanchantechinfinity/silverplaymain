{%- comment -%}
  Track Your Order: customer enters the docket (AWB) number and is sent to
  Sequel Logistics' own tracking page (https://sequel247.com/track/<docket>).
{%- endcomment -%}
{% render 'page-hero',
  eyebrow: section.settings.eyebrow,
  heading: section.settings.heading,
  image: section.settings.banner_image,
  description: section.settings.description %}

<div class="wrap wrap--narrow" style="max-width:40rem;padding-block:4rem">
  <div class="gilt gilt--lg" data-reveal>
    <div class="gilt__inner" style="padding:2rem">
      <form data-track-form novalidate>
        <label class="field-label" for="TrackDocket">{{ section.settings.label }}</label>
        <input class="field" id="TrackDocket" type="text" inputmode="text" autocomplete="off" required placeholder="{{ section.settings.placeholder }}" data-track-input>
        <p class="lede mt-2" style="font-size:.85rem;color:#8a3b2e" data-track-error hidden>Please enter your docket number.</p>
        <button type="submit" class="btn btn--ink btn--block btn--lg mt-4">{{ section.settings.button }} <span class="btn__arrow">&rarr;</span></button>
      </form>
      {%- if section.settings.help != blank -%}
        <p class="lede mt-4" style="font-size:.85rem">{{ section.settings.help }}</p>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  (function () {
    var form = document.querySelector('[data-track-form]');
    if (!form) return;
    var input = form.querySelector('[data-track-input]');
    var err = form.querySelector('[data-track-error]');
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var v = (input.value || '').replace(/[^A-Za-z0-9-]/g, '');
      if (!v) { err.hidden = false; return; }
      err.hidden = true;
      window.open('https://sequel247.com/track/' + encodeURIComponent(v), '_blank', 'noopener');
    });
  })();
</script>

{% schema %}
{
  "name": "Track order",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Order Tracking" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Track Your Order" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Enter the docket number from your shipping confirmation to see where your order is." },
    { "type": "image_picker", "id": "banner_image", "label": "Banner image" },
    { "type": "text", "id": "label", "label": "Field label", "default": "Docket number" },
    { "type": "text", "id": "placeholder", "label": "Field placeholder", "default": "Enter your docket number" },
    { "type": "text", "id": "button", "label": "Button text", "default": "Track Order" },
    { "type": "textarea", "id": "help", "label": "Help text", "default": "You will find the docket number in the shipping email or message we sent you. Need help? Contact us and we will track it for you." }
  ],
  "presets": [{ "name": "Track order" }]
}
{% endschema %}
