{%- comment -%}
  Homepage festive offer band — two-column: photo left (stretched to
  match the content column's height), copy right. CTA-focused, no
  validity/fine-print line below the button.
{%- endcomment -%}
{%- include 'campaign-data' -%}
{%- liquid
  if camp != ''
    if camp_coin_qty > 0
      assign gift_card_product = all_products[camp_coin_handle]
    endif
    assign camp_col = collections[camp_collection]
    assign cta_link = camp_col.url
  endif
-%}
{%- if camp != '' -%}
<section class="heritage-sec sec on-dark" style="background: {{ section.settings.bg_color | default: '#241a10' }}">
  {% render 'heritage-bg',
    image: section.settings.bg_image,
    fallback: 'heritage-mandala-corner.jpg',
    wash: section.settings.wash %}

  <div class="wrap offer-split">
    <div class="offer-split__media" data-reveal>
      {%- if section.settings.side_video_url != blank -%}
        <div class="offer-split__image offer-split__image--reel">
          <video src="{{ section.settings.side_video_url }}" autoplay muted loop playsinline
                 style="object-position: {{ section.settings.side_image_focus | default: '50% 50%' }}"></video>
        </div>
      {%- endif -%}
      {%- if gift_card_product != blank -%}
        <div class="offer-split__image offer-split__image--card">
          {% render 'product-card', product: gift_card_product, style: 'gilt', lazy: 'lazy' %}
        </div>
      {%- elsif section.settings.side_image != blank -%}
        <div class="offer-split__image">
          <img src="{{ section.settings.side_image | image_url: width: 1200 }}" alt="" loading="lazy" decoding="async" width="1200" height="1500" style="object-position: {{ section.settings.side_image_2_focus | default: '50% 0%' }}">
        </div>
      {%- endif -%}
    </div>

    <div class="offer-split__content">
      <p class="eyebrow" data-reveal>{{ camp_name }}{% if camp_status == 'soon' %} &middot; Starts {{ camp_start_s | date: '%b %-d' }}{% else %} &middot; Live now{% endif %}</p>
      <h2 class="h-sec mt-4" data-split data-reveal="none">{{ camp_title }}</h2>
      <p class="lede mt-4" data-reveal data-delay="0.1">{{ camp_lede }}</p>

      <div class="offer-tiers offer-tiers--left mt-8" data-reveal data-delay="0.16">
        {%- for n in (1..3) -%}
          {%- liquid
            case n
              when 1
                assign t_amt = camp_tier1_amt
                assign t_gift = camp_tier1_gift
              when 2
                assign t_amt = camp_tier2_amt
                assign t_gift = camp_tier2_gift
              when 3
                assign t_amt = camp_tier3_amt
                assign t_gift = camp_tier3_gift
            endcase
          -%}
          {%- if t_amt != blank -%}
            <div class="offer-tiers__item">
              <span class="offer-tiers__amt">{{ t_amt }}</span>
              <span class="offer-tiers__arrow" aria-hidden="true">&rarr;</span>
              <span class="offer-tiers__gift">{{ t_gift }}</span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <p class="mt-6" style="font-size:.92rem;color:rgba(242,232,208,.55)">{{ camp_dates }} &middot; {{ camp_end_label }}</p>

      <div class="mt-8" data-reveal data-delay="0.22">
        <a href="{{ cta_link | default: routes.all_products_collection_url }}" class="btn btn--bone btn--lg">
          {{ camp_cta_label }} <span class="btn__arrow">&rarr;</span>
        </a>
        <a href="/pages/festive-season-offer" class="link-cta link-cta--bone" style="margin-left:1rem">Offer details <span>&rarr;</span></a>
      </div>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Home offer band",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "side_video_url", "label": "Left-side video URL", "info": "A Shopify Files video URL (Content > Files). Autoplays muted, looped. Shown beside the photo below, not instead of it." },
    { "type": "text", "id": "side_image_focus", "label": "Video focal point (CSS object-position)", "default": "50% 50%" },
    { "type": "image_picker", "id": "side_image", "label": "Left-side photo" },
    { "type": "text", "id": "side_image_2_focus", "label": "Photo focal point (CSS object-position)", "default": "50% 0%" },
    { "type": "product", "id": "gift_product", "label": "Gift product card (replaces the photo above when set)",
      "info": "Shows a real product card — image, title, price — for the free gift item instead of a plain photo." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Festive Season Offer" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A Little Silver, On Us" },
    { "type": "textarea", "id": "lede", "label": "Intro", "default": "This festive season, every order over ₹15,000 comes home with a little extra silver." },
    { "type": "textarea", "id": "note", "label": "Fine print", "default": "Every coin is 99.9% pure silver, added automatically to your cart — no code needed." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop The Collection" },
    { "type": "url", "id": "cta_url", "label": "Button link" },
    { "type": "color", "id": "bg_color", "label": "Background colour", "default": "#241a10" },
    { "type": "image_picker", "id": "bg_image", "label": "Background photo" },
    { "type": "color_background", "id": "wash", "label": "Background wash", "default": "rgba(36,26,16,0.82)" }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Tier",
      "settings": [
        { "type": "text", "id": "amount", "label": "Amount", "default": "₹15,000" },
        { "type": "text", "id": "gift", "label": "Gift", "default": "1 Free Silver Coin" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home offer band",
      "blocks": [
        { "type": "tier", "settings": { "amount": "₹15,000", "gift": "1 Free Silver Coin" } },
        { "type": "tier", "settings": { "amount": "₹30,000", "gift": "2 Free Silver Coins" } }
      ]
    }
  ]
}
{% endschema %}
