{%- comment -%}
  Homepage festive offer band — two-column: photo left (stretched to
  match the content column's height), copy right. CTA-focused, no
  validity/fine-print line below the button.
{%- endcomment -%}
<section class="heritage-sec sec on-dark" style="background: {{ section.settings.bg_color | default: '#241a10' }}">
  {% render 'heritage-bg',
    image: section.settings.bg_image,
    fallback: 'heritage-mandala-corner.jpg',
    wash: section.settings.wash %}

  <div class="wrap offer-split">
    <div class="offer-split__image" data-reveal>
      {%- if section.settings.side_image != blank -%}
        <img src="{{ section.settings.side_image | image_url: width: 1200 }}" alt="" loading="lazy" decoding="async" width="1200" height="1500" style="object-position: {{ section.settings.side_image_focus | default: '50% 50%' }}">
      {%- endif -%}
    </div>

    <div class="offer-split__content">
      <p class="eyebrow" data-reveal>{{ section.settings.eyebrow }}</p>
      <h2 class="h-sec mt-4" data-split data-reveal="none">{{ section.settings.heading }}</h2>
      {%- if section.settings.lede != blank -%}
        <p class="lede mt-4" data-reveal data-delay="0.1">{{ section.settings.lede }}</p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="offer-tiers offer-tiers--left mt-8" data-reveal data-delay="0.16">
          {%- for block in section.blocks -%}
            <div class="offer-tiers__item" {{ block.shopify_attributes }}>
              <span class="offer-tiers__amt">{{ block.settings.amount }}</span>
              <span class="offer-tiers__arrow" aria-hidden="true">&rarr;</span>
              <span class="offer-tiers__gift">{{ block.settings.gift }}</span>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.note != blank -%}
        <p class="mt-6" style="font-size:.92rem;color:rgba(242,232,208,.55)">{{ section.settings.note }}</p>
      {%- endif -%}

      {%- if section.settings.cta_label != blank -%}
        <div class="mt-8" data-reveal data-delay="0.22">
          <a href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}" class="btn btn--bone btn--lg">
            {{ section.settings.cta_label }} <span class="btn__arrow">&rarr;</span>
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home offer band",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "side_image", "label": "Left-side photo" },
    { "type": "text", "id": "side_image_focus", "label": "Photo focal point (CSS object-position)", "default": "50% 50%" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Festive Season Offer" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A Little Silver, On Us" },
    { "type": "textarea", "id": "lede", "label": "Intro", "default": "This festive season, every order over ₹15,000 comes home with a little extra silver." },
    { "type": "textarea", "id": "note", "label": "Fine print", "default": "Every coin is 99.9% pure silver, added automatically to your cart — no code needed." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop The Collection" },
    { "type": "url", "id": "cta_url", "label": "Button link" },
    { "type": "color", "id": "bg_color", "label": "Background colour", "default": "#241a10" },
    { "type": "image_picker", "id": "bg_image", "label": "Background photo" },
    { "type": "color_background", "id": "wash", "label": "Background wash", "default": "rgba(36,26,16,0.82)" }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Tier",
      "settings": [
        { "type": "text", "id": "amount", "label": "Amount", "default": "₹15,000" },
        { "type": "text", "id": "gift", "label": "Gift", "default": "1 Free Silver Coin" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home offer band",
      "blocks": [
        { "type": "tier", "settings": { "amount": "₹15,000", "gift": "1 Free Silver Coin" } },
        { "type": "tier", "settings": { "amount": "₹30,000", "gift": "2 Free Silver Coins" } }
      ]
    }
  ]
}
{% endschema %}
