{%- comment -%}
  Diwali hamper page: a grid of every hamper, each opening its own product-style
  view (?h=N) where the diya / coin / Ganesha options are chosen and the hamper is
  added to the bag as a variant of the hamper product (variant title = hamper name).
{%- endcomment -%}
{%- assign hamper_product = section.settings.hamper_product -%}
{%- if hamper_product == blank -%}{%- assign hamper_product = all_products['diwali-hamper'] -%}{%- endif -%}

<section class="heritage-sec sec hb" style="background: {{ section.settings.bg_color }}">
  {% render 'heritage-bg',
    image: section.settings.bg_image,
    fallback: 'heritage-mandala-corner.jpg',
    wash: section.settings.wash %}
  <div class="wrap">
    <div data-hb-root></div>
  </div>
</section>

<script type="application/json" data-hb-variants>
  {%- if hamper_product != blank -%}
    [{%- for v in hamper_product.variants -%}
      {%- assign vimg = v.featured_media.preview_image | default: hamper_product.featured_media.preview_image -%}
      {"id":{{ v.id }},"title":{{ v.title | json }},"price":{{ v.price }},"available":{{ v.available }},"img":{% if vimg != blank %}{{ vimg | image_url: width: 900 | json }}{% else %}""{% endif %}}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}]
  {%- else -%}[]{%- endif -%}
</script>
<script type="application/json" data-hb-imgs>
  {
    {%- assign hk = 'fish,tortoise,yantra,laxmi_paduka,vishnu_paduka' | split: ',' -%}
    {%- for k in hk -%}
      {%- assign sid = 'img_' | append: k -%}
      {%- assign im = section.settings[sid] -%}
      "{{ k }}": {% if im != blank %}{{ im | image_url: width: 300 | json }}{% else %}""{% endif %}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  }
</script>

<script type="application/json" data-hb-optimgs>
  {
    "diya": {"Amethyst": {{ 'hamper-diya-amethyst.jpg' | asset_url | json }}, "Tiger Eye": {{ 'hamper-diya-tiger-eye.jpg' | asset_url | json }}, "Rose Quartz": {{ 'hamper-diya-rose-quartz.jpg' | asset_url | json }}},
    "ganesha": {"Amethyst": {{ 'hamper-ganesha-amethyst.jpg' | asset_url | json }}, "Rose Quartz": {{ 'hamper-ganesha-rose-quartz.jpg' | asset_url | json }}, "Tiger's Eye": {{ 'hamper-ganesha-tigers-eye.jpg' | asset_url | json }}, "Labradorite": {{ 'hamper-ganesha-labradorite.jpg' | asset_url | json }}},
    "coin": {"Ganesh Ji": {{ 'hamper-coin-ganesh.jpg' | asset_url | json }}, "Laxmi Ji": {{ 'hamper-coin-laxmi.jpg' | asset_url | json }}, "Kuber Ji": {{ 'hamper-coin-kuber.jpg' | asset_url | json }}}
  }
</script>

<style>
  .hb__item--txt span.ph { display: flex; align-items: center; justify-content: center; padding: .4rem; font-family: var(--font-display); font-size: .78rem; letter-spacing: .06em; text-align: center; color: var(--sp-ink); background: rgba(217,182,108,.18); }
  .hb__item--txt em { display: none; }
  .hb__opt span img { width: 1.6rem; height: 1.6rem; border-radius: 50%; object-fit: cover; vertical-align: middle; margin: -.2rem .5rem -.2rem -.45rem; }
  .hb__bar { text-align: center; margin-bottom: 2rem; }
  .hb { padding-top: clamp(6.5rem, 12vw, 8.5rem); }
  .hb__h1 { font-size: clamp(1.3rem, 6.2vw, 2.6rem); white-space: nowrap; }
  .hb__tab .short { display: none; }
  .hb__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .8rem; }
  @media (min-width: 520px) { .hb__grid { gap: 1.25rem; } }
  @media (max-width: 639px) {
    .hb__tabs { flex-wrap: nowrap; gap: .4rem; }
    .hb__tab { flex: 1 1 0; text-align: center; padding: .6rem .5rem; font-size: .7rem; letter-spacing: .08em; white-space: nowrap; }
    .hb__tab .full { display: none; }
    .hb__tab .short { display: inline; }
    .hb__body { padding: .7rem .75rem .9rem; }
    .hb__name { font-size: .88rem; }
    .hb__content { display: none; }
    .hb__price { font-size: .95rem; }
    .hb__cta { font-size: .65rem; letter-spacing: .1em; }
    .hb__row { gap: .25rem; }
  }
  @media (min-width: 860px) { .hb__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 1150px) { .hb__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .hb__tabs { display: flex; flex-wrap: wrap; justify-content: center; gap: .5rem; margin: 0 auto 1.75rem; }
  .hb__tab { padding: .65rem 1.4rem; border: 1px solid rgba(36,26,16,.25); border-radius: 999px; font-family: var(--font-display); font-size: .78rem; letter-spacing: .12em; text-transform: uppercase; color: var(--sp-ink); text-decoration: none; transition: all .2s; }
  .hb__tab.is-on { background: var(--sp-ink); color: var(--sp-bone); border-color: var(--sp-ink); }
  .hb__boxname { grid-column: 1 / -1; margin: 1rem 0 0; font-family: var(--font-display); font-size: .8rem; letter-spacing: .2em; text-transform: uppercase; color: var(--sp-gold-deep); }
  .hb__card { display: flex; flex-direction: column; border: 1.5px solid var(--sp-gold-mid, #c9a35c); border-radius: var(--radius-lg, 1.25rem); background: var(--sp-bone, #f2e8d0); overflow: hidden; text-decoration: none; color: var(--sp-ink); transition: transform .3s, box-shadow .3s; }
  .hb__card:hover { transform: translateY(-3px); box-shadow: 0 16px 34px -18px rgba(36,26,16,.5); }
  .hb__ph { aspect-ratio: 4/3; background: var(--sp-bone-2, #e8d8b3); }
  .hb__ph img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hb__body { padding: 1rem 1.1rem 1.25rem; display: flex; flex-direction: column; gap: .3rem; flex: 1; }
  .hb__name { font-family: var(--font-display); font-size: 1.05rem; line-height: 1.25; }
  .hb__content { font-family: var(--font-body); font-size: .95rem; color: rgba(36,26,16,.7); }
  .hb__row { display: flex; align-items: baseline; justify-content: space-between; gap: .75rem; flex-wrap: wrap; margin-top: auto; }
  .hb__price { font-family: var(--font-display); font-size: 1.05rem; font-weight: 700; }
  .hb__cta { font-family: var(--font-display); font-size: .75rem; letter-spacing: .16em; text-transform: uppercase; color: var(--sp-gold-deep); }
  .hb__back { display: inline-block; margin-bottom: 1.25rem; font-family: var(--font-display); font-size: .78rem; letter-spacing: .16em; text-transform: uppercase; color: var(--sp-gold-deep); text-decoration: none; }
  .hb__detail { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.75rem; }
  @media (min-width: 900px) { .hb__detail { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 3rem; align-items: start; } }
  .hb__hero { border: 1.5px solid var(--sp-gold-mid, #c9a35c); border-radius: var(--radius-xl, 1.5rem); overflow: hidden; background: var(--sp-bone-2, #e8d8b3); aspect-ratio: 1/1; }
  .hb__hero img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hb__title { margin: .3rem 0 .4rem; font-size: clamp(1.7rem, 3vw, 2.4rem); }
  .hb__dprice { font-family: var(--font-display); font-size: 1.5rem; font-weight: 700; margin-bottom: .5rem; }
  .hb__h4 { margin: .6rem 0 .6rem; font-family: var(--font-display); font-size: .82rem; letter-spacing: .14em; text-transform: uppercase; color: var(--sp-gold-deep); }
  .hb__dprice small { margin-left: .6rem; font-family: var(--font-body); font-size: 1rem; font-weight: 400; color: rgba(36,26,16,.65); }
  .hb__items { display: grid; grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr)); gap: .8rem; }
  .hb__item { text-align: center; }
  .hb__item span.ph { display: block; aspect-ratio: 1/1; border-radius: var(--radius-sm, .75rem); overflow: hidden; background: rgba(36,26,16,.06); border: 1px solid rgba(36,26,16,.12); }
  .hb__item img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hb__item em { display: block; margin-top: .3rem; font-style: normal; font-family: var(--font-body); font-size: .85rem; line-height: 1.25; }
  .hb__group { border: 0; margin: 1.2rem 0 0; padding: 0; }
  .hb__group legend { margin-bottom: .5rem; font-family: var(--font-display); font-size: .82rem; letter-spacing: .14em; text-transform: uppercase; color: var(--sp-gold-deep); }
  .hb__opts { display: flex; flex-wrap: wrap; gap: .5rem; }
  .hb__opt input { position: absolute; opacity: 0; pointer-events: none; }
  .hb__opt span { display: inline-block; padding: .55rem 1.05rem; border: 1px solid rgba(36,26,16,.25); border-radius: 999px; font-family: var(--font-display); font-size: .78rem; letter-spacing: .06em; cursor: pointer; transition: all .2s; }
  .hb__opt input:checked + span { background: var(--sp-ink); color: var(--sp-bone); border-color: var(--sp-ink); }
  .hb__opt input:focus-visible + span { outline: 2px solid var(--sp-gold-deep); outline-offset: 2px; }
  .hb__msg { min-height: 1.2rem; margin: .9rem 0 .4rem; font-size: .95rem; color: #8a2f2f; }
</style>

<script>
{% raw %}
(function () {
  var root = document.querySelector('[data-hb-root]');
  if (!root) return;
  var HAMPERS = [{"box": "Medium Box", "name": "Shubh Shagun", "content": "SS Coin (5g) + Raw stone diya", "price": 3499, "opts": ["diya", "coin5"]}, {"box": "Medium Box", "name": "Dhan Laxmi Shagun - I", "content": "Fish (5g) + Diya", "price": 4100, "opts": ["diya"]}, {"box": "Medium Box", "name": "Dhan Laxmi Shagun - II", "content": "Tortoise (5g) + Diya", "price": 4100, "opts": ["diya"]}, {"box": "Medium Box", "name": "Dhan Vriddhi", "content": "SS Coin (5g) + Diya + Laxmi Yantra", "price": 4700, "opts": ["diya", "coin5"]}, {"box": "Medium Box", "name": "Shri Samriddhi", "content": "SS Coin (5g) + Stone Ganpati", "price": 4100, "opts": ["ganesha", "coin5"]}, {"box": "Medium Box", "name": "Samriddhi Shree Charan Blessings - II", "content": "Charan Paduka on Chowki + Stone Ganesha", "price": 3700, "opts": ["ganesha"]}, {"box": "Medium Box", "name": "Samriddhi Shree Charan Blessings - I", "content": "Charan Paduka on Chowki + Stone Ganesha", "price": 3100, "opts": ["ganesha"]}, {"box": "Premium Hamper League (Large Box)", "name": "Laxmi Kripa Hamper", "content": "SS Coin (10g) + Fish (5g) + Laxmi Yantra", "price": 6999, "opts": ["coin10"]}, {"box": "Premium Hamper League (Large Box)", "name": "Raajsi Diwali Hamper", "content": "SS Coin (10g) + Tortoise (5g) + Laxmi Yantra", "price": 6999, "opts": ["coin10"]}, {"box": "Premium Hamper League (Large Box)", "name": "Shubh Samriddhi Hamper", "content": "SS Coin (10g) + Charan Paduka + Tortoise (5g)", "price": 9999, "opts": ["coin10"]}, {"box": "Premium Hamper League (Large Box)", "name": "Dhan Samriddhi Hamper", "content": "SS Coin (10g) + Fish (5g) + Tortoise (5g) + Laxmi Yantra + Diya", "price": 9999, "opts": ["coin10", "diya"]}, {"box": "Premium Hamper League (Large Box)", "name": "The Royal Shagun Hamper", "content": "Laxmi Charan Paduka + Vishnu Charan Paduka + Fish (5g) + Tortoise (5g) + Diya", "price": 19000, "opts": ["diya"]}, {"box": "Premium Hamper League (Large Box)", "name": "Shree Samriddhi Diwali Hamper", "content": "SS Coin (10g) + Laxmi Charan Paduka + Vishnu Charan Paduka + Fish (10g) + Tortoise (10g) + Diya + Laxmi Yantra (2 wooden boxes)", "price": 24999, "opts": ["coin10", "diya"]}];
  var CATS = {"diya": {"label": "Diya", "values": ["Amethyst", "Tiger Eye", "Rose Quartz"]}, "ganesha": {"label": "Stone Ganesha", "values": ["Amethyst", "Rose Quartz", "Tiger's Eye", "Labradorite"]}, "coin5": {"label": "5 gm Silver Coin", "values": ["Ganesh Ji", "Laxmi Ji", "Laxmi-Ganesha", "Kuber Ji"]}, "coin10": {"label": "10 gm Silver Coin", "values": ["Laxmi Ji", "Laxmi-Ganesha", "Kuber Ji"]}};
  var variants = [], IMGS = {}, OPTIMG = {};
  try { OPTIMG = JSON.parse(document.querySelector('[data-hb-optimgs]').textContent || '{}'); } catch (e) {}
  try { variants = JSON.parse(document.querySelector('[data-hb-variants]').textContent || '[]'); } catch (e) {}
  try { IMGS = JSON.parse(document.querySelector('[data-hb-imgs]').textContent || '{}'); } catch (e) {}
  function money(n) { return '₹' + Number(n).toLocaleString('en-IN'); }
  function esc(t) { return String(t).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
  function variantFor(h) { return variants.filter(function (x) { return x.title.trim().toLowerCase() === h.name.trim().toLowerCase(); })[0]; }
  function imgFor(h) { var v = variantFor(h); return (v && v.img) || (variants[0] && variants[0].img) || ''; }
  function itemKey(t) {
    var s = t.toLowerCase();
    if (s.indexOf('vishnu') > -1) return 'vishnu_paduka';
    if (s.indexOf('paduka') > -1) return 'laxmi_paduka';
    if (s.indexOf('coin') > -1) return 'coin';
    if (s.indexOf('diya') > -1) return 'diya';
    if (s.indexOf('fish') > -1) return 'fish';
    if (s.indexOf('tortoise') > -1) return 'tortoise';
    if (s.indexOf('yantra') > -1) return 'yantra';
    if (s.indexOf('ganesh') > -1 || s.indexOf('ganpati') > -1) return 'ganesha';
    return '';
  }
  function current() {
    var n = new URLSearchParams(window.location.search).get('h');
    if (n === null || n === '' || isNaN(Number(n))) return -1;
    n = Number(n); return HAMPERS[n] ? n : -1;
  }
  function boxIndex(box) { var bx = []; HAMPERS.forEach(function (x) { if (bx.indexOf(x.box) < 0) bx.push(x.box); }); return Math.max(0, bx.indexOf(box)); }
  function renderList() {
    var html = '<div class="hb__bar"><p class="eyebrow">Diwali Hampers</p><h1 class="h-sec hb__h1">Choose your hamper</h1><p class="lede" style="margin-top:.6rem">Pick a hamper to see what is inside and choose your diya and coin.</p></div><div class="hb__grid">';
    var boxes = []; HAMPERS.forEach(function (h) { if (boxes.indexOf(h.box) < 0) boxes.push(h.box); });
    var t = Number(new URLSearchParams(window.location.search).get('t')); if (!(t >= 0 && t < boxes.length)) t = 0;
    html = html.replace('<div class="hb__grid">', '') + '<div class="hb__tabs" role="tablist">';
    boxes.forEach(function (b, n) { html += '<a href="?t=' + n + '" role="tab" aria-selected="' + (n === t) + '" class="hb__tab' + (n === t ? ' is-on' : '') + '" data-hb-tab="' + n + '"><span class="full">' + esc(b) + '</span><span class="short">' + esc((b.match(/\(([^)]+)\)/) || [0, b])[1]) + '</span></a>'; });
    html += '</div><div class="hb__grid">';
    HAMPERS.forEach(function (h, i) {
      if (h.box !== boxes[t]) return;
      var src = imgFor(h);
      html += '<a class="hb__card" href="?h=' + i + '" data-hb-open="' + i + '"><div class="hb__ph">' + (src ? '<img src="' + esc(src) + '" alt="' + esc(h.name) + '" loading="lazy">' : '') + '</div><div class="hb__body"><span class="hb__name">' + esc(h.name) + '</span><span class="hb__content">' + esc(h.content) + '</span><span class="hb__row"><span class="hb__price">' + money(h.price) + '</span><span class="hb__cta">Customise &rarr;</span></span></div></a>';
    });
    root.innerHTML = html + '</div>';
  }
  function renderDetail(i) {
    var h = HAMPERS[i], src = imgFor(h);
    var inside = '';
    var catOf = function (k) { for (var n = 0; n < h.opts.length; n++) { var ck = h.opts[n].replace(/\d+$/, ''); if (ck === k) return h.opts[n]; } return ''; };
    var defaultImg = function (k) { var ck = catOf(k); if (!ck || !OPTIMG[k]) return ''; for (var n = 0; n < CATS[ck].values.length; n++) { if (OPTIMG[k][CATS[ck].values[n]]) return OPTIMG[k][CATS[ck].values[n]]; } return ''; };
    h.content.split(' + ').forEach(function (part) {
      var label = part.replace(/\s*\(2 wooden boxes\)/i, ''), k = itemKey(label), s = k && (OPTIMG[k] ? defaultImg(k) : IMGS[k]);
      inside += '<div class="hb__item' + (s ? '' : ' hb__item--txt') + '" data-k="' + (OPTIMG[k] ? k : '') + '" data-label="' + esc(label) + '"><span class="ph">' + (s ? '<img src="' + esc(s) + '" alt="' + esc(label) + '" loading="lazy">' : esc(label)) + '</span><em>' + esc(label) + '</em></div>';
    });
    var opts = '';
    h.opts.forEach(function (key) {
      var c = CATS[key], ok = key.replace(/\d+$/, '');
      opts += '<fieldset class="hb__group"><legend>Choose your ' + esc(c.label) + '</legend><div class="hb__opts">';
      c.values.forEach(function (v) { var th = OPTIMG[ok] && OPTIMG[ok][v]; opts += '<label class="hb__opt"><input type="radio" name="' + esc(c.label) + '" value="' + esc(v) + '" data-k="' + ok + '"><span>' + esc(v) + '</span></label>'; });
      opts += '</div></fieldset>';
    });
    root.innerHTML = '<a class="hb__back" href="' + window.location.pathname + '?t=' + boxIndex(h.box) + '" data-hb-back>&larr; All hampers</a><div class="hb__detail"><div class="hb__hero">' + (src ? '<img src="' + esc(src) + '" alt="' + esc(h.name) + '">' : '') + '</div><form data-hb-form><p class="eyebrow">' + esc(h.box) + '</p><h1 class="hb__title">' + esc(h.name) + '</h1><p class="hb__dprice">' + money(h.price) + ' <small>Inclusive of all taxes</small></p><h4 class="hb__h4">What’s inside</h4><div class="hb__items">' + inside + '</div>' + opts + '<p class="hb__msg" data-hb-msg role="status"></p><button type="submit" class="btn btn--ink btn--block btn--lg">' + (variants.length ? 'Add hamper to bag · ' + money(h.price) : 'Enquire about this hamper') + '</button></form></div>';
    var form = root.querySelector('[data-hb-form]'), msg = root.querySelector('[data-hb-msg]'), btn = form.querySelector('button[type=submit]');
    form.addEventListener('change', function (e) {
      var r = e.target; if (!r || r.type !== 'radio') return;
      var k = r.getAttribute('data-k'), s = OPTIMG[k] && OPTIMG[k][r.value];
      var tile = form.querySelector('.hb__item[data-k="' + k + '"]'); if (!tile) return;
      var ph = tile.querySelector('.ph');
      if (s) { ph.innerHTML = '<img src="' + esc(s) + '" alt="' + esc(r.value) + '">'; tile.classList.remove('hb__item--txt'); }
      else { ph.textContent = tile.getAttribute('data-label') + ' · ' + r.value; tile.classList.add('hb__item--txt'); }
    });
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var props ={ '_Includes': h.content }, missing = [];
      h.opts.forEach(function (key) {
        var c = CATS[key], r = form.querySelector('input[name="' + c.label + '"]:checked');
        if (r) props[c.label] = r.value; else missing.push(c.label);
      });
      if (missing.length) { msg.textContent = 'Please choose: ' + missing.join(', ') + '.'; return; }
      if (!variants.length) { window.location.href = '/pages/contact'; return; }
      var v = variantFor(h);
      if (!v) { msg.textContent = 'This hamper is not available to order online yet. Please contact us.'; return; }
      if (!v.available) { msg.textContent = 'This hamper is sold out.'; return; }
      msg.textContent = ''; btn.disabled = true;
      fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ items: [{ id: v.id, quantity: 1, properties: props }] }) })
        .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
        .then(function (res) {
          btn.disabled = false;
          if (!res.ok) { msg.textContent = res.j.description || res.j.message || 'Could not add the hamper.'; return; }
          var opener = document.querySelector('[data-cart-open]');
          if (opener) opener.click(); else window.location.href = '/cart';
        }).catch(function () { btn.disabled = false; msg.textContent = 'Something went wrong. Please try again.'; });
    });
  }
  function render() { var i = current(); if (i < 0) renderList(); else renderDetail(i); }
  root.addEventListener('click', function (e) {
    var a = e.target.closest('[data-hb-open], [data-hb-back], [data-hb-tab]'); if (!a) return;
    e.preventDefault();
    history.pushState({}, '', a.getAttribute('href'));
    render(); window.scrollTo({ top: 0, behavior: 'smooth' });
  });
  window.addEventListener('popstate', render);
  render();
})();
{% endraw %}
</script>

{% schema %}
{
  "name": "Diwali hampers",
  "tag": "section",
  "settings": [
    { "type": "product", "id": "hamper_product", "label": "Hamper product",
      "info": "One variant per hamper, named exactly like the hamper. Give each variant its own photo to show it on the hamper cards. Defaults to the product with handle diwali-hamper." },
    { "type": "color", "id": "bg_color", "label": "Background colour", "default": "#dbc596" },
    { "type": "image_picker", "id": "bg_image", "label": "Background photo" },
    { "type": "color_background", "id": "wash", "label": "Background wash", "default": "rgba(219,197,150,0.35)" },
    { "type": "header", "content": "Photos of the items inside a hamper" },
    { "type": "image_picker", "id": "img_fish", "label": "Fish" },
    { "type": "image_picker", "id": "img_tortoise", "label": "Tortoise" },
    { "type": "image_picker", "id": "img_yantra", "label": "Laxmi Yantra" },
    { "type": "image_picker", "id": "img_laxmi_paduka", "label": "Laxmi Charan Paduka" },
    { "type": "image_picker", "id": "img_vishnu_paduka", "label": "Vishnu Charan Paduka" }
  ],
  "presets": [{ "name": "Diwali hampers" }]
}
{% endschema %}
