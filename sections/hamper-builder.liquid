{%- comment -%}
  Diwali hamper page: a grid of every hamper, each opening its own product-style
  view (?h=N) where the diya / coin / Ganesha options are chosen and the hamper is
  added to the bag as a variant of the hamper product (variant title = hamper name).
{%- endcomment -%}
{%- assign hamper_product = section.settings.hamper_product -%}
{%- if hamper_product == blank -%}{%- assign hamper_product = all_products['diwali-hamper'] -%}{%- endif -%}

<div data-hb-hero>
{% render 'page-hero',
  eyebrow: 'Diwali Hampers',
  heading: 'Choose your hamper',
  image: section.settings.banner_image,
  description: 'Pick a hamper to see what is inside and choose your diya and coin.',
  fallback: 'hamper-hero.jpg',
  modifier: 'pagehero--hampers',
  min_height: '50vh' %}
</div>
<script>(function(){if(/[?&]h=\d/.test(location.search))document.body.classList.add("hb-detail");var h=document.querySelector("[data-hb-hero]"),d=document.querySelector("[data-header]");if(/[?&]h=\d/.test(location.search)){if(h)h.hidden=true;}else if(d){d.classList.add("header--light");}})();</script>

<section class="heritage-sec sec hb" style="background: {{ section.settings.bg_color }}">
  {% render 'heritage-bg',
    image: section.settings.bg_image,
    fallback: 'heritage-mandala-corner.jpg',
    wash: section.settings.wash %}
  <div class="wrap">
    <div data-hb-root></div>
  </div>
</section>

<script type="application/json" data-hb-variants>
  {%- if hamper_product != blank -%}
    [{%- for v in hamper_product.variants -%}
      {%- assign vimg = v.featured_media.preview_image | default: hamper_product.featured_media.preview_image -%}
      {"id":{{ v.id }},"title":{{ v.title | json }},"price":{{ v.price }},"sku":{{ v.sku | json }},"available":{{ v.available }},"img":{% if vimg != blank %}{{ vimg | image_url: width: 900 | json }}{% else %}""{% endif %}}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}]
  {%- else -%}[]{%- endif -%}
</script>
<script type="application/json" data-hb-imgs>
  {
    {%- assign hk = 'fish,tortoise,yantra,laxmi_paduka,vishnu_paduka' | split: ',' -%}
    {%- for k in hk -%}
      {%- assign sid = 'img_' | append: k -%}
      {%- assign im = section.settings[sid] -%}
      "{{ k }}": {% if im != blank %}{{ im | image_url: width: 300 | json }}{% elsif k == 'fish' %}{{ 'hamper-item-fish.jpg' | asset_url | json }}{% elsif k == 'laxmi_paduka' %}{{ 'hamper-item-laxmi-paduka.jpg' | asset_url | json }}{% elsif k == 'vishnu_paduka' %}{{ 'hamper-item-vishnu-paduka.jpg' | asset_url | json }}{% elsif k == 'yantra' %}{{ 'hamper-item-yantra-pyramid.jpg' | asset_url | json }}{% elsif k == 'tortoise' %}{{ 'hamper-item-tortoise.jpg' | asset_url | json }}{% else %}""{% endif %}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  }
</script>

<script type="application/json" data-hb-gallery>
  {
    "Samriddhi Shree Charan Blessings - I": [{{ 'hamper-photo-35.jpg' | asset_url | json }}],
    "Samriddhi Shree Charan Blessings - II": [{{ 'hamper-photo-36.jpg' | asset_url | json }}],
    "Dhan Samriddhi Hamper": [{{ 'hamper-photo-33.jpg' | asset_url | json }}],
    "The Royal Shagun Hamper": [{{ 'hamper-photo-25.jpg' | asset_url | json }}],
    "Shubh Shagun": [{{ 'hamper-photo-30.jpg' | asset_url | json }}],
    "Dhan Laxmi Shagun - I": [{{ 'hamper-photo-32.jpg' | asset_url | json }}],
    "Dhan Laxmi Shagun - II": [{{ 'hamper-photo-31.jpg' | asset_url | json }}],
    "Shri Samriddhi": [{{ 'hamper-photo-28.jpg' | asset_url | json }}],
    "Dhan Vriddhi": [{{ 'hamper-photo-39.jpg' | asset_url | json }}],
    "Laxmi Kripa Hamper": [{{ 'hamper-photo-23.jpg' | asset_url | json }}],
    "Raajsi Diwali Hamper": [{{ 'hamper-photo-24.jpg' | asset_url | json }}],
    "Shubh Samriddhi Hamper": [{{ 'hamper-photo-38.jpg' | asset_url | json }}],
    "Shree Samriddhi Diwali Hamper": [{{ 'hamper-photo-26.jpg' | asset_url | json }}]
  }
</script>
{%- comment -%} per-hamper item photo overrides (charan size photos) {%- endcomment -%}
<script type="application/json" data-hb-override>
  {
    "Samriddhi Shree Charan Blessings - I": {"laxmi_paduka": {{ 'charan-small.jpg' | asset_url | json }}},
    "Samriddhi Shree Charan Blessings - II": {"laxmi_paduka": {{ 'charan-big.jpg' | asset_url | json }}},
    "Shubh Samriddhi Hamper": {"laxmi_paduka": {{ 'charan-small.jpg' | asset_url | json }}}
  }
</script>
<script type="application/json" data-hb-optimgs>
  {
    "diya": {"Lapis Lazuli": {{ 'diya-pair-lapis-lazuli.jpg' | asset_url | json }}, "Yellow Honey Calcite": {{ 'diya-pair-yellow-honey-calcite.jpg' | asset_url | json }}, "Amethyst": {{ 'diya-pair-amethyst.jpg' | asset_url | json }}, "Black Agate": {{ 'diya-pair-black-agate.jpg' | asset_url | json }}, "Tiger Eye": {{ 'diya-pair-tiger-eye.jpg' | asset_url | json }}, "Green Aventurine": {{ 'diya-pair-green-aventurine.jpg' | asset_url | json }}, "Clear Quartz": {{ 'diya-pair-clear-quartz.jpg' | asset_url | json }}, "Rose Quartz": {{ 'hamper-diya-rose-quartz.jpg' | asset_url | json }}},
    "ganesha": {"Amethyst": {{ 'hamper-ganesha-amethyst.jpg' | asset_url | json }}, "Rose Quartz": {{ 'hamper-ganesha-rose-quartz.jpg' | asset_url | json }}, "Tiger's Eye": {{ 'hamper-ganesha-tigers-eye.jpg' | asset_url | json }}, "Labradorite": {{ 'hamper-ganesha-labradorite.jpg' | asset_url | json }}},
    "coin": {"Ganesh Ji": {{ 'hamper-coin-ganesh.jpg' | asset_url | json }}, "Laxmi Ji": {{ 'hamper-coin-laxmi.jpg' | asset_url | json }}, "Kuber Ji": {{ 'hamper-coin-kuber.jpg' | asset_url | json }}, "Laxmi-Ganesha": {{ 'hamper-coin-laxmi-ganesha.jpg' | asset_url | json }}}
  }
</script>

<style>
  .hb__item--txt span.ph { display: flex; align-items: center; justify-content: center; padding: .4rem; font-family: var(--font-display); font-size: .78rem; letter-spacing: .06em; text-align: center; color: var(--sp-ink); background: rgba(217,182,108,.18); }
  .hb__item--txt em { display: none; }
  .hb__opt span img { width: 1.6rem; height: 1.6rem; border-radius: 50%; object-fit: cover; vertical-align: middle; margin: -.2rem .5rem -.2rem -.45rem; }
  .hb__bar { text-align: center; margin-bottom: 2rem; }
  .hb { padding-top: 2.5rem; }
  .hb.hb--detail { padding-top: 2.75rem; padding-bottom: 0; background: var(--sp-bone) !important; }
  .hb.hb--detail .heritage-sec__bg, .hb.hb--detail .heritage-sec__wash { display: none; }
  .hb.hb--detail > .wrap { padding-inline: 0; max-width: none; }
  .hb.hb--detail .pdp .wrap { padding-inline: 1.25rem; }
  @media (min-width: 768px) { .hb.hb--detail .pdp .wrap { padding-inline: 2.5rem; } }
  @media (max-width: 767px) {
    .hb.hb--detail { padding-top: 1.75rem; }
    .hb .pdp__grid { gap: 1.5rem; padding-bottom: 3.5rem; }
    .hb .buybox__title { font-size: 1.6rem; margin-top: .6rem; }
    .hb .buybox__price { margin-top: .6rem; }
    .hb__items { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .7rem; }
    .hb form[data-hb-form] { display: flex; flex-direction: column; }
    .hb form[data-hb-form] .hb__group { order: 1; }
    .hb form[data-hb-form] .hb__h4, .hb form[data-hb-form] .hb__items { order: 2; }
    .hb form[data-hb-form] .hb__msg { order: 3; }
    .hb form[data-hb-form] .buybox__actions { order: 4; }
    .hb form[data-hb-form] .buybox__trust { order: 5; }
    .hb__opt span { padding: .5rem .85rem; font-size: .72rem; }
    .hb .buybox__actions { gap: .5rem; }
    .hb .buybox__actions .btn { flex: 1 1 0; min-width: 0; padding: .85rem .5rem; font-size: .7rem; letter-spacing: .08em; white-space: nowrap; }
    .hb .buybox__trust { margin-top: 1.4rem; }
    .hb__msg { min-height: .4rem; margin: .5rem 0 .2rem; }
    .hb .pdp__grid { padding-bottom: 6.5rem; }
    .hb .buybox__trust > div > span:last-child { font-size: .6rem; }
    .hb__group { margin-top: 1rem; }
  }
  body:not(.hb-detail) [id$="__hb_celeb"], body:not(.hb-detail) [id$="__hb_recent"], body:not(.hb-detail) [id$="__hb_faq"] { display: none; }
  .hb__h1 { font-size: clamp(1.3rem, 6.2vw, 2.6rem); white-space: nowrap; }
  .hb__tab .short { display: none; }
  .hb__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .8rem; }
  .hb__body { flex: 0 1 auto !important; }
  @media (min-width: 520px) { .hb__grid { gap: 1.25rem; } }
  @media (max-width: 639px) {
    .hb__tabs { flex-wrap: nowrap; gap: .4rem; }
    .hb__tab { flex: 1 1 0; text-align: center; padding: .6rem .5rem; font-size: .7rem; letter-spacing: .08em; white-space: nowrap; }
    .hb__tab .full { display: none; }
    .hb__tab .short { display: inline; }
    .hb__body { padding: .7rem .75rem .9rem; }
    .hb__name { font-size: .88rem; min-height: 0; }
    .hb__content { display: none; }
    .hb__price { font-size: .95rem; }
    .hb__cta { font-size: .65rem; letter-spacing: .1em; }
    .hb__row { gap: .25rem; }
  }
  @media (min-width: 860px) { .hb__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 1150px) { .hb__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .hb__tabs { display: flex; flex-wrap: wrap; justify-content: center; gap: .5rem; margin: 0 auto 1.75rem; }
  .hb__tab { background: var(--sp-bone, #f2e8d0); padding: .65rem 1.4rem; border: 1px solid rgba(36,26,16,.25); border-radius: 999px; font-family: var(--font-display); font-size: .78rem; letter-spacing: .12em; text-transform: uppercase; color: var(--sp-ink); text-decoration: none; transition: all .2s; }
  .hb__tab.is-on { background: var(--sp-ink); color: var(--sp-bone); border-color: var(--sp-ink); }
  .hb__boxname { grid-column: 1 / -1; margin: 1rem 0 0; font-family: var(--font-display); font-size: .8rem; letter-spacing: .2em; text-transform: uppercase; color: var(--sp-gold-deep); }
  .hb__card { display: flex; flex-direction: column; border: 1.5px solid var(--sp-gold-mid, #c9a35c); border-radius: var(--radius-lg, 1.25rem); background: var(--sp-bone, #f2e8d0); overflow: hidden; text-decoration: none; color: var(--sp-ink); transition: transform .3s, box-shadow .3s; }
  .hb__note { margin: .15rem 0 0; font-size: .8rem; line-height: 1.3; color: var(--sp-brown-soft, #6b5a3e); opacity: .85; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .hb__card:hover { transform: translateY(-3px); box-shadow: 0 16px 34px -18px rgba(36,26,16,.5); }
  .hb__ph { aspect-ratio: 1/1; background: var(--sp-bone-2, #e8d8b3); }
  .hb__ph img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hb__body { padding: 1rem 1.1rem 1.25rem; display: flex; flex-direction: column; gap: .3rem; flex: 1; }
  .hb__name { font-family: var(--font-display); font-size: 1.05rem; line-height: 1.25; min-height: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block; }
  .hb__content { font-family: var(--font-body); font-size: .95rem; color: rgba(36,26,16,.7); }
  .hb__row { display: flex; align-items: baseline; justify-content: space-between; gap: .75rem; flex-wrap: wrap; margin-top: .15rem; }
  .hb__price { font-family: var(--font-display); font-size: 1.05rem; font-weight: 700; }
  .hb__cta { font-family: var(--font-display); font-size: .75rem; letter-spacing: .16em; text-transform: uppercase; color: var(--sp-gold-deep); }
  .hb__back { display: inline-block; margin-bottom: 1.25rem; font-family: var(--font-display); font-size: .78rem; letter-spacing: .16em; text-transform: uppercase; color: var(--sp-gold-deep); text-decoration: none; }
  .hb__detail { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.75rem; }
  @media (min-width: 900px) { .hb__detail { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 3rem; align-items: start; } }
  .hb__hero { border: 1.5px solid var(--sp-gold-mid, #c9a35c); border-radius: var(--radius-xl, 1.5rem); overflow: hidden; background: var(--sp-bone-2, #e8d8b3); aspect-ratio: 1/1; }
  .hb__taxnote { font-family: var(--font-body); font-size: .95rem; font-weight: 400; color: rgba(36,26,16,.55); letter-spacing: 0; }
  .hb .pdp__grid > *, .hb .pdp__media, .hb form { min-width: 0; max-width: 100%; }
  .hb .buybox__price { flex-wrap: wrap; align-items: baseline; column-gap: .75rem; }
  .hb__opt span img { display: none; }
  .hb__opt span b { font-weight: inherit; }
  .hb__thumbs { display: flex; gap: .6rem; margin-top: .75rem; }
  .hb__thumb { width: 4.6rem; height: 4.6rem; padding: 0; border: 1.5px solid rgba(36,26,16,.2); border-radius: .8rem; overflow: hidden; background: var(--sp-bone-2, #e8d8b3); cursor: pointer; opacity: .75; transition: all .2s; }
  .hb__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hb__thumb.is-on, .hb__thumb:hover { opacity: 1; border-color: var(--sp-gold-deep, #8a6a2e); }
  .hb__hero img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hb__title { margin: .3rem 0 .4rem; font-size: clamp(1.7rem, 3vw, 2.4rem); }
  .hb__dprice { font-family: var(--font-display); font-size: 1.5rem; font-weight: 700; margin-bottom: .5rem; }
  .hb__h4 { margin: .6rem 0 .6rem; font-family: var(--font-display); font-size: .82rem; letter-spacing: .14em; text-transform: uppercase; color: var(--sp-gold-deep); }
  .hb__dprice small { margin-left: .6rem; font-family: var(--font-body); font-size: 1rem; font-weight: 400; color: rgba(36,26,16,.65); }
  .hb__items { display: grid; grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr)); gap: .8rem; }
  .hb__item { text-align: center; }
  .hb__item span.ph { display: block; aspect-ratio: 1/1; border-radius: var(--radius-sm, .75rem); overflow: hidden; background: rgba(36,26,16,.06); border: 1px solid rgba(36,26,16,.12); }
  .hb__item img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hb__item em { display: block; margin-top: .3rem; font-style: normal; font-family: var(--font-body); font-size: .85rem; line-height: 1.25; }
  .hb__group { border: 0; margin: 1.2rem 0 0; padding: 0; }
  .hb__group legend { margin-bottom: .5rem; font-family: var(--font-display); font-size: .82rem; letter-spacing: .14em; text-transform: uppercase; color: var(--sp-gold-deep); }
  .hb__opts { display: flex; flex-wrap: wrap; gap: .5rem; }
  .hb__opt input { position: absolute; opacity: 0; pointer-events: none; }
  .hb__opt span { display: inline-block; padding: .55rem 1.05rem; border: 1px solid rgba(36,26,16,.25); border-radius: 999px; font-family: var(--font-display); font-size: .78rem; letter-spacing: .06em; cursor: pointer; transition: all .2s; }
  .hb__opt input:checked + span { background: var(--sp-ink); color: var(--sp-bone); border-color: var(--sp-ink); }
  .hb__opt input:focus-visible + span { outline: 2px solid var(--sp-gold-deep); outline-offset: 2px; }
  .hb__msg { min-height: 1.2rem; margin: .9rem 0 .4rem; font-size: .95rem; color: #8a2f2f; }
</style>

<script>
{% raw %}
(function () {
  var root = document.querySelector('[data-hb-root]');
  if (!root) return;
  var HAMPERS = [{"box": "Medium Box", "name": "Samriddhi Shree Charan Blessings - I", "content": "Charan Paduka on White Lotus Marble (Small charan - 1.30 × 1.10 inches) + Stone Ganesha", "price": 3100, "opts": ["ganesha"]}, {"box": "Medium Box", "name": "Shubh Shagun", "content": "SS Coin (5g) + Raw stone diya", "price": 3499, "opts": ["diya", "coin5"]}, {"box": "Medium Box", "name": "Samriddhi Shree Charan Blessings - II", "content": "Charan Paduka on White Lotus Marble (Big charan - 1.5 × 1.25 inches) + Stone Ganesha", "price": 3700, "opts": ["ganesha"]}, {"box": "Medium Box", "name": "Dhan Laxmi Shagun - I", "content": "Fish (5g) + Diya", "price": 4100, "opts": ["diya"]}, {"box": "Medium Box", "name": "Dhan Laxmi Shagun - II", "content": "Tortoise (5g) + Diya", "price": 4100, "opts": ["diya"]}, {"box": "Medium Box", "name": "Shri Samriddhi", "content": "SS Coin (5g) + Stone Ganpati", "price": 4100, "opts": ["ganesha", "coin5"]}, {"box": "Medium Box", "name": "Dhan Vriddhi", "content": "SS Coin (5g) + Diya + Laxmi Yantra", "price": 4700, "opts": ["diya", "coin5"]}, {"box": "Premium Hamper League (Large Box)", "name": "Laxmi Kripa Hamper", "content": "SS Coin (10g) + Fish (5g) + Laxmi Yantra", "price": 6999, "opts": ["coin10"]}, {"box": "Premium Hamper League (Large Box)", "name": "Raajsi Diwali Hamper", "content": "SS Coin (10g) + Tortoise (5g) + Laxmi Yantra", "price": 6999, "opts": ["coin10"]}, {"box": "Premium Hamper League (Large Box)", "name": "Shubh Samriddhi Hamper", "content": "SS Coin (10g) + Charan Paduka + Tortoise (5g)", "price": 9999, "opts": ["coin10"]}, {"box": "Premium Hamper League (Large Box)", "name": "Dhan Samriddhi Hamper", "content": "SS Coin (10g) + Fish (5g) + Tortoise (5g) + Laxmi Yantra + Diya", "price": 9999, "opts": ["coin10", "diya"]}, {"box": "Premium Hamper League (Large Box)", "name": "The Royal Shagun Hamper", "content": "Laxmi Charan Paduka + Vishnu Charan Paduka + Fish (5g) + Tortoise (5g) + Diya", "price": 19000, "opts": ["diya"]}, {"box": "Premium Hamper League (Large Box)", "name": "Shree Samriddhi Diwali Hamper", "content": "SS Coin (10g) + Laxmi Charan Paduka + Vishnu Charan Paduka + Fish (10g) + Tortoise (10g) + Diya + Laxmi Yantra (2 wooden boxes)", "price": 24999, "opts": ["coin10", "diya"]}];
  var CATS = {"diya": {"label": "Diya", "values": ["Amethyst", "Black Agate", "Clear Quartz", "Green Aventurine", "Lapis Lazuli", "Rose Quartz", "Tiger Eye", "Yellow Honey Calcite"]}, "ganesha": {"label": "Stone Ganesha", "values": ["Amethyst", "Rose Quartz", "Tiger's Eye", "Labradorite"]}, "coin5": {"label": "5 gm Silver Coin", "values": ["Ganesh Ji", "Laxmi Ji", "Laxmi-Ganesha", "Kuber Ji"]}, "coin10": {"label": "10 gm Silver Coin", "values": ["Laxmi Ji", "Laxmi-Ganesha", "Kuber Ji"]}};
  var variants = [], IMGS = {}, OPTIMG = {}, GALLERY = {}, OVERRIDE = {};
  try { OVERRIDE = JSON.parse(document.querySelector('[data-hb-override]').textContent || '{}'); } catch (e) {}
  try { GALLERY = JSON.parse(document.querySelector('[data-hb-gallery]').textContent || '{}'); } catch (e) {}
  try { OPTIMG = JSON.parse(document.querySelector('[data-hb-optimgs]').textContent || '{}'); } catch (e) {}
  try { variants = JSON.parse(document.querySelector('[data-hb-variants]').textContent || '[]'); } catch (e) {}
  try { IMGS = JSON.parse(document.querySelector('[data-hb-imgs]').textContent || '{}'); } catch (e) {}
  function money(n) { return '₹' + Number(n).toLocaleString('en-IN'); }
  function esc(t) { return String(t).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
  function variantFor(h) { return variants.filter(function (x) { return x.title.trim().toLowerCase() === h.name.trim().toLowerCase(); })[0]; }
  function gallery(h) { var g = (GALLERY[h.name] || []).slice(0, 3); if (g.length) return g; var v = variantFor(h), one = (v && v.img) || (variants[0] && variants[0].img) || ''; return one ? [one] : []; }
  function imgFor(h) { return gallery(h)[0] || ''; }
  function itemKey(t) {
    var s = t.toLowerCase();
    if (s.indexOf('vishnu') > -1) return 'vishnu_paduka';
    if (s.indexOf('paduka') > -1) return 'laxmi_paduka';
    if (s.indexOf('coin') > -1) return 'coin';
    if (s.indexOf('diya') > -1) return 'diya';
    if (s.indexOf('fish') > -1) return 'fish';
    if (s.indexOf('tortoise') > -1) return 'tortoise';
    if (s.indexOf('yantra') > -1) return 'yantra';
    if (s.indexOf('ganesh') > -1 || s.indexOf('ganpati') > -1) return 'ganesha';
    return '';
  }
  function current() {
    var n = new URLSearchParams(window.location.search).get('h');
    if (n === null || n === '' || isNaN(Number(n))) return -1;
    n = Number(n); return HAMPERS[n] ? n : -1;
  }
  function boxIndex(box) { var bx = []; HAMPERS.forEach(function (x) { if (bx.indexOf(x.box) < 0) bx.push(x.box); }); return Math.max(0, bx.indexOf(box)); }
  function renderList() {
    var html = '<div class="hb__grid">';
    var boxes = []; HAMPERS.forEach(function (h) { if (boxes.indexOf(h.box) < 0) boxes.push(h.box); });
    var t = Number(new URLSearchParams(window.location.search).get('t')); if (!(t >= 0 && t < boxes.length)) t = 0;
    html = html.replace('<div class="hb__grid">', '') + '<div class="hb__tabs" role="tablist">';
    boxes.forEach(function (b, n) { html += '<a href="?t=' + n + '" role="tab" aria-selected="' + (n === t) + '" class="hb__tab' + (n === t ? ' is-on' : '') + '" data-hb-tab="' + n + '"><span class="full">' + esc(b) + '</span><span class="short">' + esc((b.match(/\(([^)]+)\)/) || [0, b])[1]) + '</span></a>'; });
    html += '</div><div class="hb__grid">';
    HAMPERS.forEach(function (h, i) {
      if (h.box !== boxes[t]) return;
      var src = imgFor(h);
      html += '<a class="card" href="?h=' + i + '" data-hb-open="' + i + '"><div class="card__frame"><div class="card__mat"><div class="card__media">' + (src ? '<img class="card__img card__img--main" src="' + esc(src) + '" alt="' + esc(h.name) + '" loading="lazy">' : '') + '</div></div><div class="card__body"><h3 class="card__title">' + esc(h.name) + '</h3>' + note(h) + '<p class="card__price"><span>' + money(h.price) + '</span></p><span class="card__buy">Customise</span></div></div></a>';
    });
    root.innerHTML = html + '</div>';
  }
  function note(h) {
    var m = /\((Small|Big) charan - ([^)]*)\)/i.exec(h.content || '');
    return m ? '<p class="hb__note">' + esc(m[1] + ' Charan \u00b7 ' + m[2]) + '</p>' : '';
  }
  function renderDetail(i) {
    var h = HAMPERS[i], gal = gallery(h), src = gal[0] || '';
    var thumbs = gal.length > 1 ? '<div class="hb__thumbs">' + gal.map(function (g, n) { return '<button type="button" class="hb__thumb' + (n === 0 ? ' is-on' : '') + '" data-hb-thumb="' + esc(g) + '" aria-label="Photo ' + (n + 1) + '"><img src="' + esc(g) + '" alt=""></button>'; }).join('') + '</div>' : '';
    var inside = '';
    var catOf = function (k) { for (var n = 0; n < h.opts.length; n++) { var ck = h.opts[n].replace(/\d+$/, ''); if (ck === k) return h.opts[n]; } return ''; };
    var defaultImg = function (k) { var ck = catOf(k); if (!ck || !OPTIMG[k]) return ''; for (var n = 0; n < CATS[ck].values.length; n++) { if (OPTIMG[k][CATS[ck].values[n]]) return OPTIMG[k][CATS[ck].values[n]]; } return ''; };
    h.content.split(' + ').forEach(function (part) {
      var label = part.replace(/\s*\(2 wooden boxes\)/i, ''), k = itemKey(label), s = k && (OPTIMG[k] ? defaultImg(k) : ((OVERRIDE[h.name] && OVERRIDE[h.name][k]) || IMGS[k]));
      inside += '<div class="hb__item' + (s ? '' : ' hb__item--txt') + '" data-k="' + (OPTIMG[k] ? k : '') + '" data-label="' + esc(label) + '"><span class="ph">' + (s ? '<img src="' + esc(s) + '" alt="' + esc(label) + '" loading="lazy">' : esc(label)) + '</span><em>' + esc(label) + '</em></div>';
    });
    var opts = '';
    h.opts.forEach(function (key) {
      var c = CATS[key], ok = key.replace(/\d+$/, '');
      opts += '<fieldset class="hb__group"><legend>Choose your ' + esc(c.label) + '</legend><div class="hb__opts">';
      c.values.forEach(function (v) { var th = OPTIMG[ok] && OPTIMG[ok][v]; opts += '<label class="hb__opt"><input type="radio" name="' + esc(c.label) + '" value="' + esc(v) + '" data-k="' + ok + '"><span>' + esc(v) + '</span></label>'; });
      opts += '</div></fieldset>';
    });
    root.innerHTML = '<div class="pdp"><div class="wrap wrap--narrow" style="max-width:1400px"><nav aria-label="Breadcrumb" class="breadcrumb"><a href="' + window.location.pathname + '?t=' + boxIndex(h.box) + '" data-hb-back>Diwali Hampers</a><span>/</span><span style="color:rgba(36,26,16,.75)">' + esc(h.name) + '</span></nav><div class="pdp__grid"><div class="pdp__media"><div class="hb__hero">' + (src ? '<img data-hb-main src="' + esc(src) + '" alt="' + esc(h.name) + '">' : '') + '</div>' + thumbs + '</div><div><form data-hb-form><div style="display:flex;align-items:center;gap:.75rem;flex-wrap:wrap"><span class="buybox__chip">' + esc(h.box) + '</span></div><h1 class="buybox__title">' + esc(h.name) + '</h1><p class="buybox__price"><span>' + money(h.price) + '</span><small class="hb__taxnote">Inclusive of all taxes</small></p>' + ((variantFor(h) && variantFor(h).sku) ? '<p class="buybox__sku">SKU: ' + esc(variantFor(h).sku) + '</p>' : '') + '<h4 class="hb__h4">What\u2019s inside</h4><div class="hb__items">' + inside + '</div>' + opts + '<p class="hb__msg" data-hb-msg role="status"></p><div class="buybox__actions"><button type="submit" class="btn btn--ink btn--lg" data-hb-buy>' + (variants.length ? 'Buy now' : 'Enquire') + '</button><button type="submit" class="btn btn--outline-gold btn--lg" data-hb-add>' + (variants.length ? 'Add to cart' : 'Enquire about this hamper') + '</button></div><div class="buybox__trust"><div><span>&#10003;</span><span>BIS Certified</span></div><div><span>&#10022;</span><span>925 Sterling Silver</span></div><div><span>&#9825;</span><span>Skin-Friendly</span></div></div></form></div></div></div></div>';
    var form = root.querySelector('[data-hb-form]'), msg = root.querySelector('[data-hb-msg]'), btn = form.querySelector('[data-hb-add]'), buyBtn = form.querySelector('[data-hb-buy]'), goCheckout = false;
    [btn, buyBtn].forEach(function (b) { if (b) b.addEventListener('click', function () { goCheckout = (b === buyBtn); }); });
    root.querySelectorAll('[data-hb-thumb]').forEach(function (b) { b.addEventListener('click', function () { var m = root.querySelector('[data-hb-main]'); if (m) m.src = b.getAttribute('data-hb-thumb'); root.querySelectorAll('.hb__thumb').forEach(function (x) { x.classList.toggle('is-on', x === b); }); }); });
    form.addEventListener('change', function (e) {
      var r = e.target; if (!r || r.type !== 'radio') return;
      var k = r.getAttribute('data-k'), s = OPTIMG[k] && OPTIMG[k][r.value];
      var tile = form.querySelector('.hb__item[data-k="' + k + '"]'); if (!tile) return;
      var ph = tile.querySelector('.ph');
      if (s) { ph.innerHTML = '<img src="' + esc(s) + '" alt="' + esc(r.value) + '">'; tile.classList.remove('hb__item--txt'); }
      else { ph.textContent = tile.getAttribute('data-label') + ' · ' + r.value; tile.classList.add('hb__item--txt'); }
    });
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var props ={ '_Includes': h.content }, missing = [];
      h.opts.forEach(function (key) {
        var c = CATS[key], r = form.querySelector('input[name="' + c.label + '"]:checked');
        if (r) props[c.label] = r.value; else missing.push(c.label);
      });
      if (missing.length) { msg.textContent = 'Please choose: ' + missing.join(', ') + '.'; return; }
      if (!variants.length) { window.location.href = '/pages/contact'; return; }
      var v = variantFor(h);
      if (!v) { msg.textContent = 'This hamper is not available to order online yet. Please contact us.'; return; }
      if (!v.available) { msg.textContent = 'This hamper is sold out.'; return; }
      msg.textContent = ''; btn.disabled = true; if (buyBtn) buyBtn.disabled = true;
      fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ items: [{ id: v.id, quantity: 1, properties: props }] }) })
        .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
        .then(function (res) {
          btn.disabled = false; if (buyBtn) buyBtn.disabled = false;
          if (!res.ok) { msg.textContent = res.j.description || res.j.message || 'Could not add the hamper.'; return; }
          if (goCheckout) { window.location.href = '/checkout'; return; }
          var opener = document.querySelector('[data-cart-open]');
          if (opener) opener.click(); else window.location.href = '/cart';
        }).catch(function () { btn.disabled = false; if (buyBtn) buyBtn.disabled = false; msg.textContent = 'Something went wrong. Please try again.'; });
    });
  }
  function render() {
    var i = current(), hero = document.querySelector('[data-hb-hero]'), hdr = document.querySelector('[data-header]'), sec = root.closest('.hb');
    if (hero) hero.hidden = i >= 0;
    if (hdr && hero) hdr.classList.toggle('header--light', i < 0);
    if (sec) sec.classList.toggle('hb--detail', i >= 0);
    document.body.classList.toggle('hb-detail', i >= 0);
    if (hdr) { if (i >= 0) hdr.classList.add('header--nohero'); else if (hero) hdr.classList.remove('header--nohero'); }
    if (i < 0) renderList(); else renderDetail(i);
  }
  root.addEventListener('click', function (e) {
    var a = e.target.closest('[data-hb-open], [data-hb-back], [data-hb-tab]'); if (!a) return;
    e.preventDefault();
    history.pushState({}, '', a.getAttribute('href'));
    render(); window.scrollTo({ top: 0, behavior: 'smooth' });
  });
  window.addEventListener('popstate', render);
  render();
})();
{% endraw %}
</script>

