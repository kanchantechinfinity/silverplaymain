{%- comment -%}
  Bento grid of collection tiles beside a headline column.
  Tile heights follow the source's unequal 1.5/1 · 1/1.3 rhythm.
{%- endcomment -%}
{%- assign flexes = '1.5,1,1,1.3' | split: ',' -%}
<section class="heritage-sec on-dark" style="background: var(--sp-ink); padding: 4rem 0;">
  {% render 'heritage-bg',
    image: section.settings.bg_image,
    fallback: 'heritage-peacock-garden.png',
    wash: 'rgba(36,26,16,0.72)' %}
  {% render 'icon', name: 'monument', class: 'occasion__monument' %}

  <div class="wrap occasion__grid">
    <div data-reveal>
      <div style="display:flex;flex-direction:column;align-items:flex-start;padding-top:.5rem">
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_url | default: routes.collections_url }}" class="btn btn--outline-bone mt-4"
             style="height:2.75rem;padding-block:0;font-size:.6rem">{{ section.settings.cta_label }}</a>
        {%- endif -%}
        <h2 class="mt-5" style="font-size:clamp(2.2rem,4.6vw,3.4rem);text-transform:uppercase;line-height:1.05">
          {{ section.settings.heading }}
        </h2>
      </div>
    </div>

    <div class="occasion__bento" data-stagger="0.09">
      <div class="occasion__col">
        {%- for block in section.blocks limit: 2 -%}
          {% render 'occasion-card', block: block, flex: flexes[forloop.index0], wide: forloop.last %}
        {%- endfor -%}
      </div>
      <div class="occasion__col">
        {%- for block in section.blocks offset: 2 limit: 2 -%}
          {% render 'occasion-card', block: block, flex: flexes[forloop.index0 | plus: 2], wide: forloop.first %}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop by occasion",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Dressed For The Moment" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop By Occasion" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop Now" },
    { "type": "url", "id": "cta_url", "label": "Button link" },
    { "type": "image_picker", "id": "bg_image", "label": "Background photo" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Occasion tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "image_picker", "id": "image", "label": "Image override" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by occasion",
      "blocks": [
        { "type": "tile", "settings": { "title": "Bali Collection" } },
        { "type": "tile", "settings": { "title": "Party Wear" } },
        { "type": "tile", "settings": { "title": "Office Muse" } },
        { "type": "tile", "settings": { "title": "Everyday Elegance" } }
      ]
    }
  ]
}
{% endschema %}
