{%- comment -%}Seamless CSS marquee of trust claims. Track rendered twice, translated -50%.{%- endcomment -%}
{%- include 'campaign-data' -%}
<div class="assurance">
  <div class="marquee" data-marquee="{{ section.settings.speed }}">
    <div class="marquee__rail">
      {%- for i in (1..2) -%}
        <div class="marquee__track" aria-hidden="{% if i == 2 %}true{% else %}false{% endif %}">
          {%- for block in section.blocks -%}
            <span class="marquee__item" {{ block.shopify_attributes }}>
              <span class="assurance__item">{{ block.settings.text }}</span>
              {%- if camp != '' -%}
                <span class="marquee__sep marquee__sep--fest" aria-hidden="true">
                  <svg viewBox="0 0 48 48" width="22" height="22"><path d="M24 3c5 7 7 11 7 16a7 7 0 0 1-14 0c0-5 2-9 7-16z" fill="#e8a53a"/><path d="M3 25h42c0 10-9 17-21 17S3 35 3 25z" fill="#b8862d"/><path d="M3 25h42" stroke="#6b4512" stroke-width="1.4"/><path d="M14 42h20l-2 4H16z" fill="#8a5c1a"/></svg><svg viewBox="0 0 120 40" width="48" height="16"><g transform="rotate(-16 60 20)"><rect x="4" y="15" width="112" height="10" rx="5" fill="#b8862d"/><rect x="20" y="15" width="6" height="10" fill="#7a1f1c"/><rect x="94" y="15" width="6" height="10" fill="#7a1f1c"/></g><g transform="rotate(16 60 20)"><rect x="4" y="15" width="112" height="10" rx="5" fill="#b8862d"/><rect x="20" y="15" width="6" height="10" fill="#1f4d3a"/><rect x="94" y="15" width="6" height="10" fill="#1f4d3a"/></g></svg><svg viewBox="0 0 48 48" width="22" height="22"><path d="M24 3c5 7 7 11 7 16a7 7 0 0 1-14 0c0-5 2-9 7-16z" fill="#e8a53a"/><path d="M3 25h42c0 10-9 17-21 17S3 35 3 25z" fill="#b8862d"/><path d="M3 25h42" stroke="#6b4512" stroke-width="1.4"/><path d="M14 42h20l-2 4H16z" fill="#8a5c1a"/></svg>
                </span>
              {%- else -%}
                <span class="marquee__sep">{{ section.settings.separator }}</span>
              {%- endif -%}
            </span>
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Assurance marquee",
  "tag": "div",
  "settings": [
    { "type": "range", "id": "speed", "min": 10, "max": 120, "step": 2, "unit": "s", "label": "Loop duration", "default": 48 },
    { "type": "text", "id": "separator", "label": "Separator", "default": "—" }
  ],
  "blocks": [
    { "type": "item", "name": "Claim", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "BIS Certified" } ] }
  ],
  "presets": [
    {
      "name": "Assurance marquee",
      "blocks": [
        { "type": "item", "settings": { "text": "BIS Certified" } },
        { "type": "item", "settings": { "text": "925 Sterling Silver" } },
        { "type": "item", "settings": { "text": "Purity Guaranteed" } },
        { "type": "item", "settings": { "text": "Artisan Crafted in India" } },
        { "type": "item", "settings": { "text": "Savings With Every Purchase" } },
        { "type": "item", "settings": { "text": "The Silver Play Exchange Policy" } },
        { "type": "item", "settings": { "text": "Free Shipping on Prepaid Orders" } },
        { "type": "item", "settings": { "text": "Skin-Friendly" } }
      ]
    }
  ]
}
{% endschema %}
