{%- comment -%}
  Promo banner — a single image with optional copy over it. Separate desktop and
  mobile artwork, swapped with <picture> so a phone never downloads the wide crop.
  Drop it anywhere in the theme editor; it is used on the homepage after The Fresh
  Edit. With no image set it shows a packaged fallback rather than an empty box.
{%- endcomment -%}
{%- liquid
  assign d = section.settings.image_desktop
  assign m = section.settings.image_mobile | default: d
  assign has_copy = false
  if section.settings.heading != blank or section.settings.eyebrow != blank or section.settings.text != blank or section.settings.cta_label != blank
    assign has_copy = true
  endif
  assign link = section.settings.cta_url
-%}

<section class="sec--flush">
  <div class="wrap{% if section.settings.full_width %} wrap--full{% endif %}">
    {%- if link != blank and section.settings.link_whole_banner -%}<a href="{{ link }}" class="banner banner--link" style="--banner-h:{{ section.settings.height }}px;--banner-h-m:{{ section.settings.height_mobile }}px">{%- else -%}<div class="banner" style="--banner-h:{{ section.settings.height }}px;--banner-h-m:{{ section.settings.height_mobile }}px">{%- endif -%}

      <div class="banner__media">
        {%- if d != blank or m != blank -%}
          <picture>
            {%- if m != blank -%}
              <source media="(max-width: 767px)"
                      srcset="{{ m | image_url: width: 750 }} 750w, {{ m | image_url: width: 1100 }} 1100w"
                      sizes="100vw">
            {%- endif -%}
            <img src="{{ d | default: m | image_url: width: 1800 }}"
                 srcset="{{ d | default: m | image_url: width: 900 }} 900w,
                         {{ d | default: m | image_url: width: 1400 }} 1400w,
                         {{ d | default: m | image_url: width: 1800 }} 1800w"
                 sizes="100vw"
                 alt="{{ section.settings.heading | escape }}"
                 loading="lazy" decoding="async" width="1800" height="700">
          </picture>
        {%- else -%}
          <img src="{{ 'archive-balcony.jpg' | asset_url }}" alt="" loading="lazy" decoding="async" width="1600" height="1000">
        {%- endif -%}
        {%- if section.settings.overlay > 0 -%}
          <span class="banner__scrim" aria-hidden="true" style="opacity:{{ section.settings.overlay | divided_by: 100.0 }}"></span>
        {%- endif -%}
      </div>

      {%- if has_copy -%}
        <div class="banner__body banner__body--{{ section.settings.align }}">
          {%- if section.settings.eyebrow != blank -%}
            <p class="eyebrow" data-reveal>{{ section.settings.eyebrow }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="banner__title" data-reveal data-delay="0.08">{{ section.settings.heading }}</h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <p class="banner__text" data-reveal data-delay="0.14">{{ section.settings.text }}</p>
          {%- endif -%}
          {%- if section.settings.cta_label != blank and section.settings.link_whole_banner == false -%}
            <div data-reveal data-delay="0.2">
              <a href="{{ link | default: routes.all_products_collection_url }}" class="btn btn--bone mt-6">
                {{ section.settings.cta_label }} <span class="btn__arrow">&rarr;</span>
              </a>
            </div>
          {%- elsif section.settings.cta_label != blank -%}
            <span class="btn btn--bone mt-6" data-reveal data-delay="0.2">
              {{ section.settings.cta_label }} <span class="btn__arrow">&rarr;</span>
            </span>
          {%- endif -%}
        </div>
      {%- endif -%}

    {%- if link != blank and section.settings.link_whole_banner -%}</a>{%- else -%}</div>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Banner",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image_desktop", "label": "Banner — desktop",
      "info": "Shown from 768px up. A wide crop works best." },
    { "type": "image_picker", "id": "image_mobile", "label": "Banner — mobile",
      "info": "Shown below 768px. Use a taller crop. Falls back to the desktop banner if left empty." },
    { "type": "header", "content": "Size" },
    { "type": "range", "id": "height", "min": 220, "max": 760, "step": 20, "unit": "px", "label": "Height (desktop)", "default": 420 },
    { "type": "range", "id": "height_mobile", "min": 180, "max": 620, "step": 20, "unit": "px", "label": "Height (mobile)", "default": 320 },
    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": false },
    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "select", "id": "align", "label": "Copy position", "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" },
        { "value": "right", "label": "Right" }
      ] },
    { "type": "range", "id": "overlay", "min": 0, "max": 80, "step": 5, "unit": "%", "label": "Image darkening", "default": 35,
      "info": "Raise this if the copy is hard to read over the photo." },
    { "type": "header", "content": "Link" },
    { "type": "text", "id": "cta_label", "label": "Button label" },
    { "type": "url", "id": "cta_url", "label": "Link" },
    { "type": "checkbox", "id": "link_whole_banner", "label": "Make the whole banner clickable", "default": false }
  ],
  "presets": [
    { "name": "Banner" }
  ]
}
{% endschema %}
