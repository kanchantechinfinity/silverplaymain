{%- comment -%}
  Template for the free festive gift product (product.free-gift). The gift is only
  ever added to the bag by the offer logic, so its own page just sends visitors home.
{%- endcomment -%}
<section class="sec" style="background:var(--sp-bone);min-height:40vh">
  <div class="wrap text-center">
    <p class="lede">This is a complimentary festive gift and is not sold separately.</p>
    <p class="mt-6"><a class="btn btn--ink" href="{{ routes.root_url }}">Back to home</a></p>
  </div>
</section>
<script>setTimeout(function () { location.replace({{ routes.root_url | json }}); }, 1500);</script>
{% schema %}
{ "name": "Free gift redirect", "settings": [] }
{% endschema %}
