<section class="sec on-dark">
  <div class="wrap">
    <div class="text-center">
      <p class="eyebrow" data-reveal>{{ section.settings.eyebrow }}</p>
      <h2 class="h-sec--sm mt-3" data-split data-reveal="none">{{ section.settings.heading }}</h2>
    </div>

    <div class="faq__list">
      {%- for block in section.blocks -%}
        <div class="faq__row" data-faq-row {{ block.shopify_attributes }}>
          <button type="button" class="faq__btn" data-faq-btn aria-expanded="false" aria-controls="faq-{{ block.id }}">
            <span class="faq__fill" aria-hidden="true"></span>
            <span class="faq__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <span class="faq__q">
              <h3>{{ block.settings.question }}</h3>
              <span class="faq__a" id="faq-{{ block.id }}">{{ block.settings.answer }}</span>
            </span>
            <span class="faq__toggle" aria-hidden="true">{% render 'icon', name: 'arrow-out' %}</span>
          </button>
          {%- if block.settings.image != blank -%}
            <span class="faq__thumb" aria-hidden="true">
              <img src="{{ block.settings.image | image_url: width: 300 }}" alt="" loading="lazy" width="300" height="450">
            </span>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Good To Know" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Asked" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "textarea", "id": "answer", "label": "Answer" },
        { "type": "image_picker", "id": "image", "label": "Hover image" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "faq", "settings": { "question": "How long does delivery take?", "answer": "Orders are dispatched within 2–3 business days. Delivery typically takes 5–7 business days across India. Prepaid orders ship free. You'll receive a tracking link via WhatsApp/email once your order is shipped." } },
        { "type": "faq", "settings": { "question": "What is the return policy?", "answer": "Silver Play does not accept returns or exchanges for change of mind. We only replace or refund an item if it arrives damaged, defective, or not matching what you ordered — reported within 24 hours of delivery with photos or an unboxing video." } },
        { "type": "faq", "settings": { "question": "How do I care for my silver jewellery?", "answer": "Store in the anti-tarnish pouch provided. Avoid contact with perfume, lotions, and water. Wipe gently with a soft cloth after wearing. For deep cleaning, use a mild silver polishing cloth." } },
        { "type": "faq", "settings": { "question": "Why is silver called sterling silver?", "answer": "Pure silver is too soft to wear every day, so it is blended with a small amount of another metal — usually copper — for strength. 'Sterling' silver is the standard that is 92.5% pure silver and 7.5% other metals, which is why every piece is stamped '925'." } }
      ]
    }
  ]
}
{% endschema %}
