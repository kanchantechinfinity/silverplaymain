{%- comment -%}
  "What's Inside The Box" — four unboxing items as repeatable blocks so the
  merchant can edit them; a product's own custom.box_contents metafield
  (list.single_line_text_field) overrides the block titles when present.
{%- endcomment -%}
{%- assign override = product.metafields.custom.box_contents.value -%}
<section style="border-top:1px solid var(--sp-line);background:var(--sp-bone-2);padding-block:4rem">
  <div class="wrap wrap--narrow">
    <div class="gilt gilt--lg">
      <div class="gilt__inner heritage-sec on-dark" style="background:var(--sp-ink);padding:2.5rem 1.5rem">
        {% render 'heritage-bg', image: section.settings.bg_image, fallback: 'vanity-mood.jpg', wash: 'rgba(36,26,16,0.8)' %}

        <div class="text-center">
          <p class="eyebrow" style="color:#c9a35c" data-reveal>{{ section.settings.eyebrow }}</p>
          <h2 class="mt-3" style="font-size:clamp(1.5rem,3vw,2.1rem)">{{ section.settings.heading }}</h2>
        </div>

        <div class="boxcontents" data-stagger="0.09">
          {%- if override != blank -%}
            {%- for item in override -%}
              <div>
                <span class="boxcontents__icon">{% render 'icon', name: 'gem' %}</span>
                <p class="boxcontents__t">{{ item }}</p>
              </div>
            {%- endfor -%}
          {%- else -%}
            {%- for block in section.blocks -%}
              <div {{ block.shopify_attributes }}>
                <span class="boxcontents__icon">{% render 'icon', name: block.settings.icon %}</span>
                <p class="boxcontents__t">{{ block.settings.title }}</p>
                <p class="boxcontents__c">{{ block.settings.copy }}</p>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Box contents",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Unboxing" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What's Inside The Box" },
    { "type": "image_picker", "id": "bg_image", "label": "Background photo" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "gem",
          "options": [
            { "value": "gem", "label": "Gem" },
            { "value": "certificate", "label": "Certificate" },
            { "value": "pouch", "label": "Pouch" },
            { "value": "cloth", "label": "Cloth" },
            { "value": "shield", "label": "Shield" }
          ] },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "copy", "label": "Copy" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Box contents",
      "blocks": [
        { "type": "item", "settings": { "icon": "gem", "title": "Your Silver Play Piece", "copy": "Individually assayed and laser-hallmarked before it ships." } },
        { "type": "item", "settings": { "icon": "certificate", "title": "BIS Hallmark Certificate", "copy": "A digital QR card verifying purity and provenance." } },
        { "type": "item", "settings": { "icon": "pouch", "title": "Anti-Tarnish Pouch", "copy": "Airtight storage that keeps the shine for years." } },
        { "type": "item", "settings": { "icon": "cloth", "title": "Silver Polishing Cloth", "copy": "For the gentle at-home clean between wears." } }
      ]
    }
  ]
}
{% endschema %}
