{%- comment -%}
  "Her Royal Simplicity" — horizontal card rail.
  The page scrolls normally past this section; the card rail is its own
  horizontally-swipeable strip (native overflow-x), not driven by page scroll.
{%- endcomment -%}
{%- liquid
  assign col = collections[section.settings.collection]
  assign items = col.products
-%}

<section class="deck" data-deck
         aria-roledescription="carousel" aria-label="{{ section.settings.heading | escape }}">
  <div class="deck__stage on-dark" style="background: {{ section.settings.bg_color | default: '#241a10' }}">
    {% render 'heritage-bg',
      image: section.settings.bg_image,
      fallback: 'deck-mandala-peacock.jpg',
      wash: section.settings.wash %}

    <div class="deck__head">
      {% render 'heading',
        eyebrow: section.settings.eyebrow,
        heading: section.settings.heading,
        lede: section.settings.lede,
        class: 'h-sec' %}
    </div>

    <div class="deck__viewport">
      {%- comment -%}
        Three copies of the rail: a real (accessible) middle set flanked by two
        buffer sets (aria-hidden). theme.js starts centred in the middle set and
        silently wraps back into it as the buffers scroll by, so the strip feels
        like it repeats forever with no dead end.
      {%- endcomment -%}
      <div class="deck__rail" data-set-size="{{ items.size | default: 4 }}">
        {%- for rep in (1..3) -%}
          {%- assign is_buffer = true -%}
          {%- if rep == 2 -%}{%- assign is_buffer = false -%}{%- endif -%}
          {%- for product in items -%}
            <div class="deck__card{% if rep == 2 and forloop.first %} is-active{% endif %}" data-deck-card{% if is_buffer %} aria-hidden="true"{% endif %}>
              {%- if product.featured_media -%}
                <img src="{{ product.featured_media | image_url: width: 900 }}"
                     alt="{{ product.title | escape }}" loading="{% if rep == 2 and forloop.index <= 2 %}eager{% else %}lazy{% endif %}"
                     width="900" height="1100">
              {%- endif -%}
              <span class="deck__wash" aria-hidden="true"></span>
              <div class="deck__chip"><span>{{ product.price | money }}</span></div>
              <div class="deck__label">
                <p>{{ product.metafields.custom.tagline.value | default: product.title }}</p>
              </div>
              <a href="{{ product.url }}" class="visually-hidden"{% if is_buffer %} tabindex="-1"{% endif %}>{{ product.title }}</a>
            </div>
          {%- else -%}
            {%- for i in (1..4) -%}
              <div class="deck__card{% if rep == 2 and forloop.first %} is-active{% endif %}"{% if is_buffer %} aria-hidden="true"{% endif %}>
                <img src="{{ 'stock-product-1.jpg' | asset_url }}" alt="" loading="lazy" decoding="async" width="1600" height="1067">
                <span class="deck__wash" aria-hidden="true"></span>
              </div>
            {%- endfor -%}
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>

    <span class="deck__fade" aria-hidden="true"></span>

    <div class="deck__controls">
      <button type="button" class="round-btn" data-deck-prev aria-label="{{ 'accessibility.previous' | t }}">&larr;</button>
      <button type="button" class="round-btn round-btn--solid" data-deck-next aria-label="{{ 'accessibility.next' | t }}">&rarr;</button>
      {%- if col != blank -%}
        <a href="{{ col.url }}" class="link-cta link-cta--bone" style="margin-left:1rem">
          {{ section.settings.cta_label }} <span>&rarr;</span>
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Scroll deck edit",
  "tag": "section",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Edit" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Her Royal Simplicity" },
    { "type": "textarea", "id": "lede", "label": "Intro", "default": "For the woman who loves jewellery that feels effortless, personal and quietly beautiful." },
    { "type": "text", "id": "cta_label", "label": "Link label", "default": "Shop The Edit" },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#241a10" },
    { "type": "image_picker", "id": "bg_image", "label": "Background photo" },
    { "type": "color_background", "id": "wash", "label": "Background wash", "default": "rgba(36,26,16,0.72)" }
  ],
  "presets": [{ "name": "Scroll deck edit" }]
}
{% endschema %}
