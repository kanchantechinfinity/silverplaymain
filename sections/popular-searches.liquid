{%- comment -%}
  Popular searches: groups of links to collections, shown above the footer.
  Each group is a heading plus one "Link text | collection-handle" per line,
  editable in the theme editor. Links always point at /collections/handle.
{%- endcomment -%}
<section class="psearch" aria-labelledby="psearch-h">
  <div class="wrap">
    <h2 class="psearch__h" id="psearch-h">{{ section.settings.heading }}</h2>
    <div class="psearch__grid">
      {%- assign t = section.settings.g1_title -%}
      {%- assign lines = section.settings.g1_links | newline_to_br | strip_newlines | split: '<br />' -%}
      {%- if t != blank and lines.size > 0 -%}
        <div class="psearch__group">
          <h3>{{ t }}</h3>
          <p>
            {%- for line in lines -%}
              {%- assign pair = line | split: '|' -%}
              {%- assign label = pair[0] | strip -%}
              {%- assign handle = pair[1] | strip -%}
              {%- if label != blank and handle != blank -%}<a href="{{ routes.root_url }}collections/{{ handle }}">{{ label }}</a>{%- endif -%}
            {%- endfor -%}
          </p>
        </div>
      {%- endif -%}
      {%- assign t = section.settings.g2_title -%}
      {%- assign lines = section.settings.g2_links | newline_to_br | strip_newlines | split: '<br />' -%}
