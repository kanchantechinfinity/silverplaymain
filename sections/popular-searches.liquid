            {%- endfor -%}
          </p>
        </div>
      {%- endif -%}
      {%- assign t = section.settings.g3_title -%}
      {%- assign lines = section.settings.g3_links | newline_to_br | strip_newlines | split: '<br />' -%}
      {%- if t != blank and lines.size > 0 -%}
