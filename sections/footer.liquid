<footer class="footer grain" role="contentinfo">
  <div class="wrap" style="padding-block:5rem">
    <div class="footer__grid">
      <div data-reveal>
        <div class="footer__logo">
          {%- if settings.logo != blank -%}
            <img src="{{ settings.logo | image_url: width: 400 }}" alt="{{ shop.name | escape }}" width="400" height="400" loading="lazy">
          {%- else -%}
            <img src="{{ 'logo-mark.png' | asset_url }}" alt="{{ shop.name | escape }}" width="120" height="120" loading="lazy" style="width:auto;height:8rem">
          {%- endif -%}
        </div>
        {%- if settings.brand_statement != blank -%}
          <p class="footer__statement">{{ settings.brand_statement }}</p>
        {%- endif -%}
        <div class="footer__social">
          {%- if settings.social_instagram != blank -%}
            <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener noreferrer">Instagram</a>
          {%- endif -%}
          {%- if settings.social_facebook != blank -%}
            <a href="{{ settings.social_facebook }}" target="_blank" rel="noopener noreferrer">Facebook</a>
          {%- endif -%}
        </div>
        {%- if section.settings.show_newsletter -%}
          {% form 'customer' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="footer__newsletter">
              <input type="email" name="contact[email]" required placeholder="{{ 'general.newsletter_form.email_placeholder' | t }}" aria-label="{{ 'general.newsletter_form.email_placeholder' | t }}">
              <button type="submit" class="btn btn--bone">{{ 'general.newsletter_form.button_label' | t }}</button>
            </div>
            {%- if form.posted_successfully? -%}
              <p class="mt-2" style="font-size:.85rem;color:var(--sp-gold)">{{ 'general.newsletter_form.confirmation' | t }}</p>
            {%- endif -%}
          {% endform %}
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        <div class="footer__col" data-reveal data-delay="{{ forloop.index | times: 0.08 }}" {{ block.shopify_attributes }}>
          <h4>{{ block.settings.heading }}</h4>
          <ul>
            {%- for l in linklists[block.settings.menu].links -%}
              <li><a href="{{ l.url }}">{{ l.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}
    </div>

    <div class="footer__rule"></div>

    <div class="footer__bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.copyright_suffix }}</p>
      <p>{{ settings.brand_curator }}</p>
    </div>

    {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
      <div class="mt-6" style="display:flex;gap:.5rem;flex-wrap:wrap;justify-content:center;opacity:.7">
        {%- for type in shop.enabled_payment_types -%}
          {{ type | payment_type_svg_tag: class: 'payment-icon' }}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "copyright_suffix", "label": "Copyright suffix", "default": "All rights reserved. Crafted with devotion in India." },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter signup", "default": true },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Explore" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ],
  "default": {
    "settings": {
      "copyright_suffix": "All rights reserved. Crafted with devotion in India.",
      "show_newsletter": true,
      "show_payment_icons": true
    },
    "blocks": [
      { "type": "menu", "settings": { "heading": "Explore", "menu": "footer" } },
      { "type": "menu", "settings": { "heading": "Care & Policy", "menu": "footer" } },
      { "type": "menu", "settings": { "heading": "Connect", "menu": "footer" } }
    ]
  }
}
{% endschema %}
