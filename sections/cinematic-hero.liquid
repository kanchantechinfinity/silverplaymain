{%- comment -%}
  Cinematic hero — full-viewport brand video, playing normally (autoplay,
  loop, muted), not driven by scroll. One heading overlay, not a sequence
  of scroll-triggered chapters.

  Add one or more "Slide" blocks to turn this into a sliding banner instead
  (each with its own image, heading and button) — with none added it falls
  back to the single video/banner behaviour below, unchanged.
{%- endcomment -%}
{%- liquid
  assign poster = section.settings.poster
  assign media_type = section.settings.media_type | default: 'video'
  assign banner_d = section.settings.banner_desktop
  assign banner_m = section.settings.banner_mobile | default: banner_d
-%}

<div class="cinehero" data-page-hero data-cinehero{% if section.blocks.size > 0 %} data-cinehero-slider{% endif %}>
  <div class="cinehero__stage">
    {%- if section.blocks.size > 0 -%}
      <div class="cinehero__slides" data-cinehero-slides>
        {%- for block in section.blocks -%}
          {%- liquid
            assign s_d = block.settings.image_desktop
            assign s_m = block.settings.image_mobile | default: s_d
          -%}
          <div class="cinehero__slide{% if forloop.first %} is-active{% endif %}{% if block.settings.fit_contain %} cinehero__slide--contain{% endif %}" data-cinehero-slide {{ block.shopify_attributes }}>
            {%- if block.settings.fit_contain -%}
              {%- if s_d != blank or s_m != blank -%}
                {%- comment -%} Blurred, zoomed-in copy filling the frame behind the uncropped image, so any letterbox gap reads as a soft continuation of the same photo instead of empty space. {%- endcomment -%}
                <img class="cinehero__backdrop" src="{{ s_d | default: s_m | image_url: width: 1200 }}" alt="" aria-hidden="true" width="1200" height="675" loading="lazy">
              {%- endif -%}
            {%- endif -%}
            <picture>
              {%- if s_m != blank -%}
                <source media="(max-width: 767px)"
                        srcset="{{ s_m | image_url: width: 750 }} 750w, {{ s_m | image_url: width: 1100 }} 1100w"
                        sizes="100vw">
              {%- endif -%}
              {%- if s_d != blank or s_m != blank -%}
                <img class="cinehero__video" src="{{ s_d | default: s_m | image_url: width: 1800 }}"
                     srcset="{{ s_d | default: s_m | image_url: width: 1200 }} 1200w,
                             {{ s_d | default: s_m | image_url: width: 1800 }} 1800w,
                             {{ s_d | default: s_m | image_url: width: 2400 }} 2400w"
                     sizes="100vw" alt="{{ block.settings.heading | escape }}"
                     width="2400" height="1350" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
              {%- else -%}
                <img class="cinehero__video" src="{{ 'archive-balcony.jpg' | asset_url }}" alt="" width="1600" height="1000" loading="lazy">
              {%- endif -%}
            </picture>
            <span class="cinehero__scrim-a" aria-hidden="true"></span>
            <span class="cinehero__scrim-b" aria-hidden="true"></span>

            {%- if block.settings.link_url != blank -%}
              {%- comment -%} Covers the whole slide so clicking anywhere on the banner navigates — sits below the button (a sibling, not nested inside it) so the button's own link still takes priority where the two overlap. {%- endcomment -%}
              <a href="{{ block.settings.link_url }}" class="cinehero__slidelink" aria-label="{{ block.settings.heading | default: 'View' | escape }}"></a>
            {%- endif -%}

            <div class="cinehero__content">
              <div class="cinehero__inner">
                {%- if block.settings.devanagari != blank -%}
                  <p class="cinehero__deva">{{ block.settings.devanagari }}</p>
                {%- endif -%}
                {%- if block.settings.heading != blank -%}
                  <h1 class="cinehero__title">{{ block.settings.heading }}</h1>
                {%- endif -%}
                {%- if block.settings.subtitle != blank -%}
                  <p class="cinehero__sub">{{ block.settings.subtitle }}</p>
                {%- endif -%}
                {%- if block.settings.cta_label != blank -%}
                  <a href="{{ block.settings.cta_url | default: routes.all_products_collection_url }}" class="btn btn--bone btn--lg cinehero__cta">
                    {{ block.settings.cta_label }} <span class="btn__arrow">&rarr;</span>
                  </a>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
      {%- if section.blocks.size > 1 -%}
        <div class="cinehero__dots" data-cinehero-dots></div>
      {%- endif -%}
    {%- elsif media_type == 'image' -%}
      {%- comment -%}
        Banner instead of film. <picture> does the swap in markup, so the phone
        never downloads the desktop crop -- no JS, no layout shift. Falls back to
        the desktop art if only one is set.
      {%- endcomment -%}
      {%- if banner_d != blank or banner_m != blank -%}
        <picture>
          {%- if banner_m != blank -%}
            <source media="(max-width: 767px)"
                    srcset="{{ banner_m | image_url: width: 750 }} 750w, {{ banner_m | image_url: width: 1100 }} 1100w"
                    sizes="100vw">
          {%- endif -%}
          <img class="cinehero__video" src="{{ banner_d | default: banner_m | image_url: width: 1800 }}"
               srcset="{{ banner_d | default: banner_m | image_url: width: 1200 }} 1200w,
                       {{ banner_d | default: banner_m | image_url: width: 1800 }} 1800w,
                       {{ banner_d | default: banner_m | image_url: width: 2400 }} 2400w"
               sizes="100vw" alt="{{ section.settings.heading | escape }}"
               width="2400" height="1350" fetchpriority="high">
        </picture>
      {%- else -%}
        <img class="cinehero__video" src="{{ 'archive-balcony.jpg' | asset_url }}" alt=""
             width="1600" height="1000" fetchpriority="high">
      {%- endif -%}
    {%- elsif section.settings.video != blank -%}
      {{ section.settings.video
        | video_tag:
          class: 'cinehero__video',
          muted: true,
          loop: true,
          autoplay: true,
          playsinline: true,
          controls: false,
          preload: 'auto',
          image_size: '1600x'
      }}
    {%- elsif section.settings.video_url != blank -%}
      <video class="cinehero__video" muted playsinline autoplay loop preload="auto"
             {% if poster != blank %}poster="{{ poster | image_url: width: 1600 }}"{% endif %}>
        <source src="{{ section.settings.video_url }}" type="video/mp4">
      </video>
    {%- else -%}
      {%- comment -%} Bundled brand footage — used until a merchant sets their own Shopify-hosted video or Files URL above. {%- endcomment -%}
      <video class="cinehero__video" muted playsinline autoplay loop preload="auto"
             {% if poster != blank %}poster="{{ poster | image_url: width: 1600 }}"{% endif %}>
        <source src="{{ 'silverplay-cinematic.mp4' | asset_url }}" type="video/mp4">
      </video>
    {%- endif -%}

    {%- unless section.blocks.size > 0 -%}
      <span class="cinehero__scrim-a" aria-hidden="true"></span>
      <span class="cinehero__scrim-b" aria-hidden="true"></span>
      {%- if section.settings.corner_vignette -%}
        <span class="cinehero__corner" aria-hidden="true"></span>
      {%- endif -%}

      <div class="cinehero__content">
        <div class="cinehero__inner">
          {%- if section.settings.devanagari != blank -%}
            <p class="cinehero__deva">{{ section.settings.devanagari }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h1 class="cinehero__title">{{ section.settings.heading }}</h1>
          {%- endif -%}
          {%- if section.settings.subtitle != blank -%}
            <p class="cinehero__sub">{{ section.settings.subtitle }}</p>
          {%- endif -%}
          {%- if section.settings.cta_label != blank -%}
            <a href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}" class="btn btn--bone btn--lg cinehero__cta">
              {{ section.settings.cta_label }} <span class="btn__arrow">&rarr;</span>
            </a>
          {%- endif -%}
        </div>
      </div>
    {%- endunless -%}
  </div>
</div>

{% schema %}
{
  "name": "Cinematic hero",
  "tag": "section",
  "settings": [
    { "type": "select", "id": "media_type", "label": "Hero media", "default": "video",
      "options": [
        { "value": "video", "label": "Video" },
        { "value": "image", "label": "Banner image" }
      ],
      "info": "Choose \"Banner image\" to show a still banner instead of the film. The video settings below are then ignored." },
    { "type": "header", "content": "Banner image" },
    { "type": "image_picker", "id": "banner_desktop", "label": "Banner — desktop",
      "info": "Shown from 768px up. A wide crop works best." },
    { "type": "image_picker", "id": "banner_mobile", "label": "Banner — mobile",
      "info": "Shown below 768px. Use a taller crop. Falls back to the desktop banner if left empty." },
    { "type": "header", "content": "Video" },
    { "type": "video", "id": "video", "label": "Hero video (Shopify-hosted)" },
    { "type": "url", "id": "video_url", "label": "Hero video URL (MP4 fallback)",
      "info": "Use this if the file is uploaded to Files rather than as a Shopify video. Upload the brand film under Content > Files and paste its URL." },
    { "type": "image_picker", "id": "poster", "label": "Poster image" },
    { "type": "checkbox", "id": "corner_vignette", "label": "Bottom-right corner vignette", "default": true,
      "info": "Masks a watermark baked into the source footage." },
    { "type": "text", "id": "devanagari", "label": "Devanagari line" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Timeless Silver." },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Crafted as Heritage." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Explore Collection" },
    { "type": "url", "id": "cta_url", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image_desktop", "label": "Image — desktop", "info": "Shown from 768px up. A wide crop works best." },
        { "type": "image_picker", "id": "image_mobile", "label": "Image — mobile", "info": "Shown below 768px. Falls back to the desktop image if left empty." },
        { "type": "checkbox", "id": "fit_contain", "label": "Fit whole image without cropping", "default": false,
          "info": "Turn on for a banner with text baked into the image (so nothing gets cropped off) — leaves empty bars on screens the image doesn't exactly match. Leave off for a full-bleed photo." },
        { "type": "url", "id": "link_url", "label": "Banner link", "info": "Makes the whole slide clickable — wherever you tap/click on it, not just the button below." },
        { "type": "text", "id": "devanagari", "label": "Devanagari line" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "text", "id": "subtitle", "label": "Subtitle" },
        { "type": "text", "id": "cta_label", "label": "Button label" },
        { "type": "url", "id": "cta_url", "label": "Button link" }
      ]
    }
  ],
  "presets": [
    { "name": "Cinematic hero" }
  ]
}
{% endschema %}
