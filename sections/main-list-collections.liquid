{% render 'page-hero',
  eyebrow: section.settings.eyebrow,
  heading: section.settings.heading,
  image: section.settings.banner_image,
  description: section.settings.description %}

<div class="wrap" style="padding-block:4rem">
  <div class="grid-products">
    {%- if section.settings.list != blank -%}
      {%- for col in section.settings.list -%}
        {%- render 'collection-tile', col: col, show_empty: section.settings.show_empty -%}
      {%- endfor -%}
    {%- else -%}
      {%- comment -%}
        collections is Shopify's paginate-able global drop of every collection
        in the shop — Dawn's own list-collections.liquid wraps it in
        {% paginate %} the same way; iterating it unwrapped can silently cap
        or misbehave once the shop has more than a page's worth of collections.
      {%- endcomment -%}
      {%- paginate collections by 250 -%}
        {%- for col in collections -%}
          {%- render 'collection-tile', col: col, show_empty: section.settings.show_empty -%}
        {%- endfor -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Collections list",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Browse" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "All Collections" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "From everyday earrings to spiritual Kavach pendants — every Silver Play edit in one place." },
    { "type": "image_picker", "id": "banner_image", "label": "Banner image" },
    { "type": "collection_list", "id": "list", "label": "Collections shown", "info": "Leave empty to list every collection." },
    { "type": "checkbox", "id": "show_empty", "label": "Show empty collections", "default": false }
  ]
}
{% endschema %}
