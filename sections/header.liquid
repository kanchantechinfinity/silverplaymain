{%- liquid
  assign menu = linklists[section.settings.menu]
  assign mega_handle = section.settings.mega_menu_trigger | downcase
  assign mobile_menu = linklists[section.settings.mobile_menu] | default: menu
-%}

<header class="header{% if request.page_type == 'collection' %} header--light{% endif %}{% if request.page_type == 'index' %} header--light-mobile{% endif %}" data-header role="banner">
  {%- if section.settings.haiku != blank -%}
    {%- assign hz_parts = section.settings.haiku | split: ' / ' -%}
    {%- capture hz_diya -%}<svg class="hz-ic hz-diya" viewBox="0 0 48 48" width="22" height="22" aria-hidden="true"><path class="hz-flame" d="M24 2c5 7 7 11 7 16a7 7 0 0 1-14 0c0-5 2-9 7-16z" fill="#f5b942"/><path d="M24 9c2.500 4 3.500 6 3.500 8.500a3.500 3.500 0 0 1-7 0c0-2.500 1-4.500 3.500-8.500z" fill="#fff1bd"/><path d="M3 25h42c0 10-9 17-21 17S3 35 3 25z" fill="#d9b25f"/><path d="M3 25h42" stroke="#7a521a" stroke-width="1.4"/><path d="M14 42h20l-2 4H16z" fill="#8a5c1a"/></svg>{%- endcapture -%}
    {%- capture hz_lantern -%}<svg class="hz-ic hz-lantern" viewBox="0 0 40 60" width="16" height="24" aria-hidden="true"><line x1="20" y1="0" x2="20" y2="7" stroke="#d9b25f" stroke-width="1.500"/><path d="M20 7c5 3 9 5 9 9H11c0-4 4-6 9-9z" fill="#d9b25f"/><path d="M10 16h20l2 24-12 8-12-8z" fill="#8a2018" stroke="#d9b25f" stroke-width="1.500"/><ellipse class="hz-flame" cx="20" cy="29" rx="5" ry="8" fill="#f5b942" opacity=".9"/><path d="M16 48h8l-1 5h-6z" fill="#d9b25f"/><path d="M18 53v6M20 53v7M22 53v6" stroke="#d9b25f" stroke-width="1.200"/></svg>{%- endcapture -%}
    {%- capture hz_marigold -%}<svg class="hz-ic hz-marigold" viewBox="0 0 40 40" width="20" height="20" aria-hidden="true"><g fill="#e8a53a"><circle cx="20" cy="9" r="7"/><circle cx="31" cy="20" r="7"/><circle cx="20" cy="31" r="7"/><circle cx="9" cy="20" r="7"/><circle cx="28" cy="12" r="6"/><circle cx="28" cy="28" r="6"/><circle cx="12" cy="28" r="6"/><circle cx="12" cy="12" r="6"/></g><circle cx="20" cy="20" r="6" fill="#b8650f"/></svg>{%- endcapture -%}
    {%- capture hz_rangoli -%}<svg class="hz-ic hz-rangoli" viewBox="0 0 40 40" width="22" height="22" aria-hidden="true"><g fill="none" stroke="#d9b25f" stroke-width="1.400"><path d="M20 3l5 12 12 5-12 5-5 12-5-12-12-5 12-5z"/><circle cx="20" cy="20" r="3.500" fill="#d9b25f"/><circle cx="20" cy="20" r="14" stroke-dasharray="1.500 3"/></g></svg>{%- endcapture -%}
    {%- capture hz_lotus -%}<svg class="hz-ic hz-lotus" viewBox="0 0 48 32" width="26" height="18" aria-hidden="true"><g fill="#e9c4cf" stroke="#d9b25f" stroke-width="1"><path d="M24 2c5 6 6 14 0 24-6-10-5-18 0-24z"/><path d="M12 8c7 2 11 9 12 18-8-2-13-8-12-18z"/><path d="M36 8c-7 2-11 9-12 18 8-2 13-8 12-18z"/></g><path d="M4 28h40" stroke="#d9b25f" stroke-width="1.500"/></svg>{%- endcapture -%}
    {%- capture hz_star -%}<svg class="hz-ic hz-star" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M12 1l2 8 8 3-8 3-2 8-2-8-8-3 8-3z" fill="#f1dba0"/></svg>{%- endcapture -%}
    {%- capture hz_group -%}
      <div class="hz-group">
        {{ hz_diya }}
        {%- for part in hz_parts -%}
          <span class="hz-txt">{{ part | escape }}</span>
          {%- cycle 'g': hz_lantern, hz_marigold, hz_lotus -%}
          {{ hz_rangoli }}{{ hz_diya }}{{ hz_star }}
        {%- endfor -%}
      </div>
    {%- endcapture -%}
    <div class="header__haiku" data-header-haiku role="note" aria-label="{{ section.settings.haiku | escape }}">
      <div class="hz-track" aria-hidden="true">{{ hz_group }}{{ hz_group }}{{ hz_group }}{{ hz_group }}</div>
    </div>
  {%- endif -%}
  <div class="header__bar">
    <button type="button" class="header__burger" data-mobile-nav-open aria-label="{{ 'accessibility.menu' | t }}">
      <span></span><span></span><span></span>
    </button>

    <a href="{{ routes.root_url }}" class="header__logo">
      {%- if settings.logo != blank -%}
        <img src="{{ settings.logo | image_url: width: 400 }}" alt="{{ shop.name | escape }}"
             width="{{ settings.logo.width }}" height="{{ settings.logo.height }}"
             style="--logo-h:{{ settings.logo_height }}px">
      {%- else -%}
        {%- comment -%} Bundled brand mark — the real Silver Play monogram, ported from the Next.js source. Used until a merchant uploads their own logo under Theme settings > Logo. {%- endcomment -%}
        <img src="{{ 'logo-mark.png' | asset_url }}" alt="{{ shop.name | escape }}" width="567" height="567"
             style="--logo-h:{{ settings.logo_height }}px">
      {%- endif -%}
      <span class="header__logo-label">Home</span>
    </a>

    <nav class="header__nav" role="navigation" aria-label="Primary">
      {%- for link in menu.links -%}
        <div class="header__navitem">
          <a href="{{ link.url }}" class="header__link">{{ link.title }}</a>

          {%- assign link_title_lower = link.title | downcase -%}
          {%- if link_title_lower == mega_handle and section.blocks.size > 0 -%}
            {% render 'mega-nav', section: section, link: link %}
          {%- elsif link.links.size > 0 -%}
            <div class="header__dropdown">
              {%- for child in link.links -%}
                <a href="{{ child.url }}">{{ child.title }}</a>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </nav>

    <div class="header__actions">
      <a href="{{ routes.search_url }}" class="header__icon" data-search-open aria-label="{{ 'accessibility.search' | t }}">
        {% render 'icon', name: 'search' %}
      </a>
      {%- if section.settings.show_wishlist -%}
        <a href="{{ section.settings.wishlist_url | default: '/pages/wishlist' }}" class="header__icon header__icon--sm" aria-label="{{ 'accessibility.wishlist' | t }}">
          {% render 'icon', name: 'heart' %}
        </a>
      {%- endif -%}
      <a href="{{ routes.account_url }}" class="header__icon header__icon--sm" aria-label="{{ 'accessibility.account' | t }}">
        {% render 'icon', name: 'account' %}
      </a>
      <a href="{{ routes.cart_url }}" class="header__icon" data-cart-open aria-label="{{ 'accessibility.cart' | t }}">
        {% render 'icon', name: 'bag' %}
        <span class="header__badge" data-cart-count>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

<div class="mobile-nav" data-mobile-nav>
  <button type="button" class="mobile-nav__close" data-mobile-nav-close>{{ 'accessibility.close' | t }}</button>
  <nav class="mobile-nav__list" role="navigation" aria-label="Mobile">
    <ul>
      {%- for link in mobile_menu.links -%}
        <li class="mobile-nav__item"{% if link.links.size > 0 %} data-accordion-row{% endif %}>
          <div class="mobile-nav__row">
            <a href="{{ link.url }}" class="mobile-nav__link">{{ link.title }}</a>
            {%- if link.links.size > 0 -%}
              <button type="button" class="mobile-nav__toggle" data-accordion-btn aria-expanded="false" aria-label="{{ link.title | escape }} submenu">
                <span class="mobile-nav__plus" aria-hidden="true"></span>
              </button>
            {%- endif -%}
          </div>
          {%- if link.links.size > 0 -%}
            <div class="mobile-nav__panel">
              <ul class="mobile-nav__sub">
                {%- for child in link.links -%}
                  <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </nav>
</div>

{%- comment -%}
  Mobile action bar. Below 1024px the header's icon cluster is hidden and these
  take over, thumb-reachable at the bottom of the screen. The cart badge here
  carries data-cart-count too -- theme.js updates every match, so both stay in
  sync. Each control reuses the same hooks as the header (data-search-open,
  data-cart-open), so behaviour is identical, not a parallel implementation.
{%- endcomment -%}
<nav class="mbar" data-mobile-bar aria-label="{{ 'accessibility.menu' | t }}">
  <a href="{{ section.settings.offer_url | default: '/pages/festive-season-offer' }}" class="mbar__item">
    {% render 'icon', name: 'gift' %}
    <span>{{ section.settings.offer_label | default: 'Offers' }}</span>
  </a>
  {%- if section.settings.show_wishlist -%}
    <a href="{{ section.settings.wishlist_url | default: '/pages/wishlist' }}" class="mbar__item">
      {% render 'icon', name: 'heart' %}
      <span>{{ 'accessibility.wishlist' | t }}</span>
    </a>
  {%- endif -%}
  <a href="{{ routes.search_url }}" class="mbar__item" data-search-open>
    {% render 'icon', name: 'search' %}
    <span>{{ 'general.search.search' | t }}</span>
  </a>
  <a href="{{ routes.cart_url }}" class="mbar__item" data-cart-open>
    <span class="mbar__ico">
      {% render 'icon', name: 'bag' %}
      <span class="mbar__badge" data-cart-count>{{ cart.item_count }}</span>
    </span>
    <span>{{ 'cart.general.title' | t }}</span>
  </a>
</nav>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "header", "content": "Haiku line (optional)" },
    { "type": "text", "id": "haiku", "label": "Haiku", "default": "Handmade silver glows / gemstones hold the festive light / heritage, worn home",
      "info": "Shown in a thin line at the top of the header. Separate the three lines with ' / '. It hides when the visitor scrolls and the header turns into the round pill. Leave empty to hide it." },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "link_list", "id": "mobile_menu", "label": "Mobile menu",
      "info": "Used for the mobile drawer (the ☰ icon below 1024px). Leave blank to reuse the menu above." },
    { "type": "text", "id": "mega_menu_trigger", "label": "Menu item that opens the mega nav", "default": "Collections",
      "info": "Must match a top-level menu item title exactly (case-insensitive)." },
    { "type": "checkbox", "id": "show_wishlist", "label": "Show wishlist icon", "default": true },
    { "type": "url", "id": "offer_url", "label": "Offers link (mobile bar)" },
    { "type": "text", "id": "offer_label", "label": "Offers label (mobile bar)", "default": "Offers" },
    { "type": "url", "id": "wishlist_url", "label": "Wishlist link" },
    { "type": "header", "content": "Mega nav — panel copy" },
    { "type": "text", "id": "mega_eyebrow", "label": "Eyebrow", "default": "Our Jewellery" },
    { "type": "url", "id": "mega_view_all", "label": "\"View all\" link" },
    { "type": "text", "id": "mega_view_all_label", "label": "\"View all\" label", "default": "View All Products" },
    { "type": "header", "content": "Mega nav — featured tiles" },
    { "type": "collection_list", "id": "mega_featured", "label": "Featured collections", "limit": 4,
      "info": "Each tile uses the collection's own image, falling back to its first product." },
    { "type": "header", "content": "Mega nav — promo panel" },
    { "type": "text", "id": "promo_eyebrow", "label": "Promo eyebrow", "default": "Handcrafted in Jaipur" },
    { "type": "text", "id": "promo_heading", "label": "Promo heading", "default": "Discover The Bestsellers" },
    { "type": "video", "id": "promo_video", "label": "Promo video" },
    { "type": "image_picker", "id": "promo_poster", "label": "Promo poster image" },
    { "type": "url", "id": "promo_cta_url", "label": "Promo CTA link" },
    { "type": "text", "id": "promo_cta_label", "label": "Promo CTA label", "default": "Discover Now" }
  ],
  "blocks": [
    {
      "type": "link_group",
      "name": "Mega nav link column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Earrings" },
        { "type": "link_list", "id": "menu", "label": "Links" }
      ]
    }
  ],
  "default": {
    "settings": {
      "menu": "main-menu",
      "mega_menu_trigger": "Collections",
      "show_wishlist": true,
      "mega_eyebrow": "Our Jewellery",
      "mega_view_all_label": "View All Products",
      "promo_eyebrow": "Handcrafted in Jaipur",
      "promo_heading": "Discover The Bestsellers",
      "promo_cta_label": "Discover Now"
    },
    "blocks": [
      { "type": "link_group", "settings": { "heading": "Earrings" } },
      { "type": "link_group", "settings": { "heading": "Pendants" } },
      { "type": "link_group", "settings": { "heading": "Festive" } }
    ]
  }
}
{% endschema %}
