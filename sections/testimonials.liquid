{%- comment -%}
  "Notes We Keep" — parchment cards pegged to a sagging rope, each swaying on
  its own clock. Clicking one opens the shared note modal (theme.js -> initNotes).
  Sag per card is computed in Liquid with the same 4t(1-t) curve as the source.
{%- endcomment -%}
{%- liquid
  assign n = section.blocks.size
  assign max_sag = 34
-%}
<section class="line on-dark" style="padding-block: 7rem">
  <div class="wrap wrap--tight text-center">
    <p class="eyebrow" style="color:#c9a879" data-reveal>{{ section.settings.eyebrow }}</p>
    <h2 class="h-sec mt-4" data-split data-reveal="none">{{ section.settings.heading }}</h2>
  </div>

  <div style="position:relative;margin-top:6rem;width:100%;overflow-x:auto">
    <svg class="line__rope" viewBox="0 0 100 64" preserveAspectRatio="none" aria-hidden="true">
      <path d="M 0,20 Q 50,54 100,20" fill="none" stroke="#4a3618" stroke-width="3.2" stroke-linecap="round" vector-effect="non-scaling-stroke"/>
      <path d="M 0,20 Q 50,54 100,20" fill="none" stroke="#a4813f" stroke-width="1.4" stroke-dasharray="2.2 2.6" stroke-linecap="round" opacity="0.85" vector-effect="non-scaling-stroke"/>
    </svg>

    <div class="line__row">
      {%- for block in section.blocks -%}
        {%- liquid
          assign i = forloop.index0
          assign denom = n | minus: 1
          if denom < 1
            assign denom = 1
          endif
          # symmetric dip: 4t(1-t), 0 at the ends, 1 at the centre
          assign f = i | times: 1.0 | divided_by: denom
          assign one_minus = 1.0 | minus: f
          assign sag_px = f | times: one_minus | times: 4 | times: max_sag | round
          assign thread = sag_px | plus: 22
          assign knot = thread | plus: 4
          assign mod3 = i | modulo: 3
          assign mod4 = i | modulo: 4
          assign mod2 = i | modulo: 2
          assign dur = mod3 | times: 0.7 | plus: 4.6
          assign delay = mod4 | times: 0.35
          assign amp = mod2 | times: 0.8 | plus: 2.4
          assign tilt = -1.1
          if mod2 == 1
            assign tilt = 1.3
          endif
        -%}
        <div class="line__peg" style="margin-top: {{ sag_px }}px" {{ block.shopify_attributes }}>
          <span class="line__thread" style="top: -{{ thread }}px; height: {{ thread }}px" aria-hidden="true"></span>
          <span class="line__knot" style="top: -{{ knot }}px" aria-hidden="true"></span>
          <div class="line__swing" style="--dur: {{ dur }}s; --delay: {{ delay }}s; --amp: {{ amp }}">
            <button type="button" class="line__card"
                    data-note-open
                    data-note-quote="{{ block.settings.quote | escape }}"
                    data-note-by="{{ block.settings.attribution | escape }}"
                    aria-label="Read the full note: {{ block.settings.attribution | escape }}">
              <div class="note" style="transform: rotate({{ tilt }}deg)">
                <div class="note__inner">
                  <span class="note__foxing-a" aria-hidden="true"></span>
                  <span class="note__foxing-b" aria-hidden="true"></span>
                  <span class="note__corner" style="top:.5rem;left:.5rem" aria-hidden="true">&#10022;</span>
                  <span class="note__corner" style="top:.5rem;right:.5rem" aria-hidden="true">&#10022;</span>
                  <span class="note__corner" style="bottom:.5rem;left:.5rem" aria-hidden="true">&#10022;</span>
                  <span class="note__corner" style="bottom:.5rem;right:.5rem" aria-hidden="true">&#10022;</span>
                  <div class="note__body">
                    <span class="note__mark" aria-hidden="true">&#10087;</span>
                    <p class="note__quote">&ldquo;{{ block.settings.quote }}&rdquo;</p>
                    <p class="note__by">{{ block.settings.attribution }}</p>
                  </div>
                </div>
              </div>
            </button>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Notes we keep",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "In Her Own Words" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Notes We Keep" }
  ],
  "blocks": [
    {
      "type": "note",
      "name": "Note",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "attribution", "label": "Attribution" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Notes we keep",
      "blocks": [
        { "type": "note", "settings": { "quote": "Handcrafted sterling silver jewellery, forged for the woman who wears her story.", "attribution": "Silver Play" } },
        { "type": "note", "settings": { "quote": "Every piece is made with a belief that you deserve beautiful things around you.", "attribution": "Dalljiet Kaur, Founder" } },
        { "type": "note", "settings": { "quote": "A single pendant can pass through five pairs of hands before it reaches yours.", "attribution": "Inside the Jaipur Atelier" } },
        { "type": "note", "settings": { "quote": "Jewellery can be more than beautiful — it can be intentional.", "attribution": "How to Wear Meaning" } },
        { "type": "note", "settings": { "quote": "With proper care, your Silver Play pieces will last a lifetime.", "attribution": "Jewellery Care" } },
        { "type": "note", "settings": { "quote": "Handcrafted sterling silver jewellery, forged in the ancient tradition.", "attribution": "Silver Play" } }
      ]
    }
  ]
}
{% endschema %}
