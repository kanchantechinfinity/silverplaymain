{%- comment -%}
  "The Archive Silver Treasure" — a fanned collage of flip cards.
  Front: the collection's own image + its Devanagari name (collection metafield
  custom.deva_title). Back: the collection's first product shot + a shop link.
{%- endcomment -%}
<section class="heritage-sec sec">
  {% render 'heritage-bg',
    image: section.settings.bg_image,
    fallback: 'heritage-mandala-corner.png',
    wash: section.settings.wash %}

  <div class="wrap archive__layout">
    <div class="archive__text">
      <p class="eyebrow" data-reveal>{{ section.settings.eyebrow }}</p>
      <h2 data-reveal="none">
        {%- assign words = section.settings.heading | split: ' ' -%}
        {%- for w in words -%}
          <span class="split__mask" style="display:block">
            <span class="split__unit" style="transition-delay: {{ forloop.index0 | times: 0.08 }}s">{{ w }}</span>
          </span>
        {%- endfor -%}
      </h2>
      {%- if section.settings.cta_label != blank -%}
        <div data-reveal data-delay="0.4">
          <a href="{{ section.settings.cta_url | default: routes.collections_url }}" class="btn btn--ink mt-8">
            {{ section.settings.cta_label }} <span class="btn__arrow">&rarr;</span>
          </a>
        </div>
      {%- endif -%}
    </div>

    <div class="collage">
      {%- for block in section.blocks -%}
        {%- liquid
          assign col = collections[block.settings.collection]
          assign front = block.settings.image
          assign front_asset = blank
          if front == blank
            case forloop.index
              when 1
                assign front_asset = 'archive-tile-1-heritage.png'
              when 2
                assign front_asset = 'archive-tile-2-craftsmanship.png'
              when 3
                assign front_asset = 'archive-tile-3-gemstone.png'
              when 4
                assign front_asset = 'archive-tile-4-elegance.png'
              when 5
                assign front_asset = 'archive-tile-5-regal.png'
              when 6
                assign front_asset = 'archive-tile-6-lunarglow.png'
            endcase
          endif
          if front == blank and front_asset == blank
            assign front = col.image
          endif
          if front == blank and front_asset == blank
            assign front = col.products.first.featured_media.preview_image
          endif
          assign back = col.products.first.featured_media.preview_image
          assign deva = block.settings.devanagari | default: col.metafields.custom.deva_title.value
        -%}
        <div class="collage__slot" {{ block.shopify_attributes }}>
          <div class="flipcard" role="button" tabindex="0"
               aria-label="{{ col.title | default: block.settings.title | escape }} — flip to see a piece from this collection">
            <div class="flipcard__inner">
              <div class="flipcard__face flipcard__face--front">
                {%- if front_asset != blank -%}
                  <img src="{{ front_asset | asset_url }}" alt="{{ col.title | escape }}" loading="lazy" width="800" height="1200">
                {%- elsif front -%}
                  <img src="{{ front | image_url: width: 800 }}" alt="{{ col.title | escape }}" loading="lazy" width="800" height="1000">
                {%- else -%}
                  <img src="{{ 'archive-balcony.jpg' | asset_url }}" alt="" loading="lazy" width="1600" height="1067">
                {%- endif -%}
                <span class="flipcard__scrim" aria-hidden="true"></span>
                <div class="flipcard__body">
                  {%- if deva != blank -%}<p class="flipcard__deva">{{ deva }}</p>{%- endif -%}
                  <p class="flipcard__name">{{ block.settings.title | default: col.title }}</p>
                </div>
              </div>
              <div class="flipcard__face flipcard__face--back">
                {%- if back -%}
                  <img src="{{ back | image_url: width: 800 }}" alt="" loading="lazy" width="800" height="1000">
                {%- endif -%}
                <span class="flipcard__scrim" aria-hidden="true"></span>
                <div class="flipcard__body">
                  <p class="flipcard__name">{{ block.settings.title | default: col.title }}</p>
                  <a href="{{ col.url | default: routes.collections_url }}" class="flipcard__btn">
                    {{ section.settings.card_cta }} <span aria-hidden="true">&rarr;</span>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Archive Silver Treasure",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Heritage" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Archive Silver Treasure", "info": "Each word animates in on its own line." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop The Collection" },
    { "type": "url", "id": "cta_url", "label": "Button link" },
    { "type": "text", "id": "card_cta", "label": "Card link label", "default": "Shop The Collection" },
    { "type": "image_picker", "id": "bg_image", "label": "Background photo" },
    { "type": "color_background", "id": "wash", "label": "Background wash", "default": "rgba(242,232,208,0.75)" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Collection tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "text", "id": "devanagari", "label": "Devanagari name",
          "info": "Leave blank to use the collection's custom.deva_title metafield." },
        { "type": "image_picker", "id": "image", "label": "Front image override" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Archive Silver Treasure",
      "blocks": [
        { "type": "tile", "settings": { "title": "Heritage", "devanagari": "विरासत" } },
        { "type": "tile", "settings": { "title": "Craftsmanship", "devanagari": "कारीगरी" } },
        { "type": "tile", "settings": { "title": "Gemstone Heritage", "devanagari": "रत्न विरासत" } },
        { "type": "tile", "settings": { "title": "Elegance", "devanagari": "नज़ाकत" } },
        { "type": "tile", "settings": { "title": "Regal", "devanagari": "शाही" } },
        { "type": "tile", "settings": { "title": "Lunar Glow", "devanagari": "चांदनी" } }
      ]
    }
  ]
}
{% endschema %}
