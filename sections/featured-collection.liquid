{%- comment -%}
  Generic photo-backed product row (used for Best Sellers, and reusable for any
  other 4-up editorial grid). Dark or pale tone via settings.
{%- endcomment -%}
{%- liquid
  assign col = collections[section.settings.collection]
  assign dark = section.settings.color_scheme
-%}
<section class="heritage-sec sec {% if dark == 'dark' %}on-dark{% endif %}" style="background: {{ section.settings.bg_color }}">
  {% render 'heritage-bg',
    image: section.settings.bg_image,
    fallback: 'seen-ghat-vista.jpg',
    wash: section.settings.wash %}

  <div class="wrap">
    <div class="section-head">
      {% render 'heading',
        eyebrow: section.settings.eyebrow,
        heading: section.settings.heading,
        lede: section.settings.lede %}
    </div>

    <div class="grid-products mt-14" data-stagger="0.08">
      {%- for product in col.products limit: section.settings.count -%}
        {% render 'product-card', product: product, style: section.settings.card_style %}
      {%- else -%}
        {%- for i in (1..4) -%}
          <div class="card"><div class="card__frame"><div class="card__media"><img src="{{ 'seen-ghat-vista.jpg' | asset_url }}" alt="" class="card__img" loading="lazy" width="1600" height="1067"></div></div>
            <div class="card__body"><h3 class="card__title">{{ 'onboarding.product_title' | t }}</h3></div></div>
        {%- endfor -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.cta_label != blank -%}
      <div class="center-cta" data-reveal data-delay="0.1">
        <a href="{{ section.settings.cta_url | default: col.url | default: routes.all_products_collection_url }}"
           class="btn {% if dark == 'dark' %}btn--bone{% else %}btn--ink{% endif %}">
          {{ section.settings.cta_label }} <span class="btn__arrow">&rarr;</span>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection row",
  "tag": "section",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "As Seen & Loved" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best Sellers" },
    { "type": "textarea", "id": "lede", "label": "Intro", "default": "The pieces Silver Play wearers keep coming back for — proven favourites, worn on repeat." },
    { "type": "range", "id": "count", "min": 4, "max": 12, "step": 4, "label": "Products shown", "default": 8 },
    { "type": "select", "id": "card_style", "label": "Card style", "default": "gilt",
      "options": [ { "value": "gilt", "label": "Gilt frame" }, { "value": "heritage", "label": "Heritage paper" } ] },
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "dark",
      "options": [ { "value": "dark", "label": "Dark" }, { "value": "light", "label": "Light" } ] },
    { "type": "color", "id": "bg_color", "label": "Background colour", "default": "#3a2b1c" },
    { "type": "image_picker", "id": "bg_image", "label": "Background photo" },
    { "type": "color_background", "id": "wash", "label": "Background wash", "default": "rgba(58,43,28,0.62)" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop Best Sellers" },
    { "type": "url", "id": "cta_url", "label": "Button link" }
  ],
  "presets": [{ "name": "Featured collection row" }]
}
{% endschema %}
