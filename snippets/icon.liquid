{%- comment -%}
  Inline SVG icon set — ported 1:1 from the Next.js source's inline paths.
  Usage: {% render 'icon', name: 'search', size: 21 %}
{%- endcomment -%}
{%- liquid
  assign s = size | default: 21
  assign sw = stroke | default: 1.5
-%}
{%- case name -%}
  {%- when 'search' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 23 23" fill="none" stroke="currentColor" stroke-width="{{ sw }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7.5"/><path d="m20.5 20.5-4.35-4.35"/></svg>
  {%- when 'heart' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="{{ fill | default: 'none' }}" stroke="currentColor" stroke-width="{{ sw }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20.5s-7.5-4.6-9.9-9.3C.6 8 1.8 4.3 5.2 3.4c2-.5 4 .3 5.2 2 .5.7 1 1.4 1.6 2.1.6-.7 1.1-1.4 1.6-2.1 1.2-1.7 3.2-2.5 5.2-2 3.4.9 4.6 4.6 3.1 7.8-2.4 4.7-9.9 9.3-9.9 9.3Z"/></svg>
  {%- when 'account' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 23 23" fill="none" stroke="currentColor" stroke-width="{{ sw }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20.5c1.4-4 4.4-6 8-6s6.6 2 8 6"/></svg>
  {%- when 'bag' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 23 23" fill="none" stroke="currentColor" stroke-width="{{ sw }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.5 8.5h11l1 12.5h-13l1-12.5Z"/><path d="M9 8.5v-2a3 3 0 0 1 6 0v2"/></svg>
  {%- when 'eye' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.8-7 10-7 10 7 10 7-3.8 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
  {%- when 'close' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
  {%- when 'arrow-out' -%}
    <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 14 14 6"/><path d="M7.5 6H14v6.5"/></svg>
  {%- when 'instagram' -%}
    <svg width="{{ s | default: 16 }}" height="{{ s | default: 16 }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="2.5" y="2.5" width="19" height="19" rx="5.5"/><circle cx="12" cy="12" r="4.3"/><circle cx="17.4" cy="6.6" r="0.9" fill="currentColor" stroke="none"/></svg>
  {%- when 'comment' -%}
    <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.5 2 2 5.8 2 10.5c0 2.6 1.4 4.9 3.6 6.5-.1 1-.5 2.6-1.4 3.9 1.6-.2 3.3-.9 4.6-1.8 1 .3 2.1.4 3.2.4 5.5 0 10-3.8 10-8.5S17.5 2 12 2Z"/></svg>
  {%- when 'play' -%}
    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7Z"/></svg>
  {%- when 'cube' -%}
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12c0-3 4-5 9-5s9 2 9 5-4 5-9 5-9-2-9-5Z"/><ellipse cx="12" cy="12" rx="9" ry="3.2" transform="rotate(18 12 12)"/></svg>
  {%- when 'shield' -%}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v6c0 4.5-3 8-7 9-4-1-7-4.5-7-9V6l7-3Z"/><path d="M9 12l2 2 4-4"/></svg>
  {%- when 'sparkle' -%}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l2.5 5.5L20 11l-5.5 2.5L12 19l-2.5-5.5L4 11l5.5-2.5L12 3Z"/></svg>
  {%- when 'gift' -%}
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12v7a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-7"/><path d="M22 7H2v5h20V7Z"/><path d="M12 22V7"/><path d="M12 7c-1.8 0-5-1-5-3.2C7 2 8.2 1 9.5 1 11.5 1 12 4 12 7Z"/><path d="M12 7c1.8 0 5-1 5-3.2C17 2 15.8 1 14.5 1 12.5 1 12 4 12 7Z"/></svg>
  {%- when 'certificate' -%}
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M7 9h6M7 13h4"/><circle cx="17" cy="14" r="2.4"/></svg>
  {%- when 'pouch' -%}
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9V7a6 6 0 0 1 12 0v2M4 9h16l-1.2 11.2a2 2 0 0 1-2 1.8H7.2a2 2 0 0 1-2-1.8L4 9Z"/></svg>
  {%- when 'cloth' -%}
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h11l3 3v13H5V4Z"/><path d="M16 4v3h3"/></svg>
  {%- when 'gem' -%}
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l2.5 5.5L20 11l-5.5 2.5L12 19l-2.5-5.5L4 11l5.5-2.5L12 3Z"/></svg>
  {%- when 'corner-mark' -%}
    <svg aria-hidden="true" viewBox="0 0 32 32" class="{{ class }}"><g fill="none" stroke="#8a6a2e" stroke-width="1.1" stroke-linecap="round"><path d="M1 24V10C1 5 5 1 10 1h14"/><path d="M9 10c3.2-1.2 6 0 7.6 2.8-3.1 1.4-6-.3-7.6-2.8Z"/><circle cx="7.5" cy="7.5" r="1.1" fill="#8a6a2e" stroke="none"/></g></svg>
  {%- when 'paisley' -%}
    <svg aria-hidden="true" viewBox="0 0 100 100" class="{{ class }}"><g fill="none" stroke="#6b5326" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M50 14c22 6 32 26 24 46-6 15-22 24-37 20-12-4-18-17-12-27 4-8 15-11 21-4 5 6 2 15-6 17"/><path d="M53 30c11 5 16 18 11 29-3 8-11 13-18 11"/><circle cx="47" cy="20" r="1.8" fill="#6b5326" stroke="none"/></g></svg>
  {%- when 'monument' -%}
    <svg aria-hidden="true" viewBox="0 0 200 400" class="{{ class }}"><g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M18 398h108M27 388h90M36 378h72"/><path d="M48 378v-24h48v24"/><path d="M60 354V142M84 354V142"/><path d="M55 318h34M55 258h34M55 198h34"/><path d="M51 142h42M55 142v-10h34v10"/><path d="M59 132C59 96 72 63 72 40 72 63 85 96 85 132Z"/><path d="M62 120C62 92 72 67 72 49 72 67 82 92 82 120Z"/><path d="M72 40V17"/><circle cx="72" cy="13" r="4"/><path d="M14 397C4 360 30 328 13 292 -4 256 26 224 8 188 -10 152 22 118 10 84 -2 50 28 30 20 4"/><path d="M16 336c8-2 14 4 14 12-8 2-14-4-14-12Z"/><path d="M12 236c-8-2-14 4-14 12 8 2 14-4 14-12Z"/><path d="M10 146c8-2 14 4 14 12-8 2-14-4-14-12Z"/></g></svg>
{%- endcase -%}
