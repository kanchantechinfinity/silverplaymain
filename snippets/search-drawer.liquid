{%- comment -%}
  Search drawer. Same shell and mechanics as the cart drawer: fixed overlay,
  scrim, right-hand panel that slides in on .is-open. Results are fetched from
  Shopify's predictive endpoint and rendered by initSearchDrawer() in theme.js.

  Progressive enhancement: the header trigger keeps its href to routes.search_url
  and the form posts there, so the full /search page still works without JS.
{%- endcomment -%}
<div class="search-drawer" data-search-drawer aria-hidden="true">
  <div class="search-drawer__scrim" data-search-close></div>
  <aside class="search-drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'general.search.search' | t }}">
    <div class="cart-drawer__head">
      <p class="eyebrow">{{ 'general.search.search' | t }}</p>
      <button type="button" class="round-btn round-btn--sm" data-search-close aria-label="{{ 'accessibility.close' | t }}">
        {% render 'icon', name: 'close', size: 16 %}
      </button>
    </div>

    <form action="{{ routes.search_url }}" method="get" role="search" class="search-drawer__form">
      <input type="search" name="q" class="field field--pill" data-search-input
             placeholder="{{ 'general.search.placeholder' | t }}"
             aria-label="{{ 'general.search.search' | t }}"
             autocomplete="off" autocorrect="off" spellcheck="false">
      <input type="hidden" name="options[prefix]" value="last">
    </form>

    <div class="search-drawer__body" data-search-results aria-live="polite">
      <p class="search-drawer__hint">{{ 'general.search.placeholder' | t }}</p>
    </div>

    <div class="cart-drawer__foot" data-search-foot hidden>
      <a href="{{ routes.search_url }}" class="btn btn--ink" data-search-all style="width:100%;justify-content:center">
        {{ 'general.search.search' | t }} <span class="btn__arrow">&rarr;</span>
      </a>
    </div>
  </aside>
</div>
