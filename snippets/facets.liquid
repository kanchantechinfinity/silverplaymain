{%- comment -%}
  Storefront filter panel, driven by Shopify's native filtering (Search &
  Discovery). Replaces the source's hand-rolled type/vibe/price filters:
  "Category" and "Shop by Vibe" become real product-type / collection /
  tag filters the merchant configures in the admin.
  Params: results (collection or search object), id_suffix
{%- endcomment -%}
<form class="filters" data-filter-form method="get" action="{{ results_url }}">
  {%- if results_terms != blank -%}<input type="hidden" name="q" value="{{ results_terms | escape }}">{%- endif -%}
  {%- if sort_by != blank -%}<input type="hidden" name="sort_by" value="{{ sort_by }}">{%- endif -%}

  <p class="eyebrow" style="margin-bottom:1.5rem;color:var(--sp-gold-mid)">{{ 'products.facets.filter_and_sort' | t }}</p>

  {%- for filter in results.filters -%}
    <div class="filters__group">
      {%- case filter.type -%}
        {%- when 'price_range' -%}
          {%- comment -%}
            filter.range_min/range_max and filter.min_value.value/max_value.value
            all come back in the shop's smallest currency unit (e.g. paise for
            INR — 3499900 for ₹34,999), same as any other Shopify money value.
            The old code fed that raw number straight into the <input> as its
            min/max/value AND as the submitted filter.v.price.gte/lte param —
            but that querystring param is read back by Shopify as a plain
            decimal amount, not paise, so "up to ₹5,000" was actually being
            submitted (and applied) as "up to ₹5,00,000". Divide by 100 for
            everything the slider itself uses/submits; keep the un-divided
            (cents) figure only for the money_without_trailing_zeros display.
          {%- endcomment -%}
          {%- liquid
            assign range_min_cents = filter.range_min | default: 0
            assign range_max_cents = filter.range_max
            assign min_cents = filter.min_value.value | default: range_min_cents
            assign max_cents = filter.max_value.value | default: range_max_cents
            assign range_min = range_min_cents | divided_by: 100
            assign range_max = range_max_cents | divided_by: 100
            assign min_amt = min_cents | divided_by: 100
            assign max_amt = max_cents | divided_by: 100
          -%}
          <p class="filters__label">{{ 'products.facets.price_up_to' | t }}</p>
          <div class="price-labels">
            <span data-range-output="min">{{ min_cents | money_without_trailing_zeros }}</span>
            <span data-range-output="max">{{ max_cents | money_without_trailing_zeros }}</span>
          </div>
          <div class="price-slider" data-price-slider>
            <div class="price-slider__track"></div>
            <div class="price-slider__fill" data-price-fill></div>
            <input type="range" class="price-slider__input"
                   name="{{ filter.min_value.param_name }}"
                   min="{{ range_min }}" max="{{ range_max }}" step="1"
                   value="{{ min_amt }}"
                   data-range-role="min"
                   aria-label="{{ 'products.facets.price_min' | t }}">
            <input type="range" class="price-slider__input"
                   name="{{ filter.max_value.param_name }}"
                   min="{{ range_min }}" max="{{ range_max }}" step="1"
                   value="{{ max_amt }}"
                   data-range-role="max"
                   aria-label="{{ 'products.facets.price_max' | t }}">
          </div>

        {%- else -%}
          <p class="filters__label">{{ filter.label }}</p>
          {%- comment -%}
            Values that only differ by case/typo (e.g. "Emerald Green",
            "emereld green", "Green") collapse into one checkbox. The first
            member's name/value is the checkbox itself; the rest ride along in
            data-also and are added as hidden inputs on submit (theme.js).
          {%- endcomment -%}
          {%- assign is_color = false -%}
          {%- assign flabel = filter.label | downcase -%}
          {%- if flabel contains 'colo' -%}{%- assign is_color = true -%}{%- endif -%}
          <div class="filters__list">
            {%- assign seen = '' -%}
            {%- for value in filter.values -%}
              {%- assign key = value.label | strip | downcase -%}
              {%- if is_color and key == 'emereld green' or is_color and key == 'green' or is_color and key contains '(emerald green)' -%}
                {%- assign key = 'emerald green' -%}
              {%- endif -%}
              {%- assign marker = '|' | append: key | append: '|' -%}
              {%- unless seen contains marker -%}
                {%- assign seen = seen | append: marker -%}
                {%- assign total = 0 -%}
                {%- assign any_active = false -%}
                {%- assign extras = '' -%}
                {%- for v2 in filter.values -%}
                  {%- assign k2 = v2.label | strip | downcase -%}
                  {%- if is_color and k2 == 'emereld green' or is_color and k2 == 'green' or is_color and k2 contains '(emerald green)' -%}
                    {%- assign k2 = 'emerald green' -%}
                  {%- endif -%}
                  {%- if k2 == key -%}
                    {%- assign total = total | plus: v2.count -%}
                    {%- if v2.active -%}{%- assign any_active = true -%}{%- endif -%}
                    {%- unless v2.value == value.value -%}
                      {%- assign extras = extras | append: v2.param_name | append: '=' | append: v2.value | append: '~~' -%}
                    {%- endunless -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- assign shown = value.label -%}
                {%- if key == 'emerald green' -%}{%- assign shown = 'Emerald Green' -%}{%- endif -%}
                <label class="check">
                  <span class="check__box">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}"
                           {% if extras != blank %}data-also="{{ extras | escape }}"{% endif %}
                           {% if any_active %}checked{% endif %} {% if total == 0 and any_active == false %}disabled{% endif %}>
                    <span class="check__fill" aria-hidden="true"></span>
                    <svg class="check__tick" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.2 6.2 11.4 13 4.6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </span>
                  {{ shown }} ({{ total }})
                </label>
              {%- endunless -%}
            {%- endfor -%}
          </div>
      {%- endcase -%}
    </div>

    {%- unless forloop.last -%}
      <div class="filters__divider" aria-hidden="true">
        <span></span><span class="filters__diamond"></span><span></span>
      </div>
    {%- endunless -%}
  {%- else -%}
    <p class="lede" style="color:rgba(242,232,208,.6);font-size:.85rem">
      Install and configure Shopify's free Search &amp; Discovery app to expose filters here.
    </p>
  {%- endfor -%}

  <noscript><button type="submit" class="btn btn--bone btn--block mt-6">{{ 'products.facets.apply' | t }}</button></noscript>
  <a href="{{ results_url }}" class="link-cta link-cta--bone mt-6">{{ 'products.facets.clear_all' | t }}</a>
</form>
