{%- comment -%}
  Cart offer banner. Its campaign block below is a copy of snippets/campaign-data.liquid (Shopify does not allow include inside a rendered snippet) -- keep the two in sync.

  Live campaign with a free-coin rule (Navratri: 2 coins above ₹15,000,
  Dhanteras: 2 coins above ₹12,000): shows progress and emits
  data-coins / data-coin-variant-id / data-coin-grams, which theme.js uses to
  fire the celebration and to auto-add the coin itself -- Shopify's
  automatic discount only makes the coin free once it is in the cart; it
  never adds it. Live campaign without a coin rule (Karwa Chauth): shows the
  campaign promise instead. Outside a live campaign: renders nothing.
{%- endcomment -%}
{%- liquid
  assign camp = ''
  assign camp_status = ''
  assign camp_name = ''
  assign camp_title = ''
  assign camp_tagline = ''
  assign camp_lede = ''
  assign camp_note = ''
  assign camp_dates = ''
  assign camp_start_s = 0
  assign camp_end_s = 0
  assign camp_cta_label = 'Shop The Offer'
  assign camp_collection = 'all-products'
  assign camp_tier1_amt = ''
  assign camp_tier1_gift = ''
  assign camp_tier2_amt = ''
  assign camp_tier2_gift = ''
  assign camp_tier3_amt = ''
  assign camp_tier3_gift = ''
  assign camp_coin_threshold = 0
  assign camp_coin_qty = 0
  assign camp_coin_grams = 2
  assign camp_coin_handle = 'lakshmi-silver-coin-in-gift-booklet'
  assign camp_end_label = ''
  assign camp_image = ''

  assign now_s = 'now' | date: '%s' | plus: 0

  assign nav_start = '2026-10-11 00:00:00 +0530' | date: '%s' | plus: 0
  assign nav_end = '2026-10-20 23:59:59 +0530' | date: '%s' | plus: 0
  assign kar_start = '2026-10-21 00:00:00 +0530' | date: '%s' | plus: 0
  assign kar_end = '2026-10-29 23:59:59 +0530' | date: '%s' | plus: 0
  assign dhan_start = '2026-10-30 00:00:00 +0530' | date: '%s' | plus: 0
  assign dhan_end = '2026-11-10 23:59:59 +0530' | date: '%s' | plus: 0
  assign lead_s = 432000

  assign nav_soon = nav_start | minus: lead_s

  if now_s >= nav_soon and now_s <= nav_end
    assign camp = 'navratri'
    assign camp_start_s = nav_start
    assign camp_end_s = nav_end
  elsif now_s > nav_end and now_s <= kar_end
    assign camp = 'karwa'
    assign camp_start_s = kar_start
    assign camp_end_s = kar_end
  elsif now_s > kar_end and now_s <= dhan_end
    assign camp = 'dhanteras'
    assign camp_start_s = dhan_start
    assign camp_end_s = dhan_end
  endif

  if camp != ''
    if now_s < camp_start_s
      assign camp_status = 'soon'
    else
      assign camp_status = 'live'
    endif
  endif

  if camp == 'navratri'
    assign camp_name = 'Navratri & Dussehra'
    assign camp_image = 'campaign-navratri.jpg'
    assign camp_title = 'Garba Ready'
    assign camp_tagline = 'Garba & statement style'
    assign camp_lede = 'Dress for the nine nights in silver that moves with you.'
    assign camp_dates = 'Oct 11 – Oct 20, 2026'
    assign camp_end_label = 'Ends midnight, Oct 20'
    assign camp_note = 'Offer valid Oct 11 – Oct 20, 2026. Not applicable on the Diwali Hamper or Shagun collection. Free coins are 99.9% pure silver and are added to your bag automatically. No code needed.'
    assign camp_collection = 'designer-statement-earrings'
    assign camp_cta_label = 'Shop Garba Statement Earrings'
    assign camp_tier1_amt = 'Orders ₹4,999 and above'
    assign camp_tier1_gift = 'Flat 10% off'
    assign camp_tier2_amt = 'Orders above ₹15,000'
    assign camp_tier2_gift = '2 Free Silver Coins (2g, 99.9%)'
    assign camp_tier3_amt = 'Buy 2 Designer Statement Earrings'
    assign camp_tier3_gift = 'Extra 10% off'
    assign camp_coin_threshold = 1500000
    assign camp_coin_qty = 2
  elsif camp == 'karwa'
    assign camp_name = 'Karwa Chauth'
    assign camp_title = 'Symbols of Love'
    assign camp_tagline = 'For the one you do it all for'
    assign camp_lede = 'Silver that says what words cannot, delivered in time for the moon.'
    assign camp_dates = 'Oct 21 – Oct 29, 2026'
    assign camp_end_label = 'Ends midnight, Oct 29'
    assign camp_note = 'Offer valid Oct 21 – Oct 29, 2026. Order by Oct 27 for delivery before Karwa Chauth.'
    assign camp_collection = 'pendants'
    assign camp_cta_label = 'Shop Symbols of Love'
    assign camp_tier1_amt = 'Mangalsutras, Pendants & Collections'
    assign camp_tier1_gift = 'Flat 10% off'
    assign camp_tier2_amt = 'Every order'
    assign camp_tier2_gift = 'Complimentary Premium Express Shipping'
    assign camp_tier3_amt = 'Order by Oct 27'
    assign camp_tier3_gift = 'Delivered before Karwa Chauth'
  elsif camp == 'dhanteras'
    assign camp_name = 'Dhanteras & Diwali'
    assign camp_title = 'Shubh Dhanteras'
    assign camp_tagline = 'Bring home prosperity'
    assign camp_lede = 'The most auspicious day to buy silver, with an offer to match.'
    assign camp_dates = 'Oct 30 – Nov 10, 2026'
    assign camp_end_label = 'Ends Nov 10 (covers Bhai Dooj)'
    assign camp_note = 'Offer valid Oct 30 – Nov 10, 2026. Dhanteras orders placed before Nov 3 are guaranteed delivery. Free coins are 99.9% pure silver, added to your bag automatically.'
    assign camp_collection = 'best-seller'
    assign camp_cta_label = 'Shop Dhanteras Silver'
    assign camp_tier1_amt = 'Site-wide'
    assign camp_tier1_gift = 'Flat 10% off'
    assign camp_tier2_amt = 'Or orders above ₹12,000'
    assign camp_tier2_gift = '2 Free Silver Coins (2g, 99.9%)'
    assign camp_tier3_amt = 'Order before Nov 3'
    assign camp_tier3_gift = 'Guaranteed Dhanteras delivery'
    assign camp_coin_threshold = 1200000
    assign camp_coin_qty = 2
  endif
-%}

{%- liquid
  assign coin_product = all_products[camp_coin_handle]
  assign coin_variant_id = coin_product.selected_or_first_available_variant.id
  assign coin_ok = false
  if camp_status == 'live' and camp_coin_qty > 0 and coin_product != blank
    assign coin_ok = true
  endif

  assign qualifying_total = cart.total_price
  for item in cart.items
    if item.product.handle == camp_coin_handle
      assign qualifying_total = qualifying_total | minus: item.original_line_price
    endif
  endfor

  assign coins = 0
  if coin_ok and qualifying_total > camp_coin_threshold
    assign coins = camp_coin_qty
  endif
  assign remaining_cents = camp_coin_threshold | minus: qualifying_total | plus: 100
  assign total_grams = coins | times: camp_coin_grams
-%}
{%- if camp_status == 'live' -%}
  {%- if coin_ok -%}
    <div class="coin-offer" data-coin-offer data-coins="{{ coins }}" data-coin-variant-id="{{ coin_variant_id }}" data-coin-grams="{{ camp_coin_grams }}">
      <span class="coin-offer__icon" aria-hidden="true">&#9679;</span>
      <div class="coin-offer__text">
        {%- if coins > 0 -%}
          <p class="coin-offer__headline">You've unlocked {{ coins }} free silver coins &mdash; {{ total_grams }}g, 99.9% purity!</p>
          <p class="coin-offer__sub">{{ camp_name }} offer applied. Added to your bag automatically.</p>
        {%- else -%}
          <p class="coin-offer__headline">{{ camp_tier2_gift }} on orders above {{ camp_coin_threshold | money_without_trailing_zeros }}</p>
          <p class="coin-offer__sub">Add {{ remaining_cents | money_without_trailing_zeros }} more to unlock {{ camp_name }}'s free coins.</p>
        {%- endif -%}
      </div>
    </div>
  {%- else -%}
    <div class="coin-offer">
      <span class="coin-offer__icon" aria-hidden="true">&#9679;</span>
      <div class="coin-offer__text">
        <p class="coin-offer__headline">{{ camp_title }}: {{ camp_tier1_gift }}</p>
        <p class="coin-offer__sub">{{ camp_tier1_amt }} &middot; {{ camp_tier2_gift }}</p>
      </div>
    </div>
  {%- endif -%}
{%- endif -%}
