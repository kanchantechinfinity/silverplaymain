{%- assign liner = liner_raw | strip | split: '@@@' -%}
{%- assign faq_items = faq_raw | strip | split: '|||' -%}
{%- if liner_raw != blank or faq_raw != blank -%}
<section class="sec on-dark">
  <div class="wrap">
    {%- if liner_raw != blank -%}
      <div class="text-center" style="max-width:52rem;margin-inline:auto{% if faq_raw != blank %};margin-bottom:3.5rem{% endif %}">
        <h2 class="h-sec--sm" data-reveal>{{ liner[0] | strip | escape }}</h2>
        <p class="mt-3" data-reveal style="line-height:1.7;opacity:.9">{{ liner[1] | strip | escape }}</p>
      </div>
    {%- endif -%}
    {%- if faq_raw != blank -%}
    <div class="text-center">
      <p class="eyebrow" data-reveal>Good To Know</p>
      <h2 class="h-sec--sm mt-3" data-split data-reveal="none">Frequently Asked</h2>
    </div>

    <div class="faq__list">
      {%- for item in faq_items -%}
        {%- assign qa = item | split: '@@@' -%}
        <div class="faq__row" data-faq-row>
          <button type="button" class="faq__btn" data-faq-btn aria-expanded="false" aria-controls="cfaq-{{ forloop.index }}">
            <span class="faq__fill" aria-hidden="true"></span>
            <span class="faq__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <span class="faq__q">
              <h3>{{ qa[0] | strip | escape }}</h3>
              <span class="faq__a" id="cfaq-{{ forloop.index }}">{{ qa[1] | strip | escape }}</span>
            </span>
            <span class="faq__toggle" aria-hidden="true">{% render 'icon', name: 'arrow-out' %}</span>
          </button>
        </div>
      {%- endfor -%}
    </div>
    {%- endif -%}
  </div>
</section>
{%- endif -%}
