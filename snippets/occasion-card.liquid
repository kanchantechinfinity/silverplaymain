{%- liquid
  assign col = collections[block.settings.collection]
  assign img = block.settings.image
  assign img_asset = blank
  if img == blank
    case block.settings.collection
      when 'bali-collection'
        assign img_asset = 'occasion-bali.jpg'
      when 'party-wear'
        assign img_asset = 'occasion-party-wear.jpg'
      when 'office-muse'
        assign img_asset = 'occasion-office-muse.jpg'
      when 'everyday-elegance'
        assign img_asset = 'occasion-everyday-elegance.jpg'
    endcase
  endif
  if img == blank and img_asset == blank
    assign img = col.image
  endif
  if img == blank and img_asset == blank
    assign img = col.products.first.featured_media.preview_image
  endif
  assign title = block.settings.title | default: col.title
  assign img_position = '50% 50%'
  if block.settings.collection == 'party-wear'
    assign img_position = '50% 46%'
  endif
-%}
<div class="occasion__cell" style="flex: {{ flex }}" {{ block.shopify_attributes }}>
  <a href="{{ col.url | default: routes.collections_url }}" class="occ-card{% if wide %} occ-card--wide{% endif %}">
    {%- if img_asset != blank -%}
      <img src="{{ img_asset | asset_url }}" alt="{{ title | escape }}" loading="lazy" decoding="async" width="900" height="900" style="object-position: {{ img_position }}">
    {%- elsif img -%}
      <img src="{{ img | image_url: width: 900 }}" alt="{{ title | escape }}" loading="lazy" decoding="async" width="900" height="1100">
    {%- else -%}
      <img src="{{ 'stock-collection-1.jpg' | asset_url }}" alt="" loading="lazy" decoding="async" width="1600" height="1067">
    {%- endif -%}
    <span class="occ-card__scrim" aria-hidden="true"></span>
    <span class="occ-card__foot">
      <p>{{ title }}</p>
      <span class="occ-card__go" aria-hidden="true">&rarr;</span>
    </span>
  </a>
</div>
